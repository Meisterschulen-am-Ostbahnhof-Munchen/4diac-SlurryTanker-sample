<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AX_T_FF_SR_SEQ_GATE" Comment="Wie AX_T_FF_SR_SEQ (echt bidirektional: 4 strikt getrennte Pfade&#10;Vorwaerts-Set/Vorwaerts-Reset/Rueckwaerts-Set/Rueckwaerts-Reset), zusaetzlich&#10;mit Freigabe-Socket GATE:AX und eigenem Zustand GATE_CLOSED - geht GATE auf&#10;FALSE, wird sofort zwangsweise RESET ausgefuehrt und in GATE_CLOSED gesperrt;&#10;einziger Ausweg aus GATE_CLOSED ist GATE.E1[GATE.D1] (Gate wieder offen)">
	<Identification Standard="61499-1 Annex A" Function="Wie AX_T_FF_SR_SEQ (lokales S/R/CLK, 4 strikt getrennte CHAIN-Pfade ueber ASR2: CHAIN_IN.EO_SET-&gt;CHAIN_OUT.EO_SET, CHAIN_IN.EO_RESET-&gt;CHAIN_OUT.EO_RESET, CHAIN_OUT.EI_SET-&gt;CHAIN_IN.EI_SET, CHAIN_OUT.EI_RESET-&gt;CHAIN_IN.EI_RESET - keine Verzweigung, jeder Zustand feuert genau eine Chain-Aktion), zusaetzlich: GATE (Socket, AX) muss TRUE sein, sonst wird der Baustein in einen eigenen Zustand GATE_CLOSED gezwungen (Q.E1 mit FALSE, wie RESET). In GATE_CLOSED ist S/R/CLK/CHAIN_IN/CHAIN_OUT komplett wirkungslos (keine Transition definiert - IEC 61499 verwirft das Event einfach) - der EINZIGE Ausweg ist GATE.E1[GATE.D1] zurueck nach RESET. Ein waehrend GATE_CLOSED ankommendes Chain-Event (vorwaerts oder rueckwaerts) wird NICHT weitergereicht - ein gesperrtes Kettenglied unterbricht die Kette fuer nachfolgende Glieder in beide Richtungen (bewusste, aber revisitierbare Designentscheidung).">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.4" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Echte Bidirektionalitaet ergaenzt (Franz: 'Chain IN SET --&gt; Chain Out Set, und Rueckwaerts auch so. keine Events verdoppeln... insgesamt 4 Pfade. keine Verzweigungen'), analog AX_T_FF_SR_SEQ v1.1: 2 neue Zustaende SET_CHAIN_BWD/RESET_CHAIN_BWD fuer die Rueckwaerts-Richtung (CHAIN_OUT.EI_SET/EI_RESET -&gt; lokal + CHAIN_IN.EI_SET/EI_RESET), inkl. GATE-Pruefung [NOT GATE.D1] als erste Transition auch auf den beiden neuen Zustaenden - Rueckwaerts-Set wird durch GATE genauso gesperrt wie Vorwaerts-Set.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.3" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Bugfix (Reihenfolge-Luecke, analog AX_T_FF_SR_GATE): GATE.E1[NOT GATE.D1] durch ereignisloses [NOT GATE.D1] ersetzt UND in jedem Zustand an die ERSTE Stelle der Deklarationsreihenfolge gesetzt (vorher standen S/CLK/CHAIN_IN.EO_SET davor - da diese ohne Guard immer TRUE sind, hat IEC 61499-1 Table 1 Regel c) sie zuerst gekreuzt, die Gate-Sperre kam bei S/CLK/CHAIN_IN.EO_SET nie zum Zug). Doppelte START-&gt;GATE_CLOSED-Transition (Epsilon + event-getriggert) auf eine ereignislose Variante konsolidiert - deckt jetzt sowohl Boot-Fenster als auch laufendes Monitoring bei JEDEM Event ab (nicht nur GATE.E1), siehe DIN/EVS EN 61499-1 Table 1 Regel c4/c5.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.1" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Umgebaut (Franz: 'brauchen wir da nicht einen Zustand GATE_CLOSED? aus dem Zustand kommt man nur raus mit GATE.E1[GATE.D1 = TRUE]'): V1.0 hatte GATE.D1 als 12 verstreute [GATE.D1]-Guards auf jeder einzelnen EIN-Transition - funktional aequivalent, aber schwer auditierbar. Jetzt 1 dedizierter Zustand GATE_CLOSED: alle EIN-Transitionen wieder ungegatet (wie AX_T_FF_SR_SEQ), Sperre lebt ausschliesslich in GATE_CLOSEDs fehlenden Ausgangs-Transitionen fuer S/R/CLK/CHAIN_IN - deutlich einfacher zu verifizieren ('der einzige Weg raus ist die eine GATE.E1[GATE.D1]-Transition').">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Neu (Franz: 'mach gleich noch ein AX_T_FF_SR_SEQ_GATE was einen zusaetzlichen AX hat, der AN sein muss als Freigabe... wenn AX aus geht ist der Baustein gesperrt, es wird RESET ausgefuehrt. SET wird nur akzeptiert wenn das Gate wieder offen ist'). Kopiert von AX_T_FF_SR_SEQ. Loest das frueher zurueckgestellte FORCE_OFF-Problem ('haelt R durchgehend, aber Baustein geht dafuer nicht, sofortiges Wiedereinschalten moeglich') fuer den Zapfwellen-Ueberwachungs-Anwendungsfall: hier ist die Sperre echt pegelbasiert, kein reiner Flanken-Puls auf R.">
	</VersionInfo>
	<CompilerInfo packageName="adapter::events::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="S" Type="Event" Comment="Set output Q (lokal, wirkt nie auf CHAIN_IN/CHAIN_OUT) - wirkungslos waehrend GATE_CLOSED">
			</Event>
			<Event Name="R" Type="Event" Comment="Reset output Q (lokal, wirkt nie auf CHAIN_IN/CHAIN_OUT) - wirkungslos waehrend GATE_CLOSED (ist ohnehin schon aus)">
			</Event>
			<Event Name="CLK" Type="Event" Comment="Clock for triggering a output toggle (lokal, wirkt nie auf CHAIN_IN/CHAIN_OUT) - wirkungslos waehrend GATE_CLOSED">
			</Event>
		</EventInputs>
		<Plugs>
			<AdapterDeclaration Name="Q" Type="adapter::types::unidirectional::AX" Comment="value of flip flop"/>
			<AdapterDeclaration Name="CHAIN_OUT" Type="adapter::types::bidirectional::ASR2" Comment="Vorwaerts: Set/Reset an naechstes Kettenglied (EO_SET/EO_RESET). Rueckwaerts: Set/Reset VOM naechsten Kettenglied empfangen (EI_SET/EI_RESET). Nicht waehrend GATE_CLOSED."/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="CHAIN_IN" Type="adapter::types::bidirectional::ASR2" Comment="Vorwaerts: Set/Reset vom vorherigen Kettenglied empfangen (EO_SET/EO_RESET). Rueckwaerts: Set/Reset an vorheriges Kettenglied weiterreichen (EI_SET/EI_RESET). Nicht waehrend GATE_CLOSED."/>
			<AdapterDeclaration Name="GATE" Type="adapter::types::unidirectional::AX" Comment="Freigabe: muss TRUE sein. Faellt GATE auf FALSE: sofort GATE_CLOSED (Zwangs-RESET + Sperre), verlassen nur ueber GATE.E1[GATE.D1]."/>
		</Sockets>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="200" y="700">
			</ECState>
			<ECState Name="SET" x="1400" y="200">
				<ECAction Algorithm="SET" Output="Q.E1"/>
			</ECState>
			<ECState Name="RESET" x="1400" y="1200">
				<ECAction Algorithm="RESET" Output="Q.E1"/>
			</ECState>
			<ECState Name="SET_CHAIN" Comment="Set kam vorwaerts ueber CHAIN_IN.EO_SET - reicht NUR vorwaerts an CHAIN_OUT.EO_SET weiter" x="2800" y="200">
				<ECAction Algorithm="SET" Output="Q.E1"/>
				<ECAction Output="CHAIN_OUT.EO_SET"/>
			</ECState>
			<ECState Name="RESET_CHAIN" Comment="Reset kam vorwaerts ueber CHAIN_IN.EO_RESET - reicht NUR vorwaerts an CHAIN_OUT.EO_RESET weiter" x="2800" y="1200">
				<ECAction Algorithm="RESET" Output="Q.E1"/>
				<ECAction Output="CHAIN_OUT.EO_RESET"/>
			</ECState>
			<ECState Name="SET_CHAIN_BWD" Comment="Set kam rueckwaerts ueber CHAIN_OUT.EI_SET - reicht NUR rueckwaerts an CHAIN_IN.EI_SET weiter" x="4720" y="240">
				<ECAction Algorithm="SET" Output="Q.E1"/>
				<ECAction Output="CHAIN_IN.EI_SET"/>
			</ECState>
			<ECState Name="RESET_CHAIN_BWD" Comment="Reset kam rueckwaerts ueber CHAIN_OUT.EI_RESET - reicht NUR rueckwaerts an CHAIN_IN.EI_RESET weiter" x="4800" y="1200">
				<ECAction Algorithm="RESET" Output="Q.E1"/>
				<ECAction Output="CHAIN_IN.EI_RESET"/>
			</ECState>
			<ECState Name="GATE_CLOSED" Comment="Gesperrt: GATE.D1=FALSE. Q zwangsweise FALSE. S/R/CLK/CHAIN_IN/CHAIN_OUT sind hier wirkungslos (keine Transition definiert). Einziger Ausweg: GATE.E1[GATE.D1] zurueck nach RESET." x="200" y="2400">
				<ECAction Algorithm="RESET" Output="Q.E1"/>
			</ECState>
			<ECTransition Source="START" Destination="GATE_CLOSED" Condition="[NOT GATE.D1]" x="200" y="1550"/>
			<ECTransition Source="START" Destination="SET" Condition="S[GATE.D1]" x="840" y="440"/>
			<ECTransition Source="START" Destination="SET" Condition="CLK[GATE.D1]" x="880" y="480"/>
			<ECTransition Source="START" Destination="SET_CHAIN" Condition="CHAIN_IN.EO_SET[GATE.D1]" x="1620" y="520"/>
			<ECTransition Source="START" Destination="RESET_CHAIN" Condition="CHAIN_IN.EO_RESET" x="1660" y="1160"/>
			<ECTransition Source="START" Destination="SET_CHAIN_BWD" Condition="CHAIN_OUT.EI_SET[GATE.D1]" x="2400" y="600"/>
			<ECTransition Source="START" Destination="RESET_CHAIN_BWD" Condition="CHAIN_OUT.EI_RESET" x="2440" y="1240"/>
			<ECTransition Source="SET" Destination="GATE_CLOSED" Condition="[NOT GATE.D1]" x="800" y="1250"/>
			<ECTransition Source="SET" Destination="RESET" Condition="R" x="1440" y="740"/>
			<ECTransition Source="SET" Destination="RESET" Condition="CLK" x="1480" y="780"/>
			<ECTransition Source="SET" Destination="SET_CHAIN" Condition="CHAIN_IN.EO_SET[GATE.D1]" x="2220" y="220"/>
			<ECTransition Source="SET" Destination="RESET_CHAIN" Condition="CHAIN_IN.EO_RESET" x="2260" y="860"/>
			<ECTransition Source="SET" Destination="SET_CHAIN_BWD" Condition="CHAIN_OUT.EI_SET[GATE.D1]" x="3000" y="300"/>
			<ECTransition Source="SET" Destination="RESET_CHAIN_BWD" Condition="CHAIN_OUT.EI_RESET" x="3040" y="940"/>
			<ECTransition Source="RESET" Destination="GATE_CLOSED" Condition="[NOT GATE.D1]" x="800" y="1850"/>
			<ECTransition Source="RESET" Destination="SET" Condition="S[GATE.D1]" x="1440" y="740"/>
			<ECTransition Source="RESET" Destination="SET" Condition="CLK[GATE.D1]" x="1480" y="780"/>
			<ECTransition Source="RESET" Destination="SET_CHAIN" Condition="CHAIN_IN.EO_SET[GATE.D1]" x="2220" y="820"/>
			<ECTransition Source="RESET" Destination="RESET_CHAIN" Condition="CHAIN_IN.EO_RESET" x="2260" y="1460"/>
			<ECTransition Source="RESET" Destination="SET_CHAIN_BWD" Condition="CHAIN_OUT.EI_SET[GATE.D1]" x="3000" y="900"/>
			<ECTransition Source="RESET" Destination="RESET_CHAIN_BWD" Condition="CHAIN_OUT.EI_RESET" x="3040" y="1540"/>
			<ECTransition Source="SET_CHAIN" Destination="GATE_CLOSED" Condition="[NOT GATE.D1]" x="1500" y="1250"/>
			<ECTransition Source="SET_CHAIN" Destination="RESET" Condition="R" x="2140" y="740"/>
			<ECTransition Source="SET_CHAIN" Destination="RESET" Condition="CLK" x="2180" y="780"/>
			<ECTransition Source="SET_CHAIN" Destination="SET_CHAIN" Condition="CHAIN_IN.EO_SET[GATE.D1]" x="2920" y="220"/>
			<ECTransition Source="SET_CHAIN" Destination="RESET_CHAIN" Condition="CHAIN_IN.EO_RESET" x="2960" y="860"/>
			<ECTransition Source="SET_CHAIN" Destination="SET_CHAIN_BWD" Condition="CHAIN_OUT.EI_SET[GATE.D1]" x="3700" y="300"/>
			<ECTransition Source="SET_CHAIN" Destination="RESET_CHAIN_BWD" Condition="CHAIN_OUT.EI_RESET" x="3740" y="940"/>
			<ECTransition Source="RESET_CHAIN" Destination="GATE_CLOSED" Condition="[NOT GATE.D1]" x="1500" y="1850"/>
			<ECTransition Source="RESET_CHAIN" Destination="SET" Condition="S[GATE.D1]" x="2140" y="740"/>
			<ECTransition Source="RESET_CHAIN" Destination="SET" Condition="CLK[GATE.D1]" x="2180" y="780"/>
			<ECTransition Source="RESET_CHAIN" Destination="SET_CHAIN" Condition="CHAIN_IN.EO_SET[GATE.D1]" x="2920" y="820"/>
			<ECTransition Source="RESET_CHAIN" Destination="RESET_CHAIN" Condition="CHAIN_IN.EO_RESET" x="2960" y="1460"/>
			<ECTransition Source="RESET_CHAIN" Destination="SET_CHAIN_BWD" Condition="CHAIN_OUT.EI_SET[GATE.D1]" x="3700" y="900"/>
			<ECTransition Source="RESET_CHAIN" Destination="RESET_CHAIN_BWD" Condition="CHAIN_OUT.EI_RESET" x="3740" y="1540"/>
			<ECTransition Source="SET_CHAIN_BWD" Destination="GATE_CLOSED" Condition="[NOT GATE.D1]" x="2200" y="1250"/>
			<ECTransition Source="SET_CHAIN_BWD" Destination="RESET" Condition="R" x="2840" y="740"/>
			<ECTransition Source="SET_CHAIN_BWD" Destination="RESET" Condition="CLK" x="2880" y="780"/>
			<ECTransition Source="SET_CHAIN_BWD" Destination="SET_CHAIN" Condition="CHAIN_IN.EO_SET[GATE.D1]" x="3620" y="220"/>
			<ECTransition Source="SET_CHAIN_BWD" Destination="RESET_CHAIN" Condition="CHAIN_IN.EO_RESET" x="3660" y="860"/>
			<ECTransition Source="SET_CHAIN_BWD" Destination="SET_CHAIN_BWD" Condition="CHAIN_OUT.EI_SET[GATE.D1]" x="4400" y="300"/>
			<ECTransition Source="SET_CHAIN_BWD" Destination="RESET_CHAIN_BWD" Condition="CHAIN_OUT.EI_RESET" x="4440" y="940"/>
			<ECTransition Source="RESET_CHAIN_BWD" Destination="GATE_CLOSED" Condition="[NOT GATE.D1]" x="2200" y="1850"/>
			<ECTransition Source="RESET_CHAIN_BWD" Destination="SET" Condition="S[GATE.D1]" x="2840" y="740"/>
			<ECTransition Source="RESET_CHAIN_BWD" Destination="SET" Condition="CLK[GATE.D1]" x="2880" y="780"/>
			<ECTransition Source="RESET_CHAIN_BWD" Destination="SET_CHAIN" Condition="CHAIN_IN.EO_SET[GATE.D1]" x="3620" y="820"/>
			<ECTransition Source="RESET_CHAIN_BWD" Destination="RESET_CHAIN" Condition="CHAIN_IN.EO_RESET" x="3660" y="1460"/>
			<ECTransition Source="RESET_CHAIN_BWD" Destination="SET_CHAIN_BWD" Condition="CHAIN_OUT.EI_SET[GATE.D1]" x="4400" y="900"/>
			<ECTransition Source="RESET_CHAIN_BWD" Destination="RESET_CHAIN_BWD" Condition="CHAIN_OUT.EI_RESET" x="4440" y="1540"/>
			<ECTransition Source="GATE_CLOSED" Destination="RESET" Condition="GATE.E1[GATE.D1]" x="800" y="1800"/>
		</ECC>
		<Algorithm Name="SET">
			<ST><![CDATA[
Q.D1 := TRUE;
]]></ST>
		</Algorithm>
		<Algorithm Name="RESET">
			<ST><![CDATA[
Q.D1 := FALSE;
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
