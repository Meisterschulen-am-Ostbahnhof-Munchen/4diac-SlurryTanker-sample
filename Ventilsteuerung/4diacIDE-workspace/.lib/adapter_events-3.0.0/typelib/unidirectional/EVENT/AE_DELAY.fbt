<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AE_DELAY" Comment="Delayed event propagation (AE Adapter)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-02-01" Remarks="Wrapper for E_DELAY using AE adapters">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.1" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Bugfix (Franz: 'DT ... muesste dann auch einen ATM als TIME Eingang bekommen'): Klartext-InputVar DT:TIME (nie ueber INIT initialisiert) durch ATM-Socket ersetzt, sauber initialisierbar ueber initval_ATM+INIT/INITO an der Instanziierungsstelle. Toter, unverdrahteter EventInput REQ (Rest einer Kopiervorlage) mit entfernt.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.2" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Bugfix (4diac IDE Validation: 'Name: DT is a reserved keyword' - DT ist Abkuerzung fuer DATE_AND_TIME, IEC 61131-3-Keyword): Socket DT in PT (Preset Time, Standardname wie bei TON/TOF) umbenannt.">
	</VersionInfo>
	<CompilerInfo packageName="adapter::events::unidirectional::timers">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="EO" Type="adapter::types::unidirectional::AE" Comment="Delayed event" x="3300" y="500"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="START" Type="adapter::types::unidirectional::AE" Comment="Start delay" x="-1100" y="-1000"/>
			<AdapterDeclaration Name="STOP" Type="adapter::types::unidirectional::AE" Comment="Stop delay" x="-1100" y="-500"/>
			<AdapterDeclaration Name="PT" Type="adapter::types::unidirectional::ATM" Comment="Preset Time / Delay time (ATM statt Klartext-InputVar, sauber initialisierbar ueber initval_ATM)" x="-1100" y="0"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="E_DELAY" Type="iec61499::events::E_DELAY" x="1200" y="800">
		</FB>
		<EventConnections>
			<Connection Source="START.E1" Destination="E_DELAY.START" dx1="906.67"/>
			<Connection Source="STOP.E1" Destination="E_DELAY.STOP" dx1="460"/>
			<Connection Source="E_DELAY.EO" Destination="EO.E1" dx1="740"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="PT.D1" Destination="E_DELAY.DT" dx1="126.67"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
