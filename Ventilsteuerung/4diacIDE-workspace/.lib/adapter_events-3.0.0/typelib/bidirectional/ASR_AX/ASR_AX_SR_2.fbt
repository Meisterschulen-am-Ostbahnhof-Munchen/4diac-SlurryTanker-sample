<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ASR_AX_SR_2" Comment="Event-driven bistable, bidirectional Socket (Set/Reset in, state back out via&#10;the same adapter)">
	<Identification Standard="61499-1 Annex A" Description="Copyright (c) 2026 HR Agrartechnik GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-03" Remarks="wie ASR_AX_SR, aber mit bidirektionalem ASR_AX-Socket statt unidirektionalem ASR-Socket + separatem AX-Plug - der Zustand geht ueber denselben Adapter zurueck">
	</VersionInfo>
	<CompilerInfo packageName="adapter::events::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="S_R" Type="adapter::types::bidirectional::ASR_AX" Comment="Set/Reset (in), Zustand (out)"/>
		</Sockets>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="240" y="640">
			</ECState>
			<ECState Name="SET" x="1200" y="400">
				<ECAction Algorithm="SET" Output="S_R.EI1"/>
			</ECState>
			<ECState Name="RESET" x="1200" y="1440">
				<ECAction Algorithm="RESET" Output="S_R.EI1"/>
			</ECState>
			<ECTransition Source="START" Destination="SET" Condition="S_R.SET" x="713.33" y="453.33"/>
			<ECTransition Source="SET" Destination="RESET" Condition="S_R.RESET" x="1113.33" y="966.67"/>
			<ECTransition Source="RESET" Destination="SET" Condition="S_R.SET" x="1740" y="953.33"/>
		</ECC>
		<Algorithm Name="SET">
			<ST><![CDATA[
S_R.DI1 := TRUE;
]]></ST>
		</Algorithm>
		<Algorithm Name="RESET">
			<ST><![CDATA[
S_R.DI1 := FALSE;
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
