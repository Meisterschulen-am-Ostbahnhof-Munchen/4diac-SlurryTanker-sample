<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AE_AX_T_FF" Comment="Toggle flip flop, bidirectional Socket (Toggle in, state back out via the same&#10;adapter)">
	<Identification Standard="61499-1 Annex A" Description="Copyright (c) 2026 HR Agrartechnik GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-03" Remarks="wie AX_T_FF, aber mit bidirektionalem AE_AX-Socket statt plain CLK-EventInput + separatem AX-Plug - der Zustand geht ueber denselben Adapter zurueck">
	</VersionInfo>
	<CompilerInfo packageName="adapter::events::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="CLK" Type="adapter::types::bidirectional::AE_AX" Comment="Clock (in), Zustand (out)"/>
		</Sockets>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="400" y="700">
			</ECState>
			<ECState Name="SET" Comment="Initialization" x="1235" y="665">
				<ECAction Algorithm="TOGGLE" Output="CLK.EI1"/>
			</ECState>
			<ECTransition Source="START" Destination="SET" Condition="CLK.E1" x="860" y="590"/>
			<ECTransition Source="SET" Destination="START" Condition="1" x="940" y="985"/>
		</ECC>
		<Algorithm Name="TOGGLE">
			<ST><![CDATA[
CLK.DI1 := NOT CLK.DI1;
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
