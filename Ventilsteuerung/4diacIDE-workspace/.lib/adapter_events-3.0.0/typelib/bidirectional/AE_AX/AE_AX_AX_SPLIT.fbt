<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AE_AX_AX_SPLIT" Comment="AE_AX passthrough (Socket to Plug) plus an extra AX Plug mirroring the AE_AX&#10;backward (state) channel">
	<Identification Standard="61499-2" Function="Any Event coming in by IN is forwarded to OUT unchanged; the backward Event/Bool fired into OUT by the downstream Socket is relayed both back through IN and out via AX_OUT" Description="Copyright (c) 2026 HR Agrartechnik GmbH &#10; &#10;This program and the accompanying materials are made &#10;available under the terms of the Eclipse Public License 2.0 &#10;which is available at https://www.eclipse.org/legal/epl-2.0/ &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-03" Remarks="Initial Version">
	</VersionInfo>
	<CompilerInfo packageName="adapter::events::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::bidirectional::AE_AX" Comment="Output" x="1400" y="800"/>
			<AdapterDeclaration Name="AX_OUT" Type="adapter::types::unidirectional::AX" Comment="mirrors the AE_AX backward (state) channel" x="2800" y="800"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::bidirectional::AE_AX" Comment="Input" x="200" y="800"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="IN.E1" Destination="OUT.E1"/>
			<Connection Source="OUT.EI1" Destination="IN.EI1" dx1="66.67" dx2="66.67" dy="-226.67"/>
			<Connection Source="OUT.EI1" Destination="AX_OUT.E1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="OUT.DI1" Destination="IN.DI1" dx1="66.67" dx2="66.67" dy="153.33"/>
			<Connection Source="OUT.DI1" Destination="AX_OUT.D1"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
