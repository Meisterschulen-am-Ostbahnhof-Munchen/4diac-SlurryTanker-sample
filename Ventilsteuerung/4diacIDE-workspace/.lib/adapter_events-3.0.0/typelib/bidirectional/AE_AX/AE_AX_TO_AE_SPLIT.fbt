<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AE_AX_TO_AE_SPLIT" Comment="Gespiegelte Version von AE_TO_AE_AX_SPLIT (Plug/Socket 1:1 vertauscht): relays a&#10;bidirectional AE_AX Socket's incoming trigger onward as a unidirectional AE Plug&#10;(Trigger passthrough), plus an AX Socket injects an externally supplied value as&#10;the AE_AX Socket's outgoing backward (state) channel">
	<Identification Standard="61499-2" Function="Any Event received on OUT (AE_AX Socket, its incoming/E1 side) is forwarded onward unchanged via IN (AE Plug); whatever is received on AX_OUT (AX Socket) is relayed as the backward Event/Bool sent out via OUT (the AE_AX Socket's own outgoing EI1/DI1 side)." Description="Copyright (c) 2026 HR Agrartechnik GmbH &#10; &#10;This program and the accompanying materials are made &#10;available under the terms of the Eclipse Public License 2.0 &#10;which is available at https://www.eclipse.org/legal/epl-2.0/ &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-12" Remarks="Initial Version - gespiegelt von AE_TO_AE_AX_SPLIT (Plug/Socket 1:1 vertauscht).">
	</VersionInfo>
	<CompilerInfo packageName="adapter::events::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::AE" Comment="Output (Trigger, unidirectional)" x="2900" y="800"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="OUT" Type="adapter::types::bidirectional::AE_AX" Comment="Input (Trigger in, Zustand out)" x="200" y="800"/>
			<AdapterDeclaration Name="AX_OUT" Type="adapter::types::unidirectional::AX" Comment="feeds the AE_AX backward (state) channel" x="200" y="1400"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="OUT.E1" Destination="IN.E1"/>
			<Connection Source="AX_OUT.E1" Destination="OUT.EI1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="AX_OUT.D1" Destination="OUT.DI1"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
