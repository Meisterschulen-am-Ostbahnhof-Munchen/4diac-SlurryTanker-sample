<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ASRT_TO_ASRT_AX_SPLIT" Comment="Relays a unidirectional ASRT Socket onward as a bidirectional ASRT_AX Plug&#10;(Set/Reset/Toggle passthrough), plus an extra AX Plug mirroring the ASRT_AX&#10;backward (state) channel">
	<Identification Standard="61499-2" Function="Any Event coming in by IN is forwarded to OUT unchanged; the backward Event/Bool fired into OUT by the downstream Socket is mirrored out via AX_OUT (IN has no backward channel to relay it back to)" Description="Copyright (c) 2026 HR Agrartechnik GmbH &#10; &#10;This program and the accompanying materials are made &#10;available under the terms of the Eclipse Public License 2.0 &#10;which is available at https://www.eclipse.org/legal/epl-2.0/ &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-04" Remarks="Initial Version">
	</VersionInfo>
	<CompilerInfo packageName="adapter::events::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::bidirectional::ASRT_AX" Comment="Output (Set/Reset/Toggle out, Zustand in)" x="2900" y="800"/>
			<AdapterDeclaration Name="AX_OUT" Type="adapter::types::unidirectional::AX" Comment="mirrors the ASRT_AX backward (state) channel" x="4200" y="900"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::ASRT" Comment="Input (Set/Reset/Toggle, unidirectional)" x="200" y="800"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="IN.SET" Destination="OUT.SET"/>
			<Connection Source="IN.RESET" Destination="OUT.RESET"/>
			<Connection Source="IN.TOGGLE" Destination="OUT.TOGGLE"/>
			<Connection Source="OUT.EI1" Destination="AX_OUT.E1" dx1="440"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="OUT.DI1" Destination="AX_OUT.D1" dx1="440"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
