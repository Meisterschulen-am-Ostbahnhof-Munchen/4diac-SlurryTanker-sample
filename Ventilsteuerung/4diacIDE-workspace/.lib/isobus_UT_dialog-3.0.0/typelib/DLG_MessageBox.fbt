	<CompilerInfo packageName="isobus::UT::dialog">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
		<Import declaration="isobus::UT::dialog::DialogIDs::Button_Dlg_Abort"/>
		<Import declaration="isobus::UT::dialog::DialogIDs::Button_Dlg_Cancel"/>
		<Import declaration="isobus::UT::dialog::DialogIDs::Button_Dlg_Ignore"/>
