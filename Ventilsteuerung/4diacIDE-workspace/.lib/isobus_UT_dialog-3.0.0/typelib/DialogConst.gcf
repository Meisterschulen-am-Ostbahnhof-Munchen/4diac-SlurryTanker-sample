		<VarDeclaration Name="DLG_RES_CANCEL" Type="USINT" Comment="Abbrechen" InitialValue="USINT#2"/>
		<VarDeclaration Name="DLG_RES_ABORT" Type="USINT" Comment="Abbruch" InitialValue="USINT#3"/>
		<VarDeclaration Name="DLG_RES_RETRY" Type="USINT" Comment="Wiederholen" InitialValue="USINT#4"/>
