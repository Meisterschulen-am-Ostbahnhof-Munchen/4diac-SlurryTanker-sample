	<OriginalSource><![CDATA[(* Werte wie Windows MessageBox (Tasten, Icon, Ergebnis). RESULT = KeyCode des Dialog-Buttons. *)
PACKAGE isobus::UT::dialog;

GLOBALCONSTANTS DialogConst
	VAR_GLOBAL CONSTANT
		DLG_BTN_NONE : USINT := USINT#0; // keine Tasten (Toast)
		DLG_BTN_OK : USINT := USINT#1; // OK
		DLG_BTN_OKCANCEL : USINT := USINT#2; // OK, Abbrechen
		DLG_BTN_ABORTRETRYIGNORE : USINT := USINT#3; // Abbrechen, Wiederholen, Ignorieren
		DLG_BTN_YESNOCANCEL : USINT := USINT#4; // Ja, Nein, Abbrechen
		DLG_BTN_YESNO : USINT := USINT#5; // Ja, Nein
		DLG_BTN_RETRYCANCEL : USINT := USINT#6; // Wiederholen, Abbrechen
		DLG_ICON_NONE : USINT := USINT#0; // kein Icon
		DLG_ICON_INFO : USINT := USINT#1; // Information
		DLG_ICON_QUESTION : USINT := USINT#2; // Frage
		DLG_ICON_WARNING : USINT := USINT#3; // Warnung
		DLG_ICON_ERROR : USINT := USINT#4; // Fehler
		DLG_RES_NONE : USINT := USINT#0; // geschlossen/ersetzt
		DLG_RES_OK : USINT := USINT#1; // OK
		DLG_RES_CANCEL : USINT := USINT#2; // Abbrechen
		DLG_RES_ABORT : USINT := USINT#3; // Abbruch
		DLG_RES_RETRY : USINT := USINT#4; // Wiederholen
		DLG_RES_IGNORE : USINT := USINT#5; // Ignorieren
		DLG_RES_YES : USINT := USINT#6; // Ja
		DLG_RES_NO : USINT := USINT#7; // Nein
		DLG_RES_TIMEOUT : USINT := USINT#8; // Zeit abgelaufen
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</GlobalConstants>
