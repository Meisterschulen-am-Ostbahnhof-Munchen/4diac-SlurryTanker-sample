	<GlobalConstants>
		<VarDeclaration Name="DLG_BTN_NONE" Type="USINT" Comment="keine Tasten (Toast)" InitialValue="USINT#0"/>
		<VarDeclaration Name="DLG_BTN_OK" Type="USINT" Comment="OK" InitialValue="USINT#1"/>
		<VarDeclaration Name="DLG_BTN_OKCANCEL" Type="USINT" Comment="OK, Abbrechen" InitialValue="USINT#2"/>
		<VarDeclaration Name="DLG_BTN_ABORTRETRYIGNORE" Type="USINT" Comment="Abbrechen, Wiederholen, Ignorieren" InitialValue="USINT#3"/>
		<VarDeclaration Name="DLG_BTN_YESNOCANCEL" Type="USINT" Comment="Ja, Nein, Abbrechen" InitialValue="USINT#4"/>
		<VarDeclaration Name="DLG_BTN_YESNO" Type="USINT" Comment="Ja, Nein" InitialValue="USINT#5"/>
		<VarDeclaration Name="DLG_BTN_RETRYCANCEL" Type="USINT" Comment="Wiederholen, Abbrechen" InitialValue="USINT#6"/>
		<VarDeclaration Name="DLG_ICON_NONE" Type="USINT" Comment="kein Icon" InitialValue="USINT#0"/>
		<VarDeclaration Name="DLG_ICON_INFO" Type="USINT" Comment="Information" InitialValue="USINT#1"/>
		<VarDeclaration Name="DLG_ICON_QUESTION" Type="USINT" Comment="Frage" InitialValue="USINT#2"/>
		<VarDeclaration Name="DLG_ICON_WARNING" Type="USINT" Comment="Warnung" InitialValue="USINT#3"/>
		<VarDeclaration Name="DLG_ICON_ERROR" Type="USINT" Comment="Fehler" InitialValue="USINT#4"/>
