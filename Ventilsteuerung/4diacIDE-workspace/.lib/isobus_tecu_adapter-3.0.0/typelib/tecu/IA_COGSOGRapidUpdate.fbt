<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="IA_COGSOGRapidUpdate" Comment="ISOBUS Adapter for Course Over Ground and Speed Over Ground (Rapid Update)">
	<Identification Standard="NMEA 2000" Classification="PGN 129026" Description="Copyright (c) 2024-2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.4" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Dokumentation (Franz: 'das passt, wir dokumentieren das in den Bausteinen. E_D_FF ist ein IEC 61499 Standardbaustein, wir halten uns STRENG an die Norm. E_D_FF_ANY ist davon abgeleitet, sollte sich gleich verhalten'): E_D_FF_Timeout (E_D_FF, IEC 61499-1 Annex A Standardbaustein) feuert EO NICHT beim allerersten CLK, wenn der erste echte Wert mit dem default-initialisierten Vergleichszustand (FALSE) uebereinstimmt - bleibt I_CORE.Q_timeout von Anfang an FALSE (Normalfall, kein Timeout), feuert TIMEOUT.E1 nie initial. Bewusst kein Bug, sondern standardkonformes Verhalten (analog E_RS/E_SR, wo genau dasselbe Verhalten Anlass fuer die Sonderformen E_RS_SYM/E_SR_SYM war) - hier bewusst KEINE eigene SYM-Variante, da nachgelagerte Verbraucher TIMEOUT.D1 als Datenwert lesen, nicht nur das Event.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.3" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Bugfix (PR #241 Review, qodo-code-review[bot]: 'Normal traffic floods timeout consumers - every IND republishes Q_timeout even when it did not change'): E_D_FF_Timeout (E_D_FF_ANY) vor TIMEOUT eingefuegt, wie schon fuer die anderen Signale dieser Datei - I_CORE.TIMEOUT und I_CORE.IND feuern jetzt beide nur noch E_D_FF_Timeout.CLK, TIMEOUT.E1/D1 werden nur noch bei tatsaechlicher Aenderung von Q_timeout aktualisiert, nicht mehr bei jeder einzelnen Botschaft im gesunden Normalbetrieb.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.2" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Bugfix (Franz: 'IA_VDS hat einen Bug, moeglicherweise alle anderen auch'): .IND-&gt;TIMEOUT.E1 ergaenzt (analog IA_VDS) - bisher wurde TIMEOUT.E1 NUR von .TIMEOUT gefeuert (Timeout-Beginn), nie beim Eintreffen einer normalen Botschaft (.IND) - TIMEOUT.D1 (Q_timeout=FALSE) wurde also gesetzt, aber nie an den TIMEOUT-Plug propagiert, sobald der Timeout wieder endete.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.1" Author="Franz Höpfinger" Date="2026-09-16" Remarks="E_D_FF_ANY-Aenderungsfilter fuer COG/SOG/SID/COG_REF ergaenzt (analog IA_RPTO v1.1) - I_CORE.IND feuerte bisher bei jeder Botschaft unbedingt, auch ohne Wertaenderung.">
	</VersionInfo>
	<CompilerInfo packageName="isobus::tecu">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="COG" Type="adapter::types::unidirectional::AUI" Comment="Course Over Ground" x="3520" y="4100"/>
			<AdapterDeclaration Name="SOG" Type="adapter::types::unidirectional::AUI" Comment="Speed Over Ground" x="3520" y="4860"/>
			<AdapterDeclaration Name="TIMEOUT" Type="adapter::types::unidirectional::AX" Comment="Timeout Status" x="4000" y="1500"/>
			<AdapterDeclaration Name="SID" Type="adapter::types::unidirectional::AUS" Comment="Sequence ID" x="3520" y="2580"/>
			<AdapterDeclaration Name="COG_REF" Type="adapter::types::unidirectional::AB" Comment="COG Reference" x="3520" y="3340"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<FB Name="I_CORE" Type="isobus::tecu::I_COGSOGRapidUpdate" x="400" y="1300">
		</FB>
		<FB Name="E_D_FF_COG" Type="iec61499::events::E_D_FF_ANY" x="2200" y="4100">
		</FB>
		<FB Name="E_D_FF_SOG" Type="iec61499::events::E_D_FF_ANY" x="2200" y="4900">
		</FB>
		<FB Name="E_D_FF_SID" Type="iec61499::events::E_D_FF_ANY" x="2200" y="2600">
		</FB>
		<FB Name="E_D_FF_COG_REF" Type="iec61499::events::E_D_FF_ANY" x="2200" y="3300">
		</FB>
		<FB Name="E_D_FF_Timeout" Type="iec61499::events::E_D_FF" x="2600" y="1500">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="I_CORE.INIT" dx1="1320"/>
			<Connection Source="I_CORE.INITO" Destination="INITO" dx1="66.67"/>
			<Connection Source="I_CORE.IND" Destination="E_D_FF_COG.CLK" dx1="400"/>
			<Connection Source="E_D_FF_COG.EO" Destination="COG.E1"/>
			<Connection Source="I_CORE.IND" Destination="E_D_FF_SOG.CLK" dx1="400"/>
			<Connection Source="E_D_FF_SOG.EO" Destination="SOG.E1" dx1="280"/>
			<Connection Source="I_CORE.IND" Destination="E_D_FF_SID.CLK" dx1="400"/>
			<Connection Source="E_D_FF_SID.EO" Destination="SID.E1" dx1="280"/>
			<Connection Source="I_CORE.IND" Destination="E_D_FF_COG_REF.CLK" dx1="400"/>
			<Connection Source="E_D_FF_COG_REF.EO" Destination="COG_REF.E1" dx1="280"/>
			<Connection Source="I_CORE.TIMEOUT" Destination="E_D_FF_Timeout.CLK" dx1="946.67"/>
			<Connection Source="I_CORE.IND" Destination="E_D_FF_Timeout.CLK" dx1="946.67"/>
			<Connection Source="E_D_FF_Timeout.EO" Destination="TIMEOUT.E1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="I_CORE.QI" dx1="66.67"/>
			<Connection Source="I_CORE.QO" Destination="QO" dx1="466.67"/>
			<Connection Source="I_CORE.STATUS" Destination="STATUS" dx1="533.33"/>
			<Connection Source="I_CORE.CourseOverGround" Destination="E_D_FF_COG.D" dx1="133.33"/>
			<Connection Source="E_D_FF_COG.Q" Destination="COG.D1"/>
			<Connection Source="I_CORE.SpeedOverGround" Destination="E_D_FF_SOG.D" dx1="66.67"/>
			<Connection Source="E_D_FF_SOG.Q" Destination="SOG.D1" dx1="280"/>
			<Connection Source="I_CORE.Q_timeout" Destination="E_D_FF_Timeout.D" dx1="333.33"/>
			<Connection Source="E_D_FF_Timeout.Q" Destination="TIMEOUT.D1"/>
			<Connection Source="I_CORE.SID" Destination="E_D_FF_SID.D" dx1="266.67"/>
			<Connection Source="E_D_FF_SID.Q" Destination="SID.D1" dx1="280"/>
			<Connection Source="I_CORE.COGReference" Destination="E_D_FF_COG_REF.D" dx1="200"/>
			<Connection Source="E_D_FF_COG_REF.Q" Destination="COG_REF.D1" dx1="280"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<p>ISOBUS Adapter for Course Over Ground and Speed Over Ground (Rapid Update)</p>

<p>&nbsp;</p>

<p><strong>TIMEOUT.E1-Verdrahtung:</strong> I_CORE.TIMEOUT (echter Timeout-Eintritt) UND I_CORE.IND (Normalbetrieb) feuern beide E_D_FF_Timeout.CLK; E_D_FF_Timeout (E_D_FF_ANY, gespeist von I_CORE.Q_timeout) laesst TIMEOUT.E1 nur bei tatsaechlicher Wertaenderung durch - so wird TIMEOUT.D1 (Q_timeout) am Adapter-Plug beim Zuruecksetzen auf false weiterhin zuverlaessig aktualisiert, ohne bei jeder einzelnen Botschaft im gesunden Normalbetrieb erneut zu feuern. Der zugrundeliegende TIMEOUT/IND-Vertrag von I_CORE selbst ist in dessen eigener .fbt-Datei dokumentiert.</p>
]]></Attribute>
</FBType>
