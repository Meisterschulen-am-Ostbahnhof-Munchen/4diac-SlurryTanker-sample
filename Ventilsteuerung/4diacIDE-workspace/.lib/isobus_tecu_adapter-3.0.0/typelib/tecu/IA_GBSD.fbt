<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="IA_GBSD" Comment="ISOBUS Adapter for Ground Based Speed and Distance (GBSD)">
	<Identification Standard="ISO 11783-7" Classification="PGN 65097" Description="Copyright (c) 2024-2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.4" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Dokumentation (Franz: 'das passt, wir dokumentieren das in den Bausteinen. E_D_FF ist ein IEC 61499 Standardbaustein, wir halten uns STRENG an die Norm. E_D_FF_ANY ist davon abgeleitet, sollte sich gleich verhalten'): E_D_FF_Timeout (E_D_FF, IEC 61499-1 Annex A Standardbaustein) feuert EO NICHT beim allerersten CLK, wenn der erste echte Wert mit dem default-initialisierten Vergleichszustand (FALSE) uebereinstimmt - bleibt I_GBSD.Q_timeout von Anfang an FALSE (Normalfall, kein Timeout), feuert TIMEOUT.E1 nie initial. Bewusst kein Bug, sondern standardkonformes Verhalten (analog E_RS/E_SR, wo genau dasselbe Verhalten Anlass fuer die Sonderformen E_RS_SYM/E_SR_SYM war) - hier bewusst KEINE eigene SYM-Variante, da nachgelagerte Verbraucher TIMEOUT.D1 als Datenwert lesen, nicht nur das Event.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.3" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Bugfix (PR #241 Review, qodo-code-review[bot]: 'Normal traffic floods timeout consumers - every IND republishes Q_timeout even when it did not change'): E_D_FF_Timeout (E_D_FF_ANY) vor TIMEOUT eingefuegt, wie schon fuer die anderen Signale dieser Datei - I_GBSD.TIMEOUT und I_GBSD.IND feuern jetzt beide nur noch E_D_FF_Timeout.CLK, TIMEOUT.E1/D1 werden nur noch bei tatsaechlicher Aenderung von Q_timeout aktualisiert, nicht mehr bei jeder einzelnen Botschaft im gesunden Normalbetrieb.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.2" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Bugfix (Franz: 'IA_VDS hat einen Bug, moeglicherweise alle anderen auch'): .IND-&gt;TIMEOUT.E1 ergaenzt (analog IA_VDS) - bisher wurde TIMEOUT.E1 NUR von .TIMEOUT gefeuert (Timeout-Beginn), nie beim Eintreffen einer normalen Botschaft (.IND) - TIMEOUT.D1 (Q_timeout=FALSE) wurde also gesetzt, aber nie an den TIMEOUT-Plug propagiert, sobald der Timeout wieder endete.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.1" Author="Franz Höpfinger" Date="2026-09-16" Remarks="E_D_FF_ANY-Aenderungsfilter fuer SPEED/DISTANCE ergaenzt (analog IA_RPTO v1.1).">
	</VersionInfo>
	<CompilerInfo packageName="isobus::tecu">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="SPEED" Type="adapter::types::unidirectional::AUI" Comment="Ground-based machine speed" x="4000" y="2700"/>
			<AdapterDeclaration Name="DISTANCE" Type="adapter::types::unidirectional::AUDI" Comment="Ground-based machine distance" x="4000" y="3500"/>
			<AdapterDeclaration Name="TIMEOUT" Type="adapter::types::unidirectional::AX" Comment="Timeout Status" x="3220" y="1200"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<FB Name="I_GBSD" Type="isobus::tecu::I_GBSD" x="200" y="1000">
		</FB>
		<FB Name="E_D_FF_Speed" Type="iec61499::events::E_D_FF_ANY" x="2660" y="2700">
		</FB>
		<FB Name="E_D_FF_Distance" Type="iec61499::events::E_D_FF_ANY" x="2660" y="3460">
		</FB>
		<FB Name="E_D_FF_Timeout" Type="iec61499::events::E_D_FF" x="2300" y="1200">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="I_GBSD.INIT" dx1="66.67"/>
			<Connection Source="I_GBSD.INITO" Destination="INITO" dx1="66.67"/>
			<Connection Source="I_GBSD.IND" Destination="E_D_FF_Distance.CLK" dx1="333.33"/>
			<Connection Source="E_D_FF_Distance.EO" Destination="DISTANCE.E1" dx1="293.33"/>
			<Connection Source="I_GBSD.IND" Destination="E_D_FF_Speed.CLK" dx1="333.33"/>
			<Connection Source="E_D_FF_Speed.EO" Destination="SPEED.E1"/>
			<Connection Source="I_GBSD.TIMEOUT" Destination="E_D_FF_Timeout.CLK" dx1="526.67"/>
			<Connection Source="I_GBSD.IND" Destination="E_D_FF_Timeout.CLK" dx1="526.67"/>
			<Connection Source="E_D_FF_Timeout.EO" Destination="TIMEOUT.E1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="I_GBSD.QI" dx1="66.67"/>
			<Connection Source="I_GBSD.QO" Destination="QO" dx1="133.33"/>
			<Connection Source="I_GBSD.STATUS" Destination="STATUS" dx1="200"/>
			<Connection Source="I_GBSD.Q_timeout" Destination="E_D_FF_Timeout.D" dx1="200"/>
			<Connection Source="E_D_FF_Timeout.Q" Destination="TIMEOUT.D1"/>
			<Connection Source="I_GBSD.GROUNDBASEDMACHINESPEED" Destination="E_D_FF_Speed.D" dx1="133.33"/>
			<Connection Source="E_D_FF_Speed.Q" Destination="SPEED.D1"/>
			<Connection Source="I_GBSD.GROUNDBASEDMACHINEDISTANCE" Destination="E_D_FF_Distance.D" dx1="66.67"/>
			<Connection Source="E_D_FF_Distance.Q" Destination="DISTANCE.D1" dx1="293.33"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<p>ISOBUS Adapter for Ground Based Speed and Distance (GBSD)</p>

<p>&nbsp;</p>

<p><strong>TIMEOUT.E1-Verdrahtung:</strong> I_GBSD.TIMEOUT (echter Timeout-Eintritt) UND I_GBSD.IND (Normalbetrieb) feuern beide E_D_FF_Timeout.CLK; E_D_FF_Timeout (E_D_FF_ANY, gespeist von I_GBSD.Q_timeout) laesst TIMEOUT.E1 nur bei tatsaechlicher Wertaenderung durch - so wird TIMEOUT.D1 (Q_timeout) am Adapter-Plug beim Zuruecksetzen auf false weiterhin zuverlaessig aktualisiert, ohne bei jeder einzelnen Botschaft im gesunden Normalbetrieb erneut zu feuern. Der zugrundeliegende TIMEOUT/IND-Vertrag von I_GBSD selbst ist in dessen eigener .fbt-Datei dokumentiert.</p>
]]></Attribute>
</FBType>
