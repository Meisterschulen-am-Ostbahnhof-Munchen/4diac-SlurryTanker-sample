<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="AUS_AX_SEL_AUS_2_VAL" Comment="Binäre Auswahl für AUS-Werte mit 2 internen initval_AUS und AUS_AX_SEL_AUS.&#10;Schaltet per G-Adapter zwischen val0 (G=FALSE) und val1 (G=TRUE) um.">
