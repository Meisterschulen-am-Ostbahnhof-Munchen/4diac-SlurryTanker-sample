<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Softkey_Web_IXA" Comment="SoftKey (VT) ODER lokaler Web-Override (vt-ui-mirror, Dauerzustand) zu 1&#10;gemeinsamem kontinuierlichem AX-Zustand zusammengefuehrt - fuer Taster ohne&#10;AUX-Zuordnung (z.B. Fahrwerk-Mittelpunkt), die trotzdem per Web-Client genauso&#10;wie physisch gedrueckt/gehalten werden koennen sollen. Analog zu&#10;Softkey_Aux_IXA_TO_Remote_WRITE (dort zusaetzlich mit AUX + Remote-Write), hier&#10;nur der reine Merge ohne AUX und ohne Schreiben irgendwohin - der Aufrufer&#10;verarbeitet den gemergten Zustand selbst weiter (z.B. SoftKey_Kurz_Lang).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-11" Remarks="initial implementation - herausgeloest aus Fahrwerk_Mittelpunkt_Automatik.SUB (Softkey_Mittelpunkt+WebSub_Mittelpunkt+OR_MITTELPUNKT), wiederverwendbar fuer jeden Taster ohne AUX, der auch per Web gehalten werden koennen soll.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
