<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="SUBSCRIBE_R_TRIG" Comment="Subscribed AX-Wert (per ID) auf steigende Flanke ueberwachen und als Event&#10;ausgeben">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="2.0" Author="Franz Höpfinger" Date="2026-09-11" Remarks="Redundanten doppelten D_FF entfernt: vorher AX_SUBSCRIBE_1 (mit eigenem E_D_FF-Puffer) gefolgt von AX_R_TRIG (mit eigenem E_R_TRIG-Flankenspeicher) - 2 Speicher hintereinander fuer 1 Flankenerkennung. Jetzt direkt das rohe SUBSCRIBE_1 + E_R_TRIG verdrahtet (SUBSCRIBE_1.IND/RD_1 direkt in E_R_TRIG.EI/QI), nur noch 1 Speicherzustand.">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-08-26" Remarks="initial API and implementation">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="INIT" Type="EInit" Comment="Initialization Request">
			</SubAppEvent>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</SubAppEvent>
			<SubAppEvent Name="EO" Type="Event" Comment="Feuert bei steigender Flanke des subscribed AX-Werts"/>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Quality Input - TRUE to enable service" InitialValue="TRUE"/>
			<VarDeclaration Name="ID" Type="WSTRING" Comment="OPC-UA-Endpoint-Konstante (READ), z. B. Anlage_EIN_READ"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Quality Output - TRUE if service executed successfully"/>
		</OutputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="SUBSCRIBE" Type="iec61499::net::SUBSCRIBE_1" x="0" y="0">
		</FB>
		<FB Name="E_R_TRIG" Type="iec61499::events::E_R_TRIG" x="1200" y="400">
		</FB>
		<EventConnections>
			<Connection Source="SUBSCRIBE.IND" Destination="E_R_TRIG.EI" dx1="600"/>
			<Connection Source="E_R_TRIG.EO" Destination="EO" dx1="693.33"/>
			<Connection Source="INIT" Destination="SUBSCRIBE.INIT"/>
			<Connection Source="SUBSCRIBE.INITO" Destination="INITO"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="ID" Destination="SUBSCRIBE.ID" dx1="800">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="SUBSCRIBE.RD_1" Destination="E_R_TRIG.QI" dx1="600"/>
			<Connection Source="QI" Destination="SUBSCRIBE.QI"/>
			<Connection Source="SUBSCRIBE.QO" Destination="QO"/>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
