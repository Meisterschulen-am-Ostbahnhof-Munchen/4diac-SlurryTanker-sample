	</Identification>
	<VersionInfo Organization="Büngener Schuder GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-10-15" Remarks="initial implementation - aus Aufnahme_PVEA/Igelband_PVEA/Elevator_PVEA.SUB herausgeloest (dort AR_GT_Aktiv+LIT_0 jeweils einzeln verdrahtet, mit sich kreuzenden Leitungen in der IDE-Ansicht).">
	</VersionInfo>
