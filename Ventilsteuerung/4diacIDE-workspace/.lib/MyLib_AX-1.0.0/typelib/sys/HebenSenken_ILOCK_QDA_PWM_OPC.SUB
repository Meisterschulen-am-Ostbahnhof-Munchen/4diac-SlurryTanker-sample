<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="HebenSenken_ILOCK_QDA_PWM_OPC" Comment="2 Remote-Kommandos (Heben/Senken, je Subscribe+State-Publish, ODER-verknuepft&#10;mit IO-Test wie bei ILOCK_SWITCH_2_QXA_OPC) auf 1 ratiometrisches PWM-Signal&#10;(Danfoss PVEA: 25%=Senken, 50%=Neutral, 75%=Heben, Lastteiler-korrigiert).&#10;ILOCK_SWITCH_PROTECT_AX (Last-Wins mit Schutzzeit) sorgt dafuer, dass Heben und&#10;Senken nie gleichzeitig aktiv sind. Generisch fuer jeden PVEA-Aktor mit&#10;ratiometrischem 3-Stufen-PWM-Kanal.">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.6" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Neuer SubAppEventOutput INITO (Type EInit), durchgereicht von PWM_Mux.INITO (HebenSenken_QDA_PWM v1.3) - analog ILOCK_SWITCH_2_QXA_OPC v1.3, fuer Aufnahme_Option.SUB.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.5" Author="Franz Höpfinger" Date="2026-10-11" Remarks="Neuer SubAppEventInput INIT (Type EInit), durchgereicht an PWM_Mux.INIT (HebenSenken_QDA_PWM v1.2) statt Auto-Verteilung - analog ILOCK_SWITCH_2_QXA_OPC v1.2, 'Init wie bei Tecu' (Franz).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.4" Author="Franz Höpfinger" Date="2026-10-11" Remarks="Neuer QI-InputVar (Default TRUE, rueckwaertskompatibel) durchgereicht an PWM_Mux.QI (HebenSenken_QDA_PWM v1.1) - analog ILOCK_SWITCH_2_QXA_OPC v1.1.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.3" Author="Franz Höpfinger" Date="2026-09-27" Remarks="Franz: 'HebenSenken_ILOCK_QDA_PWM_OPC sehe ich KEINE Aenderung?' - das eigene Mux/Skalierungs/Ausgabe-Teilnetz (ASSEMBLE_AB_FROM_AX/AB_TO_AUI/values_50_75_25/AR_AUI_MUX_3/AR_R_MUL_Korrektur/AR_R_MUL_PWM13BIT/AR_TO_AD_NUM/DigitalOutput_PWM) war seit der Auslagerung nach MyLib::sys::HebenSenken_QDA_PWM (fuer Bunkerboden_PWM) doppelt vorhanden - jetzt durch eine Instanz von HebenSenken_QDA_PWM ersetzt (HEBEN/SENKEN aus SPLIT_HEBEN_OUT/SPLIT_SENKEN_OUT direkt verdrahtet statt vorher inline), unveraendertes Verhalten, keine Duplizierung mehr.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-09-27" Remarks="AR_R_MUL_Korrektur/AR_R_MUL_PWM13BIT FACTOR von eingebackenen Rohwerten (REAL#0.715/REAL#81.91) auf benannte Konstanten aus der neuen MyLib::sys::const::PWM_Konstanten umgestellt (PWM_LASTTEILER_KORREKTUR/PWM_13BIT_SKALIERUNG) - unveraendertes Verhalten, nur nicht mehr an mehreren Stellen als Rohwert wiederholt. values_50_75_25 bekommt jetzt explizit FACTOR_75/FACTOR_25 aus derselben GCF (VALUES_50_75_25_FACTOR_75/_25), seit values_50_75_25 v1.2 eigene Parameter statt eingebackener Werte.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-20" Remarks="PWM_POW von intern fest verdrahtetem initval_AR (1.0) auf einen eigenen Socket umgestellt - ein generischer, wiederverwendbarer Typ darf keinen Fixwert fuer eine Groesse verdrahten, die pro Instanz unterschiedlich sein soll (z.B. Aufnahme_Rechts_KVE16_Reserve.SUB braucht ggf. eine andere Verdrahtung als Aufnahme_Links).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-08" Remarks="Ausgelagert aus Heben_Senken_TO_QDA_PWM_OPC (PWM/ILOCK/Mux-Teilnetz, ohne die Freigabe-DO) zur Wiederverwendung.">
	</VersionInfo>
