<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="FillWindowFS_AR" Comment="Färbt ein FillAttributes-Objekt grün innerhalb [rWindowMin, rWindowMax], rot&#10;außerhalb (AR-Eingang)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="2.0" Author="Franz Höpfinger" Date="2026-09-11" Remarks="Umgebaut auf adapter::Engineering::measurements::AR_DEADBAND_COMPARE (jetzt allgemein fuer beliebige Fenster [WINDOW_MIN,WINDOW_MAX], nicht nur symmetrisches Totband) statt eigener Split/GE/LE/AND-Verdrahtung - CENTERED direkt als Gruen/Rot-Auswahl verwendet.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-06" Remarks="initial API and implementation and/or initial documentation - built as a SubAppType (like MyLib_AX's GreenRedBackground1_AX) rather than a custom FBType with an ST helper function; a proper Q_FillAttributes adapter-wrapper FBType is a possible later refinement">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
		<Import declaration="isobus::UT::Q::const::colours::COLOR_GREEN"/>
		<Import declaration="isobus::UT::Q::const::colours::COLOR_RED"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="INIT" Type="EInit" Comment="Initialization Request">
			</SubAppEvent>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</SubAppEvent>
			<SubAppEvent Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
			</SubAppEvent>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Quality Input - TRUE to enable service" InitialValue="TRUE"/>
			<VarDeclaration Name="u16ObjId" Type="UINT" Comment="FillAttributes object ID to command" InitialValue="ID_NULL"/>
			<VarDeclaration Name="rWindowMin" Type="REAL" Comment="Lower bound of the window that shows green"/>
			<VarDeclaration Name="rWindowMax" Type="REAL" Comment="Upper bound of the window that shows green"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Quality Output - TRUE if service executed successfully"/>
			<VarDeclaration Name="STATUS" Type="STRING" Comment="Service Status - passthrough from the internal Q_FillAttributes"/>
			<VarDeclaration Name="s16result" Type="INT" Comment="retval - passthrough from the internal Q_FillAttributes"/>
		</OutputVars>
		<Sockets>
			<AdapterDeclaration Name="rPhys" Type="adapter::types::unidirectional::AR" Comment="Value whose position relative to the window decides the colour"/>
		</Sockets>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="WindowMinConst" Type="adapter::types::unidirectional::AR::initval::initval_AR" x="-5200" y="1900">
		</FB>
		<FB Name="WindowMaxConst" Type="adapter::types::unidirectional::AR::initval::initval_AR" x="-5200" y="500">
		</FB>
		<FB Name="CENTER_CMP" Type="adapter::Engineering::measurements::AR_DEADBAND_COMPARE" x="-3400" y="1300">
		</FB>
		<FB Name="ColorSel" Type="adapter::iec61131::selection::AX_SEL" x="-600" y="1200">
			<Parameter Name="IN0" Value="COLOR_RED"/>
			<Parameter Name="IN1" Value="COLOR_GREEN"/>
		</FB>
		<FB Name="Inner" Type="isobus::UT::Q::Q_FillAttributes" x="1300" y="700">
			<Parameter Name="u8FillType" Value="USINT#2"/>
			<Parameter Name="u16FillPatternId" Value="ID_NULL"/>
		</FB>
		<EventConnections>
			<Connection Source="ColorSel.CNF" Destination="Inner.REQ" dx1="666.67"/>
			<Connection Source="Inner.CNF" Destination="CNF" dx1="1086.67"/>
			<Connection Source="INIT" Destination="Inner.INIT"/>
			<Connection Source="Inner.INITO" Destination="INITO"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="rWindowMin" Destination="WindowMinConst.INIT_VAL" dx1="1080"/>
			<Connection Source="rWindowMax" Destination="WindowMaxConst.INIT_VAL" dx1="1180"/>
			<Connection Source="u16ObjId" Destination="Inner.u16ObjId" dx1="1146.67" dx2="666.67" dy="640"/>
			<Connection Source="ColorSel.OUT" Destination="Inner.u8FillColour" dx1="646.67"/>
			<Connection Source="Inner.STATUS" Destination="STATUS" dx1="1120"/>
			<Connection Source="Inner.s16result" Destination="s16result" dx1="1153.33"/>
			<Connection Source="QI" Destination="Inner.QI"/>
			<Connection Source="Inner.QO" Destination="QO"/>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="rPhys" Destination="CENTER_CMP.Y" dx1="1113.33"/>
			<Connection Source="WindowMinConst.OUT" Destination="CENTER_CMP.WINDOW_MIN" dx1="506.67"/>
			<Connection Source="WindowMaxConst.OUT" Destination="CENTER_CMP.WINDOW_MAX" dx1="506.67"/>
			<Connection Source="CENTER_CMP.CENTERED" Destination="ColorSel.G" dx1="860"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
