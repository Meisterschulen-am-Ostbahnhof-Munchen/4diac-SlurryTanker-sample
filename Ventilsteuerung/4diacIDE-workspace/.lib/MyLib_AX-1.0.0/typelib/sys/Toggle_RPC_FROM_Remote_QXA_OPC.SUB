		</FB>
		<FB Name="AX_T_FF" Type="adapter::events::unidirectional::AX_T_FF" x="-4000" y="-100">
		</FB>
		<FB Name="AX_SPLIT_2" Type="adapter::events::unidirectional::AX_SPLIT_2" x="-2600" y="0">
		</FB>
		<FB Name="DigitalOutput_Q1" Type="logiBUS::io::DQ::logiBUS_QXA" x="-800" y="-1000">
		</FB>
		<FB Name="STATE_CLIENT" Type="adapter::net::AX_CLIENT_1_0" x="-900" y="400">
		</FB>
		<FB Name="AND_QO" Type="iec61131::booleanOperators::AND_BOOL_3">
