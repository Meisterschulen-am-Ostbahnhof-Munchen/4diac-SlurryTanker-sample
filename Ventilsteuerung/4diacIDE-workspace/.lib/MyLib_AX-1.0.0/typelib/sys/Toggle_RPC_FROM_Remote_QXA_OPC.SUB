<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Toggle_RPC_FROM_Remote_QXA_OPC" Comment="Geraet B (Station 12, 192.168.1.12): empfaengt den Trigger-Methodenaufruf von&#10;Geraet A per SERVER_0 (reiner RPC-Trigger, kein Wertwechsel-Trick, keine Bridge&#10;noetig), taktet die echte Toggle-Flipflop-Logik (AX_T_FF), schaltet&#10;DigitalOutput_Q1 und schreibt den neuen Zustand aktiv per CLIENT_1_0 zurueck auf&#10;Geraet A - 'SUB style': das Protokoll steckt im MyLib::sys-Composite, nicht in&#10;der Resource des Geraets">
