			<Connection Source="TRIGGER_SERVER.INITO" Destination="DigitalOutput_Q1.INIT"/>
			<Connection Source="DigitalOutput_Q1.INITO" Destination="STATE_CLIENT.INIT"/>
			<Connection Source="STATE_CLIENT.INITO" Destination="INITO"/>
			<Connection Source="STATE_CLIENT.INITO" Destination="AND_QO.REQ"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="Output" Destination="DigitalOutput_Q1.Output" dx1="4046.67">
