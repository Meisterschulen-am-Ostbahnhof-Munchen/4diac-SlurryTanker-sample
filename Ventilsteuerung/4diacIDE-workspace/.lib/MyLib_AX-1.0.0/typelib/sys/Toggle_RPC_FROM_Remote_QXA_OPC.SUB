			<VarDeclaration Name="ID_TRIGGER_METHOD" Type="WSTRING" Comment="Lokale Methodenadresse (ACTION=CREATE_METHOD) fuer den argumentlosen Trigger-Methodenaufruf, wird von Geraet A per CALL_METHOD aufgerufen"/>
