<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Aux_IE_1" Comment="1 AuxFunction2-Objekt, liest ein konfigurierbares Event (AuxiliaryState, z.B.&#10;AuxEnabled) als reines IND-Event - duenner Wrapper um Aux_IE, analog zu&#10;Softkey_IE_1 (Konvention in diesem Projekt: die isobus-IE-Bausteine werden nie&#10;roh inline verwendet, immer gewrappt).">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-09-11" Remarks="initial implementation">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
		<Import declaration="isobus::UT::io::Auxiliary::IN::AuxiliaryState::Invalid"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="INIT" Type="EInit" Comment="Initialization Request">
			</SubAppEvent>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</SubAppEvent>
			<SubAppEvent Name="IND" Type="Event" Comment="Feuert wenn das konfigurierte InputEvent auftritt"/>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Quality Input - TRUE to enable service" InitialValue="TRUE"/>
			<VarDeclaration Name="u16ObjId" Type="UINT" Comment="Object ID AuxFunction2" InitialValue="ID_NULL"/>
			<VarDeclaration Name="InputEvent" Type="isobus::UT::io::Auxiliary::IN::AuxiliaryState_S" Comment="z.B. AuxEnabled, AuxDisabled" InitialValue="Invalid"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Quality Output - TRUE if service executed successfully"/>
		</OutputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="Aux" Type="isobus::UT::io::Auxiliary::IN::Aux_IE" x="0" y="0">
		</FB>
		<EventConnections>
			<Connection Source="Aux.IND" Destination="IND" dx1="600"/>
			<Connection Source="INIT" Destination="Aux.INIT"/>
			<Connection Source="Aux.INITO" Destination="INITO"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="u16ObjId" Destination="Aux.u16ObjId" dx1="600">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="InputEvent" Destination="Aux.InputEvent" dx1="600">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="QI" Destination="Aux.QI"/>
			<Connection Source="Aux.QO" Destination="QO"/>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
