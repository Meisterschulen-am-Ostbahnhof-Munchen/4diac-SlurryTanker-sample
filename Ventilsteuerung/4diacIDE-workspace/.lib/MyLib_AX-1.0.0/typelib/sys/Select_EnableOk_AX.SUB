	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-08-31" Remarks="Adapter-native Variante von Select_EnableOk: AUS_AX_SEL_AUS (2-stufig) statt F_SEL+Event-Merge, initval_AUS speist die 3 Parameter-Werte als Adapter ein - kein REQ/CNF mehr auf dieser Ebene">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
