			<VarDeclaration Name="valFault" Type="USINT" Comment="Ausgabewert wenn bEnable=TRUE und bOk=FALSE - einmalig bei Instanziierung per Parameter gesetzt"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="value" Type="adapter::types::unidirectional::AUS" Comment="Ausgewaehlter Wert"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="bEnable" Type="adapter::types::unidirectional::AX" Comment="Aktiviert (BOOL, ueber Adapter statt Klartext)"/>
			<AdapterDeclaration Name="bOk" Type="adapter::types::unidirectional::AX" Comment="OK-Zustand (BOOL, ueber Adapter statt Klartext) - nur relevant wenn bEnable=TRUE"/>
		</Sockets>
	</SubAppInterfaceList>
	<SubAppNetwork>
