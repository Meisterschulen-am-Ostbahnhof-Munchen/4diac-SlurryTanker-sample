<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Softkey_IE_1" Comment="1 SoftKey-Objekt, liest ein konfigurierbares Event (SoftKeyActivationCode, z.B.&#10;SK_PRESSED/SK_RELEASED) als reines IND-Event - duenner Wrapper um Softkey_IE&#10;(Konvention in diesem Projekt: Softkey_IE wird nie roh inline verwendet, immer&#10;gewrappt).">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-09-11" Remarks="initial implementation">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
		<Import declaration="isobus::UT::io::Softkey::SoftKeyActivationCode::Invalid"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="INIT" Type="EInit" Comment="Initialization Request">
			</SubAppEvent>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</SubAppEvent>
			<SubAppEvent Name="IND" Type="Event" Comment="Feuert wenn das konfigurierte InputEvent auftritt"/>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Quality Input - TRUE to enable service" InitialValue="TRUE"/>
