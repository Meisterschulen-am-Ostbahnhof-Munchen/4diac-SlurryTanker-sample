		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Quality Output - TRUE if service executed successfully"/>
		</OutputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="SoftKey" Type="isobus::UT::io::Softkey::Softkey_IE" x="0" y="0">
		</FB>
		<EventConnections>
			<Connection Source="SoftKey.IND" Destination="IND" dx1="600"/>
			<Connection Source="INIT" Destination="SoftKey.INIT"/>
			<Connection Source="SoftKey.INITO" Destination="INITO"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="u16ObjId" Destination="SoftKey.u16ObjId" dx1="600">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="InputEvent" Destination="SoftKey.InputEvent" dx1="600">
