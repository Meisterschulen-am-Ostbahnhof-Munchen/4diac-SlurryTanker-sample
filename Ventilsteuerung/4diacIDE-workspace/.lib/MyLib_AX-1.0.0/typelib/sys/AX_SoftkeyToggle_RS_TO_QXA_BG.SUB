			<VarDeclaration Name="u16ObjIdA" Type="UINT" Comment="Object ID AuxFunction2 (Joystick) fuer den Toggle - gleichberechtigt zum SoftKey, zeigt Hintergrundfarbe am Aux-Handle mit" InitialValue="ID_NULL"/>
			<VarDeclaration Name="u16ObjIdB" Type="UINT" Comment="Object ID IO-Diag-Testbutton (Ausgaenge-Diagnoseseite) - toggelt gleichberechtigt mit, zeigt Hintergrundfarbe gemeinsam mit SoftKey+AUX" InitialValue="ID_NULL"/>
			<VarDeclaration Name="u16ObjId_RESET" Type="UINT" Comment="Object ID Softkey &apos;Alles Aus&apos; (Reset, hart auf AUS) - z.B. SoftKey_AUS" InitialValue="ID_NULL"/>
