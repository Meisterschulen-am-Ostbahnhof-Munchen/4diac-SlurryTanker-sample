<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="ILOCK_SWITCH_2_QXA_OPC" Comment="2-Richtungs-Doppelwirkungs-Ausgang (Last-Wins mit Schutzzeit): je Richtung wird&#10;das echte Funktions-Kommando (Remote-Subscribe) mit dem bestehenden&#10;IO-Test-Kommando (Remote-Subscribe) per AX_OR_2 zusammengefuehrt, bevor es in&#10;den Interlock geht - IO-Test bleibt nutzbar, kann aber die beiden Richtungen&#10;nicht mehr dauerhaft gleichzeitig schalten. Interlocked Ausgang treibt den&#10;physischen logiBUS-Kanal UND meldet seinen tatsaechlichen Zustand sowohl an die&#10;bestehende IO-Test-Ueberwachung als auch an die echte Funktions-Rueckmeldung&#10;(z.B. GreenWhiteBackground am SoftKey) zurueck. Generisch fuer jeden 'digital&#10;DW'-Aktor (siehe IO-Liste_Vereinheitlicht.md) mit Bedienung von einem Modul ohne&#10;eigenes VT.">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.3" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Neuer SubAppEventOutput INITO (Type EInit, von DigitalOutput_UP.INITO durchgereicht) - echte Init-Bestaetigung fuer Aufrufer, die diese Instanz hinter einem Option::AOption-Adapter betreiben (Franz: 'das INIT_CNF muss aus Bunker_Klappen raus kommen', nicht per Selfloop simuliert). Rein additiv, bestehende Aufrufer unveraendert (Output bleibt unverdrahtet harmlos).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-10-11" Remarks="Neuer SubAppEventInput INIT (Type EInit), durchgereicht an DigitalOutput_UP/DOWN.INIT statt Auto-Verteilung beim FORTE-Start - noetig, damit QI (Maschinenvariante, z.B. AufnahmeRechts) feststeht BEVOR die physische Kanalbindung passiert. Aufrufer muss INIT jetzt selbst triggern (z.B. iec61131::booleanOperators::INIT ohne Verzoegerung fuer unveraendertes Sofort-Verhalten, oder verzoegert fuer Instanzen die auf einen INI-Wert warten muessen) - 'Init wie bei Tecu' (Franz).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-10-11" Remarks="Neuer QI-InputVar (Default TRUE, rueckwaertskompatibel) durchgereicht an DigitalOutput_UP/DOWN.QI statt fest verdrahtetem TRUE - erlaubt es, diese Instanz komplett inaktiv zu lassen (keine Hardware-Bindung), wenn derselbe physische Kanal je nach Maschinenvariante von einer anderen FB-Instanz genutzt wird (Franz: 'die IO Bausteine haben alle ein QI und INIT, wenn QI bei INIT FALSE ist bleibt der Baustein tot' - Aufnahme_Entlastung Rechts/Bunker_Klappen teilen sich STG2 Q07/Q08).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="franz" Date="2026-09-05">
	</VersionInfo>
