<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="AX_TO_QXA_Option" Comment="Reiner physischer Ausgang: AX-Zustand auf logiBUS_QXA, aktiviert per AOption&#10;(INIT/QI ueber AOption_X_TO_EVENT, INIT_CNF echt von DigitalOutput.INITO).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-17" Remarks="initial implementation - Ausgangs-Teil von AX_TO_QXA_BG_PUBLISH_SWITCHPIC_OPT als eigener Baustein (Franz: an AOption_T_2_Klassisch ein reiner OUT-Baustein), Muster wie OptionalGroup_001.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="logiBUS::io::DQ::logiBUS_DO"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO_S"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="Output" Type="logiBUS::io::DQ::logiBUS_DO_S" Comment="Identify the Output Output_Q1..Q12" InitialValue="logiBUS_DO::Invalid"/>
		</InputVars>
		<Sockets>
			<AdapterDeclaration Name="AOption_IN" Type="Option::AOption" Comment="Aktiviert/deaktiviert den Ausgang"/>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::AX" Comment="Fertiger AX-Zustand fuer den Ausgang"/>
		</Sockets>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="AOption_X_TO_EVENT" Type="Option::conversion::AOption_X_TO_EVENT" x="-3100" y="0">
		</FB>
		<FB Name="DigitalOutput" Type="logiBUS::io::DQ::logiBUS_QXA" x="0" y="0">
		</FB>
		<EventConnections>
			<Connection Source="AOption_X_TO_EVENT.INIT_REQ" Destination="DigitalOutput.INIT"/>
			<Connection Source="DigitalOutput.INITO" Destination="AOption_X_TO_EVENT.INIT_CNF" dx1="80" dx2="80" dy="-480"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="AOption_X_TO_EVENT.QI_OUT" Destination="DigitalOutput.QI"/>
			<Connection Source="Output" Destination="DigitalOutput.Output" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="AOption_IN" Destination="AOption_X_TO_EVENT.AOption_IN"/>
			<Connection Source="IN" Destination="DigitalOutput.OUT" dx1="600"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
