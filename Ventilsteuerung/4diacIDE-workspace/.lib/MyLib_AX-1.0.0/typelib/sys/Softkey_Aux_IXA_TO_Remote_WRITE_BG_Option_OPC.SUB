<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Softkey_Aux_IXA_TO_Remote_WRITE_BG_Option_OPC" Comment="VT-SoftKey lesen ODER AUX-Zuweisung (Joystick) lesen ODER lokaler Web-Override&#10;(z.B. vt-ui-mirror auf demselben Modul) + Remote-OPC-UA-Write an Zielmodul +&#10;VT-Hintergrundfarbe (SoftKey UND AUX) aus Remote-Subscribe - Option-Lib-&#10;Variante von Softkey_Aux_IXA_TO_Remote_WRITE_BG_OPC: Kommando-Seite komplett&#10;inaktiv (echtes INIT_REQ/INIT_CNF, kein VT-Object-Binding) wenn die Option&#10;nicht ausgewaehlt ist. Status-Seite (Remote-Subscribe) bleibt unveraendert&#10;immer aktiv - reiner Read ohne Seiteneffekt.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Büngener Schuder GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Büngener Schuder GmbH" Version="1.1" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Status jetzt auch Option-gated (AX_SUBSCRIBE_BG3_WEB_Option_OPC statt der ungated-Variante) - Franz: 'Command und STATUS muessen beide AUS/AN sein', 'reicht es alle Bausteine auszumachen die einen QI haben'. Command.PLUG1 -&gt; Status.OPTION (sequenziell, Daisy-Chain analog OptionalGroup_001a/b) statt die Option-Socket zu splitten (strikt 1:1). Neuer eigener PLUG1-Ausgang reicht die Kette an weitere, dieselbe Option teilende Instanzen weiter (z.B. Bunker_Klappen_Auf -&gt; Bunker_Klappen_Zu).">
	</VersionInfo>
	<VersionInfo Organization="Büngener Schuder GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-10-13" Remarks="initial implementation (verworfen, siehe v1.1) - duennwandiger Wrapper analog Softkey_Aux_IXA_TO_Remote_WRITE_BG_OPC, nutzt aber Softkey_Aux_IXA_TO_Remote_WRITE_Option (OPTION-Socket) statt der QI-Variante. Erster Aufrufer: Subscribe_STG3_Fanghaken (Franz: 'muss ein AOption Adapter sein').">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
