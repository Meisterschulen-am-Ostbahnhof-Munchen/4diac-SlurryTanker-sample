<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="INI_IN_AND_STORE_AUDI2_OVERRIDE" Comment="Wie INI_IN_AND_STORE_AUDI2, aber MIT Override-Moeglichkeit: Socket OVERRIDE_ACTIVE&#10;(AX) erzwingt bei TRUE kontinuierlich einen konfigurierten Wert (Default 1=Deaktiviert)&#10;statt des Live-VT-Werts - z.B. fuer gegenseitigen Options-Ausschluss. Bei&#10;OVERRIDE_ACTIVE=FALSE (unbenutzt) identisches Verhalten wie INI_IN_AND_STORE_AUDI2.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-11" Remarks="AUDI2 adapter variant of INI_IN_AND_STORE_AUDI - NumericValue_IDA + AD_TO_AUDI + AUDI_TO_AUDI2 + INI_AUDI2 (bidirektionaler Adapter statt AUDI+Split-Paar), AUDI_TO_AUDI2.AUDI_OUT gesplittet auf Q_NumericValue_AUDI (VT-Anzeige) und VALUEO (weiterer Consumer). Fuer reine Enum/Ganzzahl-Werte (z.B. Optionsseite Dropdowns 0-3), keine Dezimalstellen.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Umbenannt von INI_IN_AND_STORE_AUDI2 zu INI_IN_AND_STORE_AUDI2_OVERRIDE, damit der Name die Override-Moeglichkeit klar erkennen laesst. Die schlanke Variante ohne OVERRIDE_ACTIVE-Socket (fuer Aufrufer, die ihn nicht brauchen) liegt jetzt separat unter INI_IN_AND_STORE_AUDI2.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Neuer Socket OVERRIDE_ACTIVE (AX, Default unbenutzt/FALSE) - erzwingt bei TRUE kontinuierlich VAL=1 (Deaktiviert) statt des Live-VT-Werts, ueber SEL_Override (AUDI_AX_SEL_AUDI) vor AUDI_TO_AUDI2 eingefuegt. Laeuft ueber denselben bestehenden INI_AUDI2/Q_NumericValue_AUDI-Pfad - Q_NumericValue erlaubt laut eigener Doku nur eine Instanz je ObjId, daher keine zweite Schreib-Instanz moeglich. Fuer gegenseitigen Options-Ausschluss (BunkerKlappen/AufnahmeRechts), unveraendertes Verhalten wenn unbenutzt.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
	</CompilerInfo>
