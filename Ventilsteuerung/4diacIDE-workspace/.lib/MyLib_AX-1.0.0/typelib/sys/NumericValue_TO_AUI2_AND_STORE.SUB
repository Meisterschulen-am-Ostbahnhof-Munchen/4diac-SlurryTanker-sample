<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="NumericValue_TO_AUI2_AND_STORE" Comment="Wie MyLib::sys::NumericValue_TO_AUI2 (VT lesen, als bidirektionalen AUI2-Plug an&#10;einen Consumer wie AOption_AUI_DEMUX_N.K weiterreichen), zusaetzlich mit&#10;INI-Persistenz: beim Boot gewinnt der aus INI_AUI2 geladene Wert (per&#10;AUI_LAST_2 gegen die Live-VT-Lesung gemergt), danach jede Live-Aenderung;&#10;gespeichert wird immer der vom Consumer ZURUECKGEMELDETE (tatsaechlich&#10;uebernommene) Wert. Eigene Baustein-Klasse getrennt von INI_IN_AND_STORE_AUI2/&#10;_AUDI2 - die bleiben unveraendert (KEY/SECTION, plain VALUEO), da sie in&#10;zahlreichen anderen Projekten verwendet werden.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="3.0" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Korrektur 2: der bisher ungenutzte Boot-Wert von INI_AUI2 (AUI_TO_AUI2_1.AUI_OUT) wird jetzt tatsaechlich verwendet - per AUI_LAST_2 (Last-Writer-Wins) gegen die Live-VT-Lesung (AD_TO_AUI.AUI_OUT) gemergt, bevor es zu VALUEO geht. Da SETM=FALSE ist, feuert INI_AUI2 dieses Boot-Echo nur einmal beim Start (INIT-&gt;INITO-&gt;GET-&gt;GETO), nicht bei jedem spaeteren Schreibvorgang - kein Dauerkreislauf.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="2.0" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Korrektur: die Live-VT-Lesung geht jetzt DIREKT an VALUEO (ein einziges AUI_TO_AUI2, wie in NumericValue_TO_AUI2) - NICHT mehr ueber INI_AUI2 vorgeschaltet. Gespeichert wird stattdessen erst das vom Consumer ueber VALUEO ZURUECKGEMELDETE (tatsaechlich uebernommene) Ergebnis, ueber eine zweite, reine Schreib-Bruecke zu INI_AUI2. SETM=FALSE (statt TRUE) verhindert, dass INI_AUI2 jeden Schreibvorgang sofort wieder quittiert/zurueckmeldet - das wuerde sich sonst im Kreis drehen (Wert raus, zurueck, erneut speichern, erneut raus, ...), da dieses Echo hier nirgendwo terminiert wird.">
	</VersionInfo>
