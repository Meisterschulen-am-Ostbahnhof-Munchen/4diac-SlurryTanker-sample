			<Connection Source="INIT" Destination="Q_BackgroundColour.INIT"/>
			<Connection Source="Q_BackgroundColour.INITO" Destination="INITO"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="u16ObjId" Destination="Q_BackgroundColour.u16ObjId" dx1="1126.67"/>
			<Connection Source="Q_BackgroundColour.s16result" Destination="result_1" dx1="1513.33"/>
