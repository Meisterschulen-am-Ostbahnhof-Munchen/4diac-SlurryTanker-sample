<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="WhiteGreenPurpleBackground1_AX" Comment="Hintergrundfarbe fuer 1 Objekt (AX-Adapter), 3 Zustaende: DI1=FALSE -&gt; Weiss&#10;(nicht erfuellt), DI1=TRUE -&gt; Gruen (erfuellt), DI2=TRUE -&gt; Violett (Override,&#10;hat Vorrang vor DI1). Franz: Vorbedingungs-Badges (Saege/Baender/Zapfwelle) bei&#10;Aufnahme-Automatik.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-01" Remarks="initial implementation, analog GreenWhiteBackground1_AX - 2 verschachtelte F_SEL (nicht AX_SEL, da ein einzelnes AX_SEL nur bei Aenderung des EIGENEN G neu auswertet und die 2. Stufe bei einer Aenderung von DI1 sonst nicht nachziehen wuerde) - beide F_SEL werden ueber einen gemeinsamen Trigger (E_MERGE_2 aus DI1.E1/DI2.E1) in Reihe neu ausgewertet, damit eine Aenderung von DI1 ODER DI2 immer die komplette, korrekte Farbe liefert.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
		<Import declaration="isobus::UT::Q::const::colours::COLOR_GREEN"/>
		<Import declaration="isobus::UT::Q::const::colours::COLOR_WHITE"/>
		<Import declaration="isobus::UT::Q::const::colours::COLOR_PURPLE"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="INIT" Type="EInit" Comment="Initialization Request">
			</SubAppEvent>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</SubAppEvent>
			<SubAppEvent Name="CNF" Type="Event" Comment="Execution Confirmation">
			</SubAppEvent>
		</SubAppEventOutputs>
		<InputVars>
