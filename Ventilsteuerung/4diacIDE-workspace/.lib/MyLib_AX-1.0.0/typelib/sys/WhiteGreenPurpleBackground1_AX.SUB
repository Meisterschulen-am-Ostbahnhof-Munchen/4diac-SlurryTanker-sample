			<AdapterDeclaration Name="DI2" Type="adapter::types::unidirectional::AX" Comment="Override aktiv (TRUE=Violett) - hat Vorrang vor DI1"/>
		</Sockets>
	</SubAppInterfaceList>
	<SubAppNetwork>
