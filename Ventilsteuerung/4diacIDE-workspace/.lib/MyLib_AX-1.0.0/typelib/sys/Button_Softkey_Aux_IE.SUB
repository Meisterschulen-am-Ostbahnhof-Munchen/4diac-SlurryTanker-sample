	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-29" Remarks="packageName-Tippfehler behoben (MyLib_AX::sys -&gt; MyLib::sys, analog allen Geschwistern). Instanz Softkey_IE_1 in Softkey umbenannt (war identisch zu ihrem eigenen Type-Namen, inkonsistent zu Button/Aux). Kommentar korrigiert (beschrieb nur 2 von 3 Quellen).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-20" Remarks="initial implementation - Bugfix fuer Automatik_Toggle_Button.SUB (nutzte bisher Softkey_Aux_IE mit einer Button-Object-ID, Softkey_IE empfaengt aber keine Button-Activation-Message - bestaetigt vom Autor der FORTE-Implementierung).">
	</VersionInfo>
