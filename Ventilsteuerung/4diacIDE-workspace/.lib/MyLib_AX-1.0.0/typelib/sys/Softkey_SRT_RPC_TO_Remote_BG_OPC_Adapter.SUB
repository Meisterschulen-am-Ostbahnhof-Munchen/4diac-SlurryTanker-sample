			<Connection Source="QI" Destination="TRIGGER.QI"/>
			<Connection Source="QI" Destination="SoftKeySRT_ASRT_AX.QI"/>
			<Connection Source="TRIGGER.QO" Destination="AND_QO.IN1"/>
			<Connection Source="SoftKeySRT_ASRT_AX.QO" Destination="AND_QO.IN2"/>
			<Connection Source="AND_QO.OUT" Destination="QO"/>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="SoftKeySRT_ASRT_AX.OUT" Destination="TRIGGER.S_R_T" dx1="900"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
