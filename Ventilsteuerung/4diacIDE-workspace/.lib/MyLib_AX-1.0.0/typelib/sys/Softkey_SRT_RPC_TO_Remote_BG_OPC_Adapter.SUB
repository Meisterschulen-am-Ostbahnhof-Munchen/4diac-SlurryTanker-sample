<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Softkey_SRT_RPC_TO_Remote_BG_OPC_Adapter" Comment="Geraet A (Station 11, 192.168.1.11): wie Softkey_SRT_RPC_TO_Remote_BG_OPC, aber&#10;HMI (3 SoftKeys + GreenWhiteBackground) und OPC-UA-Trigger sind getrennt -&#10;SoftKeySRT_ASRT_AX buendelt die HMI hinter einem ASRT_AX-Plug,&#10;ASRT_AX_CLIENT_0_SUBSCRIBE_1 buendelt die 3 CLIENT_0-Instanzen + AX_SUBSCRIBE_1&#10;hinter einem ASRT_AX-Socket - 'SUB style': das Protokoll steckt im&#10;MyLib::sys-Composite, nicht in der Resource des Geraets">
