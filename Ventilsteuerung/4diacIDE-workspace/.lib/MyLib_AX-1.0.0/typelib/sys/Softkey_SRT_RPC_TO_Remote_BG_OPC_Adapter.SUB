			<SubAppEvent Name="INIT" Type="EInit" Comment="Initialization Request">
			</SubAppEvent>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</SubAppEvent>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Quality Input - TRUE to enable service" InitialValue="TRUE"/>
			<VarDeclaration Name="u16ObjId_SET" Type="UINT" Comment="Object ID SoftKey Set" InitialValue="ID_NULL"/>
			<VarDeclaration Name="u16ObjId_RESET" Type="UINT" Comment="Object ID SoftKey Reset" InitialValue="ID_NULL"/>
			<VarDeclaration Name="u16ObjId_TOGGLE" Type="UINT" Comment="Object ID SoftKey Toggle (traegt auch das GreenWhiteBackground)" InitialValue="ID_NULL"/>
			<VarDeclaration Name="ID_SET_CALL" Type="WSTRING" Comment="Remote-Methodenadresse (ACTION=CALL_METHOD) fuer den Set-Methodenaufruf auf Geraet B"/>
			<VarDeclaration Name="ID_RESET_CALL" Type="WSTRING" Comment="Remote-Methodenadresse (ACTION=CALL_METHOD) fuer den Reset-Methodenaufruf auf Geraet B"/>
			<VarDeclaration Name="ID_TOGGLE_CALL" Type="WSTRING" Comment="Remote-Methodenadresse (ACTION=CALL_METHOD) fuer den Toggle-Methodenaufruf auf Geraet B"/>
			<VarDeclaration Name="ID_STATE_READ" Type="WSTRING" Comment="Lokal ueberwachte Adresse (BOOL, ACTION=READ) fuer den Flipflop-Zustand, wird von Geraet B remote beschrieben"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Quality Output - TRUE if service executed successfully"/>
		</OutputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<SubApp Name="SoftKeySRT_ASRT_AX" Type="MyLib::sys::SoftKeySRT_ASRT_AX" x="-4300" y="800">
		</SubApp>
		<FB Name="TRIGGER" Type="adapter::net::ASRT_AX_CLIENT_0_SUBSCRIBE_1" x="-2100" y="-300">
		</FB>
		<FB Name="AND_QO" Type="iec61131::booleanOperators::AND_BOOL_2">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="TRIGGER.INIT"/>
			<Connection Source="TRIGGER.INITO" Destination="SoftKeySRT_ASRT_AX.INIT"/>
			<Connection Source="SoftKeySRT_ASRT_AX.INITO" Destination="INITO"/>
			<Connection Source="SoftKeySRT_ASRT_AX.INITO" Destination="AND_QO.REQ"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="ID_SET_CALL" Destination="TRIGGER.ID_SET" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_RESET_CALL" Destination="TRIGGER.ID_RESET" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_TOGGLE_CALL" Destination="TRIGGER.ID_TOGGLE" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_STATE_READ" Destination="TRIGGER.ID_STATE" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjId_SET" Destination="SoftKeySRT_ASRT_AX.u16ObjId_SET" dx1="1346.67">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjId_RESET" Destination="SoftKeySRT_ASRT_AX.u16ObjId_RESET" dx1="1346.67">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjId_TOGGLE" Destination="SoftKeySRT_ASRT_AX.u16ObjId_TOGGLE" dx1="1346.67">
