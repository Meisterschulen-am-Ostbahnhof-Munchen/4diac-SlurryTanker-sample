<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="SoftKeySR_PC_B_OPC" Comment="Geraet B (Station 12, 192.168.1.12): empfaengt Set/Reset je per eigenem&#10;SERVER_0-Methodenaufruf (reiner RPC-Trigger, kein Wertwechsel-Trick, keine&#10;Bridge noetig), taktet die reine SR-Flipflop-Logik (AX_SR, kein Toggle),&#10;schaltet DigitalOutput_Q1 und schreibt den neuen Zustand aktiv per CLIENT_1_0&#10;zurueck auf Geraet A - 'SUB style': das Protokoll steckt im&#10;MyLib::sys-Composite, nicht in der Resource des Geraets">
