<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="T_FF_ILOCK_EVENT_AX" Comment="Toggle-Flip-Flop mit Interlock / Reset-Eingang und SET-Event-Ausgang (AX Adapter&#10;Version)">
