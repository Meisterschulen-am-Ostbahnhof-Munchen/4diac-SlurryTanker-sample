<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="SoftKeySR_PC_A_OPC" Comment="Geraet A (Station 11, 192.168.1.11): 2 SoftKeys (Set/Reset) rufen je einen&#10;eigenen argument- und rueckgabewertlosen OPC-UA-Methodenaufruf auf Geraet B auf&#10;(CLIENT_0, 2 eigene Methoden - wie Training_04, aber ohne Toggle);&#10;GreenWhiteBackground am Set-SoftKey zeigt den von Geraet B lokal ueberwachten&#10;Flipflop-Zustand - 'SUB style': das Protokoll steckt im MyLib::sys-Composite,&#10;nicht in der Resource des Geraets">
