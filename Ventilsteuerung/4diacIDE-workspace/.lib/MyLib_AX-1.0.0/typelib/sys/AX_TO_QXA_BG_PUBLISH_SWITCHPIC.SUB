<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="AX_TO_QXA_BG_PUBLISH_SWITCHPIC" Comment="AX_TO_QXA_BG_PUBLISH (Ausgang+Hintergrund+Publish) UND AX_SwitchPic_2_1&#10;(ObjectPointer-Statusanzeige) aus demselben fertigen AX-Zustand gespeist -&#10;AX_SPLIT_2 davor, da beide Sub-Bausteine den Zustand brauchen&#10;(Adapter-Fanout-Regel).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Neuer SubAppEventOutput INITO (Type EInit), durchgereicht von Publish.INITO (AX_TO_QXA_BG_PUBLISH v1.2) - fuer die Option-Lib-Migration Igel/Elevator Klassisch.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-10-12" Remarks="Neuer InputVar QI (BOOL) + SubAppEventInput INIT (Type EInit), durchgereicht an Publish.QI/.INIT (AX_TO_QXA_BG_PUBLISH v1.1) statt hartem TRUE/Auto-Verteilung - QI-Gate Igel/Elevator Klassisch-vs-PVEA. Blast radius: 3 Instanzen, alle in Baender_EinAus.SUB.">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO"/>
		<Import declaration="logiBUS::io::DQ::logiBUS_DO_S"/>
		<Import declaration="isobus::UT::Q::types::s2x1ObjectIDs"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="INIT" Type="EInit" Comment="Initialisierung - durchgereicht an Publish.INIT statt Auto-Verteilung"/>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="INITO" Type="EInit" Comment="Initialisierung abgeschlossen - echtes Confirm von Publish.INITO"/>
		</SubAppEventOutputs>
		<InputVars>
			<VarDeclaration Name="u16ObjId" Type="UINT" Comment="Object ID Softkey - traegt die Hintergrundfarbe" InitialValue="ID_NULL"/>
			<VarDeclaration Name="u16ObjIdA" Type="UINT" Comment="Object ID AuxFunction2 (Joystick) - zeigt Hintergrundfarbe am Aux-Handle mit" InitialValue="ID_NULL"/>
			<VarDeclaration Name="Output" Type="logiBUS::io::DQ::logiBUS_DO_S" Comment="Identify the Output Output_Q1..Q12" InitialValue="logiBUS_DO::Invalid"/>
			<VarDeclaration Name="ID_STATE_WRITE" Type="WSTRING" Comment="Lokale Publish-Adresse (ACTION=WRITE) fuer den tatsaechlichen Zustand - wird von Web-Client/Dashboard remote abonniert"/>
			<VarDeclaration Name="Picture" Type="UINT" Comment="Object ID des ObjectPointer, der den Status-Kaestchen-Inhalt traegt"/>
			<VarDeclaration Name="pictures" Type="isobus::UT::Q::types::s2x1ObjectIDs" Comment="die beiden Ziel-Object-IDs (up=aus, down=an)" InitialValue="(up := (u16ObjId := ID_NULL), down := (u16ObjId := ID_NULL))"/>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Qualifier fuer den physischen Ausgang - FALSE haelt diese Instanz komplett inaktiv" InitialValue="TRUE"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Quality Output - TRUE if service executed successfully (AND aus Publish/ObjPtr)"/>
		</OutputVars>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::AX" Comment="Fertiger AX-Zustand (bereits zusammengefuehrt) - wird auf Ausgang+Hintergrund+Publish UND ObjectPointer-Statusanzeige verteilt"/>
		</Sockets>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="AX_SPLIT_2" Type="adapter::events::unidirectional::AX_SPLIT_2" x="0" y="0">
		</FB>
		<SubApp Name="Publish" Type="MyLib::sys::AX_TO_QXA_BG_PUBLISH" x="1700" y="-800">
		</SubApp>
		<SubApp Name="ObjPtr" Type="MyLib::sys::AX_SwitchPic_2_1" x="1700" y="800">
		</SubApp>
		<FB Name="AND_QO" Type="iec61131::booleanOperators::AND_BOOL_2" x="1700" y="1600">
		</FB>
		<DataConnections>
			<Connection Source="u16ObjId" Destination="Publish.u16ObjId" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjIdA" Destination="Publish.u16ObjIdA" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Output" Destination="Publish.Output" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_STATE_WRITE" Destination="Publish.ID_STATE_WRITE" dx1="1280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Picture" Destination="ObjPtr.Picture" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="pictures" Destination="ObjPtr.pictures" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="QI" Destination="Publish.QI" dx1="1280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="QI" Destination="ObjPtr.QI"/>
			<Connection Source="Publish.QO" Destination="AND_QO.IN1"/>
			<Connection Source="ObjPtr.QO" Destination="AND_QO.IN2"/>
			<Connection Source="AND_QO.OUT" Destination="QO"/>
		</DataConnections>
		<EventConnections>
			<Connection Source="INIT" Destination="Publish.INIT" dx1="600"/>
			<Connection Source="Publish.INITO" Destination="ObjPtr.INIT"/>
			<Connection Source="ObjPtr.INITO" Destination="INITO" dx2="80" dy="-420"/>
			<Connection Source="ObjPtr.INITO" Destination="AND_QO.REQ"/>
		</EventConnections>
		<AdapterConnections>
			<Connection Source="IN" Destination="AX_SPLIT_2.IN" dx1="600"/>
			<Connection Source="AX_SPLIT_2.OUT1" Destination="Publish.IN" dx1="600"/>
			<Connection Source="AX_SPLIT_2.OUT2" Destination="ObjPtr.DI1" dx1="600"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
