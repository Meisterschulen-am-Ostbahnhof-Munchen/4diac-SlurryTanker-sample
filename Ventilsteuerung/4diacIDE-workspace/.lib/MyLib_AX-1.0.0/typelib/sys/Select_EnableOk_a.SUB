	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="Extrahiert aus Q_BackgroundColour_EnableOk - die reine 2-Bool-zu-1-von-3-Werten-Logik, entkoppelt von der VT-Hintergrundfarben-Anwendung">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
