		<FB Name="F_SEL_ENABLE" Type="iec61131::selection::F_SEL" x="2400" y="0">
		</FB>
		<EventConnections>
			<Connection Source="REQ" Destination="F_SEL_OK_FAULT.REQ" dx1="720"/>
			<Connection Source="F_SEL_OK_FAULT.CNF" Destination="F_MOVE.REQ"/>
