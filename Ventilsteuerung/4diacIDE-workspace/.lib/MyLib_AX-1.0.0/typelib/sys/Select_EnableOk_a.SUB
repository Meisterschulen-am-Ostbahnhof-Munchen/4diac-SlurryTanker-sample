			<Connection Source="F_SEL_ENABLE.CNF" Destination="CNF" dx1="400"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="bOk" Destination="F_SEL_OK_FAULT.G" dx1="400"/>
			<Connection Source="valFault" Destination="F_SEL_OK_FAULT.IN0" dx1="400"/>
			<Connection Source="valOk" Destination="F_SEL_OK_FAULT.IN1" dx1="400"/>
			<Connection Source="F_SEL_OK_FAULT.OUT" Destination="F_MOVE.IN"/>
