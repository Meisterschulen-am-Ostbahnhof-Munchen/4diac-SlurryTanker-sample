			<VarDeclaration Name="bOk" Type="BOOL" Comment="OK-Zustand (nur relevant wenn bEnable=TRUE)"/>
			<VarDeclaration Name="valDisabled" Type="USINT" Comment="Ausgabewert wenn bEnable=FALSE - einmalig bei Instanziierung per Parameter gesetzt"/>
			<VarDeclaration Name="valOk" Type="USINT" Comment="Ausgabewert wenn bEnable=TRUE und bOk=TRUE - einmalig bei Instanziierung per Parameter gesetzt"/>
			<VarDeclaration Name="valFault" Type="USINT" Comment="Ausgabewert wenn bEnable=TRUE und bOk=FALSE - einmalig bei Instanziierung per Parameter gesetzt"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="value" Type="USINT" Comment="Ausgewaehlter Wert"/>
		</OutputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
