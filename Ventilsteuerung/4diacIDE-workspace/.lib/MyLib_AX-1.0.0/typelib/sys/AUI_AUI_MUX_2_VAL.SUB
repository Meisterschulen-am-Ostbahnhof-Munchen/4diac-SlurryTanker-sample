<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="AUI_AUI_MUX_2_VAL" Comment="2-Wege-Multiplexer fuer AUI/UINT-Werte mit 2 internen initval_AUI und AUI_MUX_2&#10;/ AUI_AUI_MUX_2. Schaltet per Event-Input (EI1, EI2) zwischen val1, val2 um.">
