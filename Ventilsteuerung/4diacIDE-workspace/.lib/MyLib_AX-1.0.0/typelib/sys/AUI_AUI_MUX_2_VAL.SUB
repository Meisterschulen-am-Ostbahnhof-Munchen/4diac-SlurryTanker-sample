	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-10" Remarks="2-fach AUI/UINT MUX mit initval">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="EI1" Type="Event" Comment="Event zur Auswahl von val1"/>
			<SubAppEvent Name="EI2" Type="Event" Comment="Event zur Auswahl von val2"/>
		</SubAppEventInputs>
		<InputVars>
			<VarDeclaration Name="val1" Type="UINT" Comment="Initialer Ausgabewert bei EI1"/>
			<VarDeclaration Name="val2" Type="UINT" Comment="Initialer Ausgabewert bei EI2"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::AUI" Comment="Ausgewaehlter AUI-Adapter Output"/>
		</Plugs>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="AUI_MUX_2" Type="adapter::events::unidirectional::AUI_MUX_2" x="-2200" y="-1100">
		</FB>
		<FB Name="AUI_AUI_MUX_2" Type="adapter::selection::unidirectional::AUI_AUI_MUX_2" x="100" y="-800">
		</FB>
		<FB Name="initval_AUI_1" Type="adapter::types::unidirectional::AUI::initval::initval_AUI" x="-2300" y="-400">
		</FB>
		<FB Name="initval_AUI_2" Type="adapter::types::unidirectional::AUI::initval::initval_AUI" x="-2300" y="200">
		</FB>
		<EventConnections>
			<Connection Source="EI1" Destination="AUI_MUX_2.EI1" dx1="1000"/>
			<Connection Source="EI2" Destination="AUI_MUX_2.EI2" dx1="1000"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="val1" Destination="initval_AUI_1.INIT_VAL" dx1="1000"/>
			<Connection Source="val2" Destination="initval_AUI_2.INIT_VAL" dx1="1000"/>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="AUI_MUX_2.K" Destination="AUI_AUI_MUX_2.K" dx1="946.67"/>
			<Connection Source="initval_AUI_1.OUT" Destination="AUI_AUI_MUX_2.IN1" dx1="320"/>
			<Connection Source="initval_AUI_2.OUT" Destination="AUI_AUI_MUX_2.IN2" dx1="420"/>
			<Connection Source="AUI_AUI_MUX_2.OUT" Destination="OUT" dx1="700"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
