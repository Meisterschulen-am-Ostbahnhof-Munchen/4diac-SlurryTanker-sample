<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="A2X2_ILOCK_SWITCH_PROTECT" Comment="Buendelt den NET-Roundtrip (bidirektionales A2X2) mit der Last-Wins-Arbitrierung&#10;samt Schutz-Totzeit: A2X2_TO_A2X spaltet A2X2 in ein unidirektionales A2X-Socket&#10;(Taster-Zustand) + -Plug (Rueckschreibe-Zustand), ILOCK_SWITCH_PROTECT_A2X&#10;arbeitet direkt auf dem gebuendelten Paar, A2X_SPLIT_2 dupliziert den&#10;interlocked Zustand auf den Rueckschreibe-Pfad und auf den externen A2X-Plug&#10;(fuer die physischen Ausgaenge) - 'SUB style': Bridge+Interlock+Split stecken im&#10;Composite, nicht in der Resource des Geraets.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-05" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
			<VarDeclaration Name="DT_PROTECT" Type="TIME" Comment="Schutz-Totzeit vor Richtungswechsel" InitialValue="T#50ms"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::A2X" Comment="Interlocked UP/DOWN Zustand, fuer physische Ausgaenge"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IO" Type="adapter::types::bidirectional::A2X2" Comment="Gebuendelter NET-Roundtrip: Taster-Zustand rein, Rueckschreibe-Zustand raus"/>
		</Sockets>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="BRIDGE" Type="adapter::conversion::bidirectional::A2X2_TO_A2X" x="100" y="0">
		</FB>
		<FB Name="ILOCK" Type="logiBUS::signalprocessing::interlock::ILOCK_SWITCH_PROTECT_A2X" x="1700" y="-700">
		</FB>
		<FB Name="E_TimeOut" Type="iec61499::events::E_TimeOut" x="3700" y="-200">
		</FB>
		<FB Name="SPLIT" Type="adapter::events::unidirectional::A2X_SPLIT_2" x="3900" y="-800">
		</FB>
		<DataConnections>
			<Connection Source="DT_PROTECT" Destination="ILOCK.DT_PROTECT" dx1="2446.67">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
		</DataConnections>
		<AdapterConnections>
			<Connection Source="IO" Destination="BRIDGE.A2X2_BIDIR" dx1="2153.33"/>
			<Connection Source="BRIDGE.A2X_OUT" Destination="ILOCK.IN" dx1="266.67"/>
			<Connection Source="ILOCK.timeOut" Destination="E_TimeOut.TimeOutSocket" dx1="146.67"/>
			<Connection Source="ILOCK.OUT" Destination="SPLIT.IN" dx1="393.33"/>
			<Connection Source="SPLIT.OUT2" Destination="BRIDGE.A2X_IN" dx1="66.67" dx2="200" dy="1206.67"/>
			<Connection Source="SPLIT.OUT1" Destination="OUT" dx1="6800"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
