<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="INI_IN_AND_STORE_AR2_OVERRIDE" Comment="Wie INI_IN_AND_STORE_AR2, aber MIT Override-Moeglichkeit: Socket OVERRIDE_ACTIVE&#10;(AX) erzwingt bei TRUE kontinuierlich einen konfigurierten Wert (Parameter&#10;INIT_VAL an LIT_Override, Default 0.0) statt des Live-VT-Werts. Bei&#10;OVERRIDE_ACTIVE=FALSE (unbenutzt) identisches Verhalten wie INI_IN_AND_STORE_AR2.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-13" Remarks="AR2-Pendant zu INI_IN_AND_STORE_AUDI2_OVERRIDE: NumericValue_PHYSA + SEL_Override (AR_AX_SEL_AR, G=OVERRIDE_ACTIVE) + AR_TO_AR2 + INI_AR2, AR_TO_AR2.AR_OUT gesplittet auf Q_NumericValue_PHYSA (VT-Anzeige) und VALUEO (weiterer Consumer). Im Unterschied zu AUDI2 (Enum/Dropdown, 1=Deaktiviert) ist AR ein kontinuierlicher physikalischer Wert - der Override-Wert hat hier keine feste Business-Bedeutung, sondern ist ueber INIT_VAL an LIT_Override frei konfigurierbar (Default 0.0).">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
		<Import declaration="logiBUS::utils::conversion::phys::NumericObjectPool_S"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="INIT" Type="EInit" Comment="Initialization Request">
			</SubAppEvent>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</SubAppEvent>
		</SubAppEventOutputs>
		<InputVars>
