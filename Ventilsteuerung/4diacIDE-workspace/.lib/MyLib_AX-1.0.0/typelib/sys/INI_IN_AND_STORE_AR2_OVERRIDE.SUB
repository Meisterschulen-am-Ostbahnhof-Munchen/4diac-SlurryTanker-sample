		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Quality Output - TRUE if service executed successfully"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="VALUEO" Type="adapter::types::unidirectional::AR"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="OVERRIDE_ACTIVE" Type="adapter::types::unidirectional::AX" Comment="Kontinuierlich TRUE erzwingt den ueber LIT_Override.INIT_VAL konfigurierten Wert, unabhaengig vom Live-VT-Wert. FALSE (unbenutzt, Default bei den meisten Aufrufern) = unveraendertes Verhalten."/>
		</Sockets>
	</SubAppInterfaceList>
	<SubAppNetwork>
