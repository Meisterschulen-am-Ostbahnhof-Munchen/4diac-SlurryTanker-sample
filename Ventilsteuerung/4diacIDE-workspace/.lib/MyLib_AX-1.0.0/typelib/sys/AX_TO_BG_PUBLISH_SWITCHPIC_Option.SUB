		</FB>
		<FB Name="AX_SPLIT_3" Type="adapter::events::unidirectional::AX_SPLIT_3" Comment="Adapter-Fanout ist strikt 1:1" x="-1200" y="800">
		</FB>
		<SubApp Name="Background" Type="MyLib::sys::GreenWhiteBackground3_AX" x="1000" y="-1500">
		</SubApp>
