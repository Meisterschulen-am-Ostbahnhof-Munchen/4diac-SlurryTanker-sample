			<Connection Source="AOption_X_TO_EVENT.QI_OUT" Destination="PUBLISH_STATE.QI" dx1="1533.33"/>
			<Connection Source="AOption_X_TO_EVENT.QI_OUT" Destination="ObjPtr.QI" dx1="1533.33"/>
			<Connection Source="u16ObjId" Destination="Background.u16ObjId" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjIdA" Destination="Background.u16ObjIdA" dx1="1400">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="ID_STATE_WRITE" Destination="PUBLISH_STATE.ID" dx1="1280">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Picture" Destination="ObjPtr.Picture" dx1="1400">
