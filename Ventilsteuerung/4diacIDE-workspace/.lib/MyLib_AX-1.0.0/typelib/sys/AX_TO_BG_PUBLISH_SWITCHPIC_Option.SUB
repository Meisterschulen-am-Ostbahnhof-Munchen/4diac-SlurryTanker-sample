	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-17" Remarks="initial implementation - Anzeige-Teil von AX_TO_QXA_BG_PUBLISH_SWITCHPIC_OPT als eigener Baustein (Franz: an AOption_OR_2_Anzeige ein reiner Anzeige-Baustein).">
	</VersionInfo>
	<CompilerInfo packageName="MyLib::sys">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
		<Import declaration="isobus::UT::Q::types::s2x1ObjectIDs"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<InputVars>
