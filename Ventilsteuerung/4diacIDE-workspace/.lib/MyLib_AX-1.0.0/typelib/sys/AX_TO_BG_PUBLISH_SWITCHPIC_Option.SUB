<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="AX_TO_BG_PUBLISH_SWITCHPIC_Option" Comment="Reine Anzeige: AX-Zustand auf Hintergrundfarbe (SoftKey+AUX), lokalen&#10;State-Publish und ObjectPointer-Statusanzeige, aktiviert per AOption (INIT/QI&#10;ueber AOption_X_TO_EVENT, INIT_CNF echt nach ObjPtr.INITO).">
