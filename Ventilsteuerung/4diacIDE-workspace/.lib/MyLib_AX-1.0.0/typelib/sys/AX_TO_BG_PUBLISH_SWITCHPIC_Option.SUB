		<AdapterConnections>
			<Connection Source="AOption_IN" Destination="AOption_X_TO_EVENT.AOption_IN" dx1="806.67"/>
			<Connection Source="IN" Destination="AX_SPLIT_3.IN" dx1="600"/>
