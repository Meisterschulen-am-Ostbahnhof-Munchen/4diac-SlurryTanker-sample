			<Connection Source="AX_SPLIT_3.OUT2" Destination="PUBLISH_STATE.IN" dx1="600"/>
			<Connection Source="AX_SPLIT_3.OUT3" Destination="ObjPtr.DI1" dx1="600"/>
		</AdapterConnections>
	</SubAppNetwork>
</SubAppType>
