			<Connection Source="Background.INITO" Destination="PUBLISH_STATE.INIT" dx1="80" dx2="80" dy="1846.67"/>
			<Connection Source="PUBLISH_STATE.INITO" Destination="ObjPtr.INIT" dx1="80" dx2="80" dy="680"/>
			<Connection Source="ObjPtr.INITO" Destination="AOption_X_TO_EVENT.INIT_CNF" dx1="80" dx2="80" dy="746.67"/>
