<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="AR_TO_Q_Publish_OPC" Comment="Physikalischer AR-Wert -&gt; VT-Anzeige (Q_NumericValue_PHYSA) UND per OPC-UA&#10;publiziert (AR_PUBLISH_1), aus 1 gemeinsamer Quelle (AR_SPLIT_2). Fuer jeden&#10;Wert, der sowohl am VT angezeigt als auch lokal (Self-Subscribe) oder&#10;stationsuebergreifend weiterverwendet werden soll.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-10-03" Remarks="Franz: RateLimit_Anzeige (AR_D_FF_TMIN) vor AR_SPLIT_2 verschoben (Absicht, nicht versehentlich) - drosselt jetzt BEIDE Zweige (VT-Anzeige UND AR_PUBLISH/Self-Subscribe-Konsumenten wie CTRL_PID_AR.AR_ACT) auf max. 1 Update/Tmin, statt nur die Anzeige.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-10-03" Remarks="Franz: 'ich tendiere dazu weniger schnell die Anzeige zu aktualisieren und den Regler trotzdem schnell laufen zu lassen' (Kunde: traeges Verhalten bei eingeschalteter Aufnahme-Automatik, vermutlich VT-Bus-Last durch mehrere gleichzeitig schnell wechselnde Drehzahl-Anzeigen auf der Ernteseite) - 'AR_RATE_LIMIT haben wir schon, D_FF_TMIN': adapter::events::unidirectional::AR_D_FF_TMIN (Tmin=500ms) initial NUR auf dem VT-Anzeige-Zweig eingefuegt (v1.2 verschiebt ihn vor den Split, siehe dort).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-12" Remarks="initial implementation - herausgeloest aus TECU_Speeds.SUB/TECU_RPTO.SUB (AR_SPLIT_2 + Q_NumericValue_PHYSA + AR_PUBLISH_1 kommt oft vor).">
	</VersionInfo>
