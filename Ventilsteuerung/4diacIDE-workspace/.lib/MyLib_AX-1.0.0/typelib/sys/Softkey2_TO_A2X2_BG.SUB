			<VarDeclaration Name="u16ObjId_UP" Type="UINT" Comment="Object ID SoftKey Hoch (traegt auch das GreenWhiteBackground)" InitialValue="ID_NULL"/>
			<VarDeclaration Name="u16ObjId_DOWN" Type="UINT" Comment="Object ID SoftKey Runter (traegt auch das GreenWhiteBackground)" InitialValue="ID_NULL"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Quality Output - TRUE if service executed successfully"/>
		</OutputVars>
		<Plugs>
