		</SubApp>
		<SubApp Name="BG_Down" Type="MyLib::sys::GreenWhiteBackground1_AX" x="700" y="0">
		</SubApp>
		<FB Name="AND_QO" Type="iec61131::booleanOperators::AND_BOOL_4">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="UpKey.INIT"/>
			<Connection Source="UpKey.INITO" Destination="DownKey.INIT"/>
			<Connection Source="DownKey.INITO" Destination="BG_Up.INIT"/>
			<Connection Source="BG_Up.INITO" Destination="BG_Down.INIT"/>
			<Connection Source="BG_Down.INITO" Destination="INITO"/>
			<Connection Source="BG_Down.INITO" Destination="AND_QO.REQ"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="u16ObjId_UP" Destination="UpKey.u16ObjId" dx1="2446.67">
