<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="Softkey2_TO_A2X2_BG" Comment="2 VT-SoftKeys (Softkey_IXA, Hoch/Runter) gebuendelt auf einen einzigen&#10;bidirektionalen A2X2-Adapterausgang: Tastendruecke gehen ueber A2X2_4AX_TO_2X&#10;nach draussen, der ueber denselben Adapter zurueckkommende, tatsaechlich&#10;erreichte Zustand faerbt beide SoftKeys per GreenWhiteBackground1_AX - 'SUB&#10;style': das Buendeln steckt im Composite, nicht in der Resource des Geraets.">
