			</Connection>
			<Connection Source="u16ObjId_DOWN" Destination="DownKey.u16ObjId" dx1="2446.67">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjId_UP" Destination="BG_Up.u16ObjId" dx1="3893.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="u16ObjId_DOWN" Destination="BG_Down.u16ObjId" dx1="3893.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="QI" Destination="UpKey.QI"/>
			<Connection Source="QI" Destination="DownKey.QI"/>
			<Connection Source="UpKey.QO" Destination="AND_QO.IN1"/>
			<Connection Source="DownKey.QO" Destination="AND_QO.IN2"/>
			<Connection Source="AND_QO.OUT" Destination="QO"/>
			<Connection Source="QI" Destination="BG_Up.QI"/>
