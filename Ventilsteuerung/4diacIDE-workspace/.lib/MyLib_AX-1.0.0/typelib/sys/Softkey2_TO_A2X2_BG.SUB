		</Plugs>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="UpKey" Type="isobus::UT::io::Softkey::Softkey_IXA" x="-4800" y="-1400">
		</FB>
		<FB Name="DownKey" Type="isobus::UT::io::Softkey::Softkey_IXA" x="-4800" y="-200">
		</FB>
		<FB Name="CONV" Type="adapter::conversion::bidirectional::A2X2_4AX_TO_2X" x="-2400" y="-700">
		</FB>
