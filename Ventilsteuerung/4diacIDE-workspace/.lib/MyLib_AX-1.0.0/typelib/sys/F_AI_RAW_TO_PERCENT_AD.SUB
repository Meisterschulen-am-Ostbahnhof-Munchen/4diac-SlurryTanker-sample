			<Parameter Name="INIT_VAL" Value="REAL#0.0244200244"/>
		</FB>
		<FB Name="AR_MUL_PERCENT" Type="adapter::iec61131::arithmetic::AR_MUL_2" x="2400" y="0">
		</FB>
		<AdapterConnections>
			<Connection Source="RAW_IN" Destination="AD_TO_AR_NUM.AD_IN" dx1="420"/>
			<Connection Source="AD_TO_AR_NUM.AR_OUT" Destination="AR_MUL_PERCENT.IN1" dx1="420"/>
			<Connection Source="INITVAL_SCALE.OUT" Destination="AR_MUL_PERCENT.IN2" dx1="420"/>
