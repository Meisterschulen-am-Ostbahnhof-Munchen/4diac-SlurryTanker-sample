<?xml version="1.0" encoding="UTF-8"?>
<Function Name="F_OPC_REMOTE" Comment="OPC-UA-ID fuer einen Knoten auf einer anderen Station: opc_ua[ACTION;ENDPOINT#;NODE]">
	<Identification Standard="61499-1" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof &#10; &#10;This program and the accompanying materials are made &#10;available under the terms of the Eclipse Public License 2.0 &#10;which is available at https://www.eclipse.org/legal/epl-2.0/ &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-17" Remarks="initial implementation">
	</VersionInfo>
	<CompilerInfo packageName="MyLib_OPC">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="sAction"/>
				<With Var="sEndpoint"/>
				<With Var="sNode"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var=""/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="sAction" Type="WSTRING" Comment="ACTION, z.B. WRITE oder CALL_METHOD"/>
			<VarDeclaration Name="sEndpoint" Type="WSTRING" Comment="Endpunkt, z.B. opc.tcp://192.168.1.12:4840"/>
			<VarDeclaration Name="sNode" Type="WSTRING" Comment="Knoten, z.B. /Objects/X/Y,1:s=Y"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="" Type="WSTRING"/>
		</OutputVars>
	</InterfaceList>
	<FunctionBody>
		<ST><![CDATA[PACKAGE MyLib_OPC;

(* OPC-UA-ID fuer einen Knoten auf einer anderen Station: opc_ua[ACTION;ENDPOINT#;NODE] *)
FUNCTION F_OPC_REMOTE : WSTRING

VAR_INPUT
	sAction : WSTRING; // ACTION, z.B. WRITE oder CALL_METHOD
	sEndpoint : WSTRING; // Endpunkt, z.B. opc.tcp://192.168.1.12:4840
	sNode : WSTRING; // Knoten, z.B. /Objects/X/Y,1:s=Y
END_VAR

F_OPC_REMOTE := CONCAT("opc_ua[", sAction, ";", sEndpoint, "#;", sNode, "]");

END_FUNCTION
]]></ST>
	</FunctionBody>
</Function>
