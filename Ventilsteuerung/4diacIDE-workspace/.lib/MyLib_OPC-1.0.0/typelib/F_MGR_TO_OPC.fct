	<CompilerInfo packageName="MyLib_OPC">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="sMgr"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var=""/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="sMgr" Type="WSTRING" Comment="MGR_ID der Station, z.B. logiBUS::stations::Computers::C_12"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="" Type="WSTRING"/>
		</OutputVars>
	</InterfaceList>
	<FunctionBody>
		<ST><![CDATA[PACKAGE MyLib_OPC;

(* OPC-UA-Endpunkt aus MGR_ID: 192.168.1.12:61499 -> opc.tcp://192.168.1.12:4840 *)
FUNCTION F_MGR_TO_OPC : WSTRING

VAR_INPUT
	sMgr : WSTRING; // MGR_ID der Station, z.B. logiBUS::stations::Computers::C_12
END_VAR

F_MGR_TO_OPC := CONCAT("opc.tcp://", LEFT(sMgr, FIND(sMgr, ":")), "4840");

END_FUNCTION
]]></ST>
	</FunctionBody>
</Function>
