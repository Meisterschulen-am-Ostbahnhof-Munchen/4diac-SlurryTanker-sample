  </Dependencies>
  <Product Comment="AR/AX/A2X/AUDI-Adapter-Wrapper um logiBUS-Signalverarbeitung und Standard-Lib signalprocessing (Hysterese, Interlock, Fieldbus, Bypass, Distance, Ramp), konsolidiert aus adapter-3.0.0/typelib/{signalprocessing/hysteresis,signalprocessing/ramp,events/unidirectional/*_D_FF_HYS} und logiBUS_signalprocessing-3.0.0/typelib - reine lineare Abhaengigkeit, keine Rueckwaertsreferenz mehr" Name="logiBUS_signalprocessing_adapter" SymbolicName="logiBUS_signalprocessing_adapter">
    <VersionInfo Author="HR Agrartechnik GmbH" Date="2026-10-09" Version="3.0.0"/>
  </Product>
</Manifest>
