<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ILOCK_CONFLICT_TRIP_A2X" Comment="Prioritizes the first active input and trips on conflict. Requires RESET&#10;(Adapter Version, UP/DOWN fed from a single A2X input/output).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-05" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="logiBUS::signalprocessing::interlock">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="EI_RESET" Type="Event">
			</Event>
		</EventInputs>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::A2X" Comment="Output for forward/up and backward/down direction"/>
			<AdapterDeclaration Name="TRIP_OUT" Type="adapter::types::unidirectional::AX" Comment="Trip State Output"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::A2X" Comment="Input for forward/up and backward/down direction"/>
		</Sockets>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="STOP" x="2800" y="1440">
				<ECAction Algorithm="STOP" Output="OUT.E_UP"/>
				<ECAction Output="OUT.E_DOWN"/>
				<ECAction Output="TRIP_OUT.E1"/>
			</ECState>
			<ECState Name="UP" x="5120" y="640">
				<ECAction Algorithm="UP" Output="OUT.E_UP"/>
			</ECState>
			<ECState Name="DOWN" x="4800" y="1920">
				<ECAction Algorithm="DOWN" Output="OUT.E_DOWN"/>
			</ECState>
			<ECState Name="TRIP" x="7200" y="1440">
				<ECAction Algorithm="TRIP" Output="OUT.E_UP"/>
				<ECAction Output="OUT.E_DOWN"/>
				<ECAction Output="TRIP_OUT.E1"/>
			</ECState>
			<ECTransition Source="STOP" Destination="UP" Condition="IN.E_UP[IN.UP AND NOT IN.DOWN]" x="4173.33" y="1020"/>
			<ECTransition Source="STOP" Destination="DOWN" Condition="IN.E_DOWN[IN.DOWN AND NOT IN.UP]" x="4133.33" y="1733.33"/>
			<ECTransition Source="STOP" Destination="TRIP" Condition="IN.E_UP[IN.UP AND IN.DOWN]" x="5000" y="1200"/>
			<ECTransition Source="STOP" Destination="TRIP" Condition="IN.E_DOWN[IN.UP AND IN.DOWN]" x="5000" y="1400"/>
			<ECTransition Source="UP" Destination="STOP" Condition="IN.E_UP[NOT IN.UP]" x="4000" y="800"/>
			<ECTransition Source="UP" Destination="TRIP" Condition="IN.E_DOWN[IN.DOWN]" x="6200" y="1000"/>
			<ECTransition Source="DOWN" Destination="STOP" Condition="IN.E_DOWN[NOT IN.DOWN]" x="3800" y="1800"/>
			<ECTransition Source="DOWN" Destination="TRIP" Condition="IN.E_UP[IN.UP]" x="6000" y="1600"/>
			<ECTransition Source="TRIP" Destination="STOP" Condition="EI_RESET[NOT IN.UP AND NOT IN.DOWN]" x="5000" y="2400"/>
		</ECC>
		<Algorithm Name="UP">
			<ST><![CDATA[
OUT.UP := BOOL#TRUE;
OUT.DOWN := BOOL#FALSE;
TRIP_OUT.D1 := BOOL#FALSE;
]]></ST>
		</Algorithm>
		<Algorithm Name="DOWN">
			<ST><![CDATA[
OUT.UP := BOOL#FALSE;
OUT.DOWN := BOOL#TRUE;
TRIP_OUT.D1 := BOOL#FALSE;
]]></ST>
		</Algorithm>
		<Algorithm Name="STOP">
			<ST><![CDATA[
OUT.UP := BOOL#FALSE;
OUT.DOWN := BOOL#FALSE;
TRIP_OUT.D1 := BOOL#FALSE;
]]></ST>
		</Algorithm>
		<Algorithm Name="TRIP">
			<ST><![CDATA[
OUT.UP := BOOL#FALSE;
OUT.DOWN := BOOL#FALSE;
TRIP_OUT.D1 := BOOL#TRUE;
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
