<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ILOCK_SWITCH_PROTECT_A2X" Comment="Prioritizes the last active input with protection dead-time before switching&#10;(Adapter Version, UP/DOWN fed from a single A2X input).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-05" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="logiBUS::signalprocessing::interlock">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="UPDATE" Type="Event" Comment="Update parameters">
				<With Var="DT_PROTECT"/>
			</Event>
		</EventInputs>
		<InputVars>
			<VarDeclaration Name="DT_PROTECT" Type="TIME" Comment="Protection Dead-Time" InitialValue="T#50ms"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::A2X" Comment="Output for forward/up and backward/down direction"/>
			<AdapterDeclaration Name="timeOut" Type="iec61499::events::ATimeOut" Comment="Protection Timer Adapter"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::A2X" Comment="Input for forward/up and backward/down direction"/>
		</Sockets>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="STOP" x="2800" y="1440">
			</ECState>
			<ECState Name="UP" x="5120" y="640">
				<ECAction Algorithm="UP" Output="OUT.E_UP"/>
				<ECAction Output="OUT.E_DOWN"/>
			</ECState>
			<ECState Name="DOWN" x="4800" y="2400">
				<ECAction Algorithm="DOWN" Output="OUT.E_DOWN"/>
				<ECAction Output="OUT.E_UP"/>
			</ECState>
			<ECState Name="PROTECT" x="5040" y="1520">
				<ECAction Algorithm="STOP" Output="OUT.E_UP"/>
				<ECAction Output="OUT.E_DOWN"/>
				<ECAction Output="timeOut.START"/>
			</ECState>
			<ECState Name="EVAL" x="7600" y="1520">
			</ECState>
			<ECTransition Source="STOP" Destination="UP" Condition="IN.E_UP[IN.UP]" x="4173.33" y="1020"/>
			<ECTransition Source="STOP" Destination="DOWN" Condition="IN.E_DOWN[IN.DOWN]" x="3333.33" y="2133.33"/>
			<ECTransition Source="UP" Destination="PROTECT" Condition="IN.E_UP[NOT IN.UP]" x="5333.33" y="1066.67"/>
			<ECTransition Source="UP" Destination="PROTECT" Condition="IN.E_DOWN[IN.DOWN]" x="6133.33" y="1200"/>
			<ECTransition Source="DOWN" Destination="PROTECT" Condition="IN.E_DOWN[NOT IN.DOWN]" x="5133.33" y="1933.33"/>
			<ECTransition Source="DOWN" Destination="PROTECT" Condition="IN.E_UP[IN.UP]" x="6000" y="2066.67"/>
			<ECTransition Source="PROTECT" Destination="EVAL" Condition="timeOut.TimeOut" x="6333.33" y="1520"/>
			<ECTransition Source="EVAL" Destination="UP" Condition="[IN.UP AND NOT IN.DOWN]" x="6800" y="933.33"/>
			<ECTransition Source="EVAL" Destination="DOWN" Condition="[IN.DOWN AND NOT IN.UP]" x="6800" y="2066.67"/>
			<ECTransition Source="EVAL" Destination="STOP" Condition="[NOT IN.UP AND NOT IN.DOWN]" x="5200" y="1400"/>
			<ECTransition Source="EVAL" Destination="PROTECT" Condition="[IN.UP AND IN.DOWN]" x="6400" y="1666.67"/>
			<ECTransition Source="STOP" Destination="STOP" Condition="UPDATE" x="2346.67" y="1873.33"/>
			<ECTransition Source="UP" Destination="UP" Condition="UPDATE" x="5400" y="500"/>
			<ECTransition Source="DOWN" Destination="DOWN" Condition="UPDATE" x="4500" y="2200"/>
		</ECC>
		<Algorithm Name="UP">
			<ST><![CDATA[
timeOut.DT := DT_PROTECT;
OUT.UP := BOOL#TRUE;
OUT.DOWN := BOOL#FALSE;
]]></ST>
		</Algorithm>
		<Algorithm Name="DOWN">
			<ST><![CDATA[
timeOut.DT := DT_PROTECT;
OUT.UP := BOOL#FALSE;
OUT.DOWN := BOOL#TRUE;
]]></ST>
		</Algorithm>
		<Algorithm Name="STOP">
			<ST><![CDATA[
timeOut.DT := DT_PROTECT;
OUT.UP := BOOL#FALSE;
OUT.DOWN := BOOL#FALSE;
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
