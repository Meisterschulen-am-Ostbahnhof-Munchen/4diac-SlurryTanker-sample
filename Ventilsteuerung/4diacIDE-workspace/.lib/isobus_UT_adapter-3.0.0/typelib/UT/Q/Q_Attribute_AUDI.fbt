		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="u32OldValueAttribute" Type="adapter::types::unidirectional::AUDI" Comment="Old value for attribute " x="3900" y="1100"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="u32ValueAttribute" Type="adapter::types::unidirectional::AUDI" Comment="New value for attribute " x="-600" y="1200"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="Q_Attribute" Type="isobus::UT::Q::Q_Attribute" x="533.33" y="420">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="Q_Attribute.INIT" dx1="1306.67"/>
			<Connection Source="Q_Attribute.INITO" Destination="INITO" dx1="1506.67"/>
			<Connection Source="Q_Attribute.CNF" Destination="CNF" dx1="1760"/>
			<Connection Source="u32ValueAttribute.E1" Destination="Q_Attribute.REQ" dx1="320"/>
			<Connection Source="Q_Attribute.CNF" Destination="u32OldValueAttribute.E1" dx1="906.67"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="Q_Attribute.STATUS" Destination="STATUS" dx1="2000"/>
			<Connection Source="u16ObjId" Destination="Q_Attribute.u16ObjId" dx1="973.33"/>
			<Connection Source="u8IdAttribute" Destination="Q_Attribute.u8IdAttribute" dx1="860"/>
			<Connection Source="u32ValueAttribute.D1" Destination="Q_Attribute.u32ValueAttribute" dx1="486.67"/>
			<Connection Source="Q_Attribute.u32OldValueAttribute" Destination="u32OldValueAttribute.D1" dx1="606.67"/>
			<Connection Source="Q_Attribute.s16result" Destination="s16result" dx1="2573.33"/>
