	<OriginalSource><![CDATA[PACKAGE logiBUS::safety::PLCopen::const;

GLOBALCONSTANTS DiagCodes
	VAR_GLOBAL CONSTANT
		IDLE : WORD := 16#0000; (* 0000 - FB not active *)
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
