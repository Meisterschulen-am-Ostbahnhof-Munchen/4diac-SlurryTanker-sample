<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="I_VP1" Comment="Vehicle Position 1">
	<Identification Standard="ISO 11783-7" Classification="PGN 65267" Function="Vehicle Position 1" Description="Copyright (c) 2024 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65267.html&#10;">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Moritz Ortmeier" Date="07.02.2025">
	</VersionInfo>
	<CompilerInfo packageName="isobus::tecu">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="IND" Type="Event" Comment="Indication from Resource - feuert bei jedem Zyklus ohne aktiven Timeout und publiziert dabei auch den Reset von Q_timeout auf false.">
				<With Var="QO"/>
				<With Var="timestamp_data"/>
				<With Var="Latitude"/>
				<With Var="Longitude"/>
				<With Var="STATUS"/>
				<With Var="Q_timeout"/>
			</Event>
			<Event Name="TIMEOUT" Type="Event" Comment="Feuert ausschliesslich beim tatsaechlichen Eintreten eines Timeouts (Entry-Trigger). Das Zuruecksetzen von Q_timeout auf false wird NICHT hier, sondern ueber IND gemeldet.">
				<With Var="timestamp_timeout"/>
				<With Var="STATUS"/>
				<With Var="Q_timeout"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="Q_timeout" Type="BOOL"/>
			<VarDeclaration Name="timestamp_timeout" Type="DINT"/>
			<VarDeclaration Name="timestamp_data" Type="DINT"/>
			<VarDeclaration Name="Latitude" Type="REAL">
				<Attribute Name="SPN" Type="INT" Value="584"/>
				<Attribute Name="SP_Name" Type="STRING" Value="'Latitude'"/>
				<Attribute Name="SP_Position_In_PG" Type="STRING" Value="'1-4'"/>
				<Attribute Name="SP_Length" Type="INT" Value="4" Comment="4 Bytes"/>
				<Attribute Name="Scaling" Type="STRING" Value=""/>
				<Attribute Name="Offset" Type="INT" Value="-210" Comment=" deg offset"/>
				<Attribute Name="Link" Type="STRING" Value="'https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65267.html#spn-584-latitude'"/>
			</VarDeclaration>
			<VarDeclaration Name="Longitude" Type="REAL">
				<Attribute Name="SPN" Type="INT" Value="585"/>
				<Attribute Name="SP_Name" Type="STRING" Value="'Longitude'"/>
				<Attribute Name="SP_Position_In_PG" Type="STRING" Value="'5-8'"/>
				<Attribute Name="SP_Length" Type="INT" Value="4" Comment="4 bytes"/>
				<Attribute Name="Scaling" Type="STRING" Value="''"/>
				<Attribute Name="Offset" Type="INT" Value="-210" Comment="deg offset"/>
				<Attribute Name="Link" Type="STRING" Value="'https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65267.html#spn-585-longitude'"/>
			</VarDeclaration>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<p>Vehicle Position 1</p>

<p>&nbsp;</p>

<p><strong>TIMEOUT / IND Vertrag:</strong> TIMEOUT feuert ausschliesslich beim tatsaechlichen Eintreten eines Timeouts (Q_timeout wird true). Das Zuruecksetzen von Q_timeout auf false (Timeout vorbei) wird bewusst NICHT nochmal separat ueber TIMEOUT gemeldet, sondern kommt ueber IND - das feuert bei jedem Zyklus ohne aktiven Timeout und publiziert Q_timeout mit. Nachgeschaltete Bausteine, die auf das Ende eines Timeouts reagieren muessen, werten dafuer IND mit Q_timeout==false aus, nicht ein zweites TIMEOUT-Event.</p>
]]></Attribute>
</FBType>
