<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="I_PosDeltaHighPrecRapidUpd" Comment="The &quot;Position Delta, High Precision Rapid Update&quot; Parameter Group is intended&#10;for applications where very high precision and very fast update rates are needed&#10;for position data. This PGN can provide delta position changes down to 1&#10;millimeter with a delta time period accurate to 5 milliseconds">
	<Identification Standard="NMEA 2000" Classification="PGN 129027" Function="Position Delta, High Precision Rapid Update" Description="Copyright (c) 2024 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_129026.html">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Moritz Ortmeier" Date="07.02.2025">
	</VersionInfo>
	<CompilerInfo packageName="isobus::tecu">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="IND" Type="Event" Comment="Indication from Resource - feuert bei jedem Zyklus ohne aktiven Timeout und publiziert dabei auch den Reset von Q_timeout auf false.">
				<With Var="QO"/>
				<With Var="timestamp_data"/>
				<With Var="SID"/>
				<With Var="TimeDelta"/>
				<With Var="LatitudeDelta"/>
				<With Var="STATUS"/>
				<With Var="Q_timeout"/>
				<With Var="LongitudeDelta"/>
			</Event>
			<Event Name="TIMEOUT" Type="Event" Comment="Feuert ausschliesslich beim tatsaechlichen Eintreten eines Timeouts (Entry-Trigger). Das Zuruecksetzen von Q_timeout auf false wird NICHT hier, sondern ueber IND gemeldet.">
				<With Var="timestamp_timeout"/>
				<With Var="STATUS"/>
				<With Var="Q_timeout"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="Q_timeout" Type="BOOL"/>
			<VarDeclaration Name="timestamp_timeout" Type="DINT"/>
			<VarDeclaration Name="timestamp_data" Type="DINT"/>
			<VarDeclaration Name="SID" Type="UINT" Comment="Sequence ID identifies the sequence this data is associated with so that the data can be synchronized with other vessel data for this same sequence being sent in another PGN." InitialValue="UINT#16#FFFF"/>
			<VarDeclaration Name="TimeDelta" Type="UINT" InitialValue="UINT#16#FFFF"/>
			<VarDeclaration Name="LatitudeDelta" Type="INT" InitialValue="INT#16#7FFF"/>
			<VarDeclaration Name="LongitudeDelta" Type="INT" InitialValue="INT#16#7FFF"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<p>The &quot;Position Delta, High Precision Rapid Update&quot; Parameter Group is intended for applications where very high precision and very fast update rates are needed for position data. This PGN can provide delta position changes down to 1 millimeter with a delta time period accurate to 5 milliseconds</p>

<p>&nbsp;</p>

<p><strong>TIMEOUT / IND Vertrag:</strong> TIMEOUT feuert ausschliesslich beim tatsaechlichen Eintreten eines Timeouts (Q_timeout wird true). Das Zuruecksetzen von Q_timeout auf false (Timeout vorbei) wird bewusst NICHT nochmal separat ueber TIMEOUT gemeldet, sondern kommt ueber IND - das feuert bei jedem Zyklus ohne aktiven Timeout und publiziert Q_timeout mit. Nachgeschaltete Bausteine, die auf das Ende eines Timeouts reagieren muessen, werten dafuer IND mit Q_timeout==false aus, nicht ein zweites TIMEOUT-Event.</p>
]]></Attribute>
</FBType>
