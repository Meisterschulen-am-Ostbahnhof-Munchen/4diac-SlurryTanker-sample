<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="I_RHS" Comment="Primary or Rear Hitch Status RHS">
	<Identification Standard="ISO 11783-7" Classification="PGN 65093" Function="Primary or Rear Hitch Status RHS" Description="Copyright (c) 2024 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;Message that provides the measurement of the current rear-hitch parameters.&#10;&#10;https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65093.html">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2024-07-09">
	</VersionInfo>
	<CompilerInfo packageName="isobus::tecu">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="IND" Type="Event" Comment="Indication from Resource - feuert bei jedem Zyklus ohne aktiven Timeout und publiziert dabei auch den Reset von Q_timeout auf false.">
				<With Var="QO"/>
				<With Var="timestamp_data"/>
				<With Var="STATUS"/>
				<With Var="Q_timeout"/>
				<With Var="REAR_HITCH_POSITION"/>
				<With Var="REAR_HITCH_WORK_INDICATION"/>
				<With Var="REAR_HITCH_POS_LIMIT_STATUS"/>
				<With Var="REAR_HITCH_NOMINAL_LOWER_LINK_FORCE"/>
				<With Var="REAR_HITCH_DRAFT"/>
				<With Var="REAR_HITCH_EXIT_REASON_CODE"/>
			</Event>
			<Event Name="TIMEOUT" Type="Event" Comment="Feuert ausschliesslich beim tatsaechlichen Eintreten eines Timeouts (Entry-Trigger). Das Zuruecksetzen von Q_timeout auf false wird NICHT hier, sondern ueber IND gemeldet.">
				<With Var="timestamp_timeout"/>
				<With Var="STATUS"/>
				<With Var="Q_timeout"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="Q_timeout" Type="BOOL"/>
			<VarDeclaration Name="timestamp_timeout" Type="DINT"/>
			<VarDeclaration Name="timestamp_data" Type="DINT"/>
			<VarDeclaration Name="REAR_HITCH_POSITION" Type="USINT" Comment="Rear Hitch Position (see Attributes for Details)" InitialValue="USINT#16#FF">
				<Attribute Name="SPN" Type="INT" Value="1873"/>
				<Attribute Name="SP_Name" Type="STRING" Value="'Rear Hitch Position'"/>
				<Attribute Name="SP_Position_In_PG" Type="STRING" Value="'1'"/>
				<Attribute Name="SP_Length" Type="INT" Value="8" Comment="8 bits"/>
				<Attribute Name="Scaling" Type="STRING" Value="'0.4 %/bit'"/>
				<Attribute Name="Offset" Type="INT" Value=""/>
				<Attribute Name="Link" Type="STRING" Value="'https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65093.html#spn-1873-rear-hitch-position'"/>
			</VarDeclaration>
			<VarDeclaration Name="REAR_HITCH_WORK_INDICATION" Type="BYTE" Comment="Rear Hitch In-work Indication" InitialValue="BYTE#16#FF">
				<Attribute Name="SPN" Type="INT" Value="1877"/>
				<Attribute Name="SP_Name" Type="STRING" Value="'Rear Hitch In-work Indication'"/>
				<Attribute Name="SP_Position_In_PG" Type="STRING" Value="'2.7'"/>
				<Attribute Name="SP_Length" Type="INT" Value="2" Comment="2 bits"/>
				<Attribute Name="Scaling" Type="STRING" Value="'4 states/2 bit'"/>
				<Attribute Name="Offset" Type="INT" Value=""/>
				<Attribute Name="Link" Type="STRING" Value="'https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65093.html#spn-1877-rear-hitch-in-work-indication'"/>
			</VarDeclaration>
			<VarDeclaration Name="REAR_HITCH_POS_LIMIT_STATUS" Type="BYTE" Comment="Rear Hitch Position Limit status" InitialValue="BYTE#16#FF">
				<Attribute Name="SPN" Type="INT" Value="5151"/>
				<Attribute Name="SP_Name" Type="STRING" Value="'Rear Hitch Position Limit status'"/>
				<Attribute Name="SP_Position_In_PG" Type="STRING" Value="'2.4'"/>
				<Attribute Name="SP_Length" Type="INT" Value="3" Comment="3 bits"/>
				<Attribute Name="Scaling" Type="STRING" Value="'8 states/3 bit'"/>
				<Attribute Name="Offset" Type="INT" Value=""/>
				<Attribute Name="Link" Type="STRING" Value="'https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65093.html#spn-5151-rear-hitch-position-limit-status'"/>
			</VarDeclaration>
			<VarDeclaration Name="REAR_HITCH_NOMINAL_LOWER_LINK_FORCE" Type="USINT" Comment="Rear Nominal Lower Link Force" InitialValue="USINT#16#FF">
				<Attribute Name="SPN" Type="INT" Value="1881"/>
				<Attribute Name="SP_Name" Type="STRING" Value="'Rear Nominal Lower Link Force'"/>
				<Attribute Name="SP_Position_In_PG" Type="STRING" Value="'3'"/>
				<Attribute Name="SP_Length" Type="INT" Value="8" Comment="8 bits"/>
				<Attribute Name="Scaling" Type="STRING" Value="'0.8 %/bit'"/>
				<Attribute Name="Offset" Type="INT" Value="-100"/>
				<Attribute Name="Link" Type="STRING" Value="'https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65093.html#spn-5151-rear-hitch-position-limit-status'"/>
			</VarDeclaration>
			<VarDeclaration Name="REAR_HITCH_DRAFT" Type="UINT" Comment="Rear Draft" InitialValue="UINT#16#FFFF">
				<Attribute Name="SPN" Type="INT" Value="1879"/>
				<Attribute Name="SP_Name" Type="STRING" Value="'Rear Draft'"/>
				<Attribute Name="SP_Position_In_PG" Type="STRING" Value="'4-5'"/>
				<Attribute Name="SP_Length" Type="INT" Value="16" Comment="16 bits"/>
				<Attribute Name="Scaling" Type="STRING" Value="'10 N/bit'"/>
				<Attribute Name="Offset" Type="DINT" Value="-320000"/>
				<Attribute Name="Link" Type="STRING" Value="'https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65093.html#spn-1879-rear-draft'"/>
			</VarDeclaration>
			<VarDeclaration Name="REAR_HITCH_EXIT_REASON_CODE" Type="BYTE" Comment="Rear hitch exit/reason code" InitialValue="BYTE#16#FF">
				<Attribute Name="SPN" Type="INT" Value="5819"/>
				<Attribute Name="SP_Name" Type="STRING" Value="'Rear hitch exit/reason code'"/>
				<Attribute Name="SP_Position_In_PG" Type="STRING" Value="'6.1'"/>
				<Attribute Name="SP_Length" Type="INT" Value="6" Comment="6 bits"/>
				<Attribute Name="Scaling" Type="STRING" Value="'64 states/6 bit'"/>
				<Attribute Name="Offset" Type="INT" Value=""/>
				<Attribute Name="Link" Type="STRING" Value="'https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65093.html#spn-5819-rear-hitch-exit-reason-code'"/>
			</VarDeclaration>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<p>Primary or Rear Hitch Status RHS</p>

<p>&nbsp;</p>

<p><strong>TIMEOUT / IND Vertrag:</strong> TIMEOUT feuert ausschliesslich beim tatsaechlichen Eintreten eines Timeouts (Q_timeout wird true). Das Zuruecksetzen von Q_timeout auf false (Timeout vorbei) wird bewusst NICHT nochmal separat ueber TIMEOUT gemeldet, sondern kommt ueber IND - das feuert bei jedem Zyklus ohne aktiven Timeout und publiziert Q_timeout mit. Nachgeschaltete Bausteine, die auf das Ende eines Timeouts reagieren muessen, werten dafuer IND mit Q_timeout==false aus, nicht ein zweites TIMEOUT-Event.</p>
]]></Attribute>
</FBType>
