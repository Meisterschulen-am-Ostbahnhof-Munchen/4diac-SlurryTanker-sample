<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="I_GBSD" Comment="Ground-based Speed and Distance GBSD">
	<Identification Standard="ISO 11783-7" Classification="PGN 65097" Function="Ground-based Speed and Distance GBSD" Description="Copyright (c) 2024 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;Message normally sent by the Tractor ECU on the implement bus on construction and agricultural implements providing to connected systems the current measured ground speed (also includes a free-running distance counter and an indication of the direction of travel).&#10;&#10;Accuracies of both wheel-based and ground-based sources can be speed-dependent and degrade at low speeds. Wheel-based information might not be updated at the 100 ms rate at low speeds.&#10;&#10;&#10;https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65097.html">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2024-07-09">
	</VersionInfo>
	<CompilerInfo packageName="isobus::tecu">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="IND" Type="Event" Comment="Indication from Resource - feuert bei jedem Zyklus ohne aktiven Timeout und publiziert dabei auch den Reset von Q_timeout auf false.">
				<With Var="QO"/>
				<With Var="timestamp_data"/>
				<With Var="GROUNDBASEDMACHINESPEED"/>
				<With Var="GROUNDBASEDMACHINEDISTANCE"/>
				<With Var="GROUNDBASEDMACHINEDIRECTION"/>
				<With Var="STATUS"/>
				<With Var="Q_timeout"/>
			</Event>
			<Event Name="TIMEOUT" Type="Event" Comment="Feuert ausschliesslich beim tatsaechlichen Eintreten eines Timeouts (Entry-Trigger). Das Zuruecksetzen von Q_timeout auf false wird NICHT hier, sondern ueber IND gemeldet.">
				<With Var="timestamp_timeout"/>
				<With Var="STATUS"/>
				<With Var="Q_timeout"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="Event Input Qualifier"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING"/>
			<VarDeclaration Name="Q_timeout" Type="BOOL"/>
			<VarDeclaration Name="timestamp_timeout" Type="DINT"/>
			<VarDeclaration Name="timestamp_data" Type="DINT"/>
			<VarDeclaration Name="GROUNDBASEDMACHINESPEED" Type="UINT" Comment="Ground-based machine speed (see Attributes for Details)" InitialValue="UINT#16#FFFF">
				<Attribute Name="SPN" Type="INT" Value="1859"/>
				<Attribute Name="SP_Name" Type="STRING" Value="'Ground-based machine speed'"/>
				<Attribute Name="SP_Position_In_PG" Type="STRING" Value="'1-2'"/>
				<Attribute Name="SP_Length" Type="INT" Value="16" Comment="16 bits"/>
				<Attribute Name="Scaling" Type="STRING" Value="'0.001 m/s per bit'"/>
				<Attribute Name="Offset" Type="INT" Value=""/>
				<Attribute Name="Link" Type="STRING" Value="'https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65097.html#spn-1859-ground-based-machine-speed'"/>
			</VarDeclaration>
			<VarDeclaration Name="GROUNDBASEDMACHINEDISTANCE" Type="UDINT" Comment="Ground-based machine distance (see Attributes for Details)" InitialValue="UDINT#16#FFFFFFFF">
				<Attribute Name="SPN" Type="INT" Value="1860"/>
				<Attribute Name="SP_Name" Type="STRING" Value="'Ground-based machine distance'"/>
				<Attribute Name="SP_Position_In_PG" Type="STRING" Value="'3-6'"/>
				<Attribute Name="SP_Length" Type="INT" Value="32" Comment="32 bits"/>
				<Attribute Name="Scaling" Type="STRING" Value="'0.001 m/bit'"/>
				<Attribute Name="Offset" Type="INT" Value=""/>
				<Attribute Name="Link" Type="STRING" Value="'https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65097.html#spn-1860-ground-based-machine-distance'"/>
			</VarDeclaration>
			<VarDeclaration Name="GROUNDBASEDMACHINEDIRECTION" Type="BYTE" Comment="Ground-based machine direction (see Attributes for Details)" InitialValue="BYTE#16#FF">
				<Attribute Name="SPN" Type="INT" Value="1861"/>
				<Attribute Name="SP_Name" Type="STRING" Value="'Ground-based machine direction'"/>
				<Attribute Name="SP_Position_In_PG" Type="STRING" Value="'8.1'"/>
				<Attribute Name="SP_Length" Type="INT" Value="2" Comment="2 bits"/>
				<Attribute Name="Scaling" Type="STRING" Value="'4 states/2 bit'"/>
				<Attribute Name="Offset" Type="INT" Value=""/>
				<Attribute Name="Link" Type="STRING" Value="'https://docs.ms-muc-docs.de/projects/isobus-other-docs/de/latest/PGN/PGN_65097.html#spn-1861-ground-based-machine-direction'"/>
			</VarDeclaration>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
	<Attribute Name="Documentation" Type="CDATA"><![CDATA[<p>Ground-based Speed and Distance GBSD</p>

<p>&nbsp;</p>

<p><strong>TIMEOUT / IND Vertrag:</strong> TIMEOUT feuert ausschliesslich beim tatsaechlichen Eintreten eines Timeouts (Q_timeout wird true). Das Zuruecksetzen von Q_timeout auf false (Timeout vorbei) wird bewusst NICHT nochmal separat ueber TIMEOUT gemeldet, sondern kommt ueber IND - das feuert bei jedem Zyklus ohne aktiven Timeout und publiziert Q_timeout mit. Nachgeschaltete Bausteine, die auf das Ende eines Timeouts reagieren muessen, werten dafuer IND mit Q_timeout==false aus, nicht ein zweites TIMEOUT-Event.</p>
]]></Attribute>
</FBType>
