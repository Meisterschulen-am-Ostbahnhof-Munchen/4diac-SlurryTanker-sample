			<ECState Name="sState_08" x="2400" y="7200">
				<ECAction Algorithm="State_07_X" Output="DO_S7.E1"/>
				<ECAction Algorithm="State_08_C" Output="STATE_NR.E1"/>
				<ECAction Algorithm="State_08_E" Output="DO_S8.E1"/>
				<ECAction Output="timeOut.START"/>
			</ECState>
			<ECState Name="sState_00" x="2400" y="8000">
				<ECAction Algorithm="State_08_X" Output="DO_S8.E1"/>
				<ECAction Algorithm="State_00_C" Output="STATE_NR.E1"/>
				<ECAction/>
				<ECAction/>
			</ECState>
			<ECState Name="sRESET" x="-2400" y="8000">
				<ECAction Output="timeOut.STOP"/>
				<ECAction Algorithm="State_01_X" Output="DO_S1.E1"/>
				<ECAction Algorithm="State_02_X" Output="DO_S2.E1"/>
				<ECAction Algorithm="State_03_X" Output="DO_S3.E1"/>
