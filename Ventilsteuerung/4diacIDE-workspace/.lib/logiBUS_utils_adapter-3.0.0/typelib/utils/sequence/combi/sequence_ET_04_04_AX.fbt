				<ECAction/>
			</ECState>
			<ECTransition Source="sState_01" Destination="sState_02" Condition="timeOut.TimeOut" x="2620" y="1993.33"/>
			<ECTransition Source="sState_02" Destination="sState_03" Condition="timeOut.TimeOut" x="2653.33" y="2806.67"/>
			<ECTransition Source="sState_03" Destination="sState_04" Condition="timeOut.TimeOut" x="2653.33" y="3606.67"/>
