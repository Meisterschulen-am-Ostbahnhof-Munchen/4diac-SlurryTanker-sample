<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="sequence_ET_04_loop_AX" Comment="Sequence with 4 Outputs looped, Transition by EVENT or TIME, with AX Adapter">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Moritz Ortmeier" Date="2026-01-07">
	</VersionInfo>
	<CompilerInfo packageName="logiBUS::utils::sequence::combi">
		<Import declaration="logiBUS::utils::sequence::const::sequence"/>
		<Import declaration="logiBUS::utils::sequence::const::sequence::NO_TIME"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="START_S1" Type="Event" Comment="jump from START to State_01">
				<With Var="DT_S1_S2"/>
				<With Var="DT_S2_S3"/>
				<With Var="DT_S3_S4"/>
				<With Var="DT_S4_S1"/>
			</Event>
			<Event Name="S1_S2" Type="Event" Comment="jump from State_01 to State_02">
			</Event>
			<Event Name="S2_S3" Type="Event" Comment="jump from State_02 to State_03">
			</Event>
			<Event Name="S3_S4" Type="Event" Comment="jump from State_03 to State_04">
			</Event>
			<Event Name="S4_S1" Type="Event" Comment="jump from State_04 to State_01">
			</Event>
			<Event Name="RESET" Type="Event" Comment="Reset from any State to START">
			</Event>
		</EventInputs>
		<InputVars>
			<VarDeclaration Name="DT_S1_S2" Type="TIME" Comment="State_01 to State_02 timed, set to NO_TIME to disable" InitialValue="NO_TIME"/>
			<VarDeclaration Name="DT_S2_S3" Type="TIME" Comment="State_02 to State_03 timed, set to NO_TIME to disable" InitialValue="NO_TIME"/>
			<VarDeclaration Name="DT_S3_S4" Type="TIME" Comment="State_03 to State_04 timed, set to NO_TIME to disable" InitialValue="NO_TIME"/>
			<VarDeclaration Name="DT_S4_S1" Type="TIME" Comment="State_04 to State_01 timed, set to NO_TIME to disable" InitialValue="NO_TIME"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="STATE_NR" Type="adapter::types::unidirectional::AS" Comment="State Number Adapter"/>
<AdapterDeclaration Name="DO_S1" Type="adapter::types::unidirectional::AX" Comment="Output if State_01 is active"/>
			<AdapterDeclaration Name="DO_S2" Type="adapter::types::unidirectional::AX" Comment="Output if State_02 is active"/>
			<AdapterDeclaration Name="DO_S3" Type="adapter::types::unidirectional::AX" Comment="Output if State_03 is active"/>
			<AdapterDeclaration Name="DO_S4" Type="adapter::types::unidirectional::AX" Comment="Output if State_04 is active "/>
			<AdapterDeclaration Name="timeOut" Type="iec61499::events::ATimeOut" Comment="timeOut Adapter"/>
		</Plugs>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="xSTART" Comment="Initial State" x="-800" y="800">
			</ECState>
			<ECState Name="sState_01" x="2400" y="800">
				<ECAction Output="timeOut.STOP"/>
				<ECAction Algorithm="State_04_X" Output="DO_S4.E1"/>
				<ECAction Algorithm="State_01_C" Output="STATE_NR.E1"/>
				<ECAction Algorithm="State_01_E" Output="DO_S1.E1"/>
				<ECAction Output="timeOut.START"/>
			</ECState>
			<ECState Name="sState_02" x="2400" y="1600">
				<ECAction Output="timeOut.STOP"/>
				<ECAction Algorithm="State_01_X" Output="DO_S1.E1"/>
				<ECAction Algorithm="State_02_C" Output="STATE_NR.E1"/>
				<ECAction Algorithm="State_02_E" Output="DO_S2.E1"/>
				<ECAction Output="timeOut.START"/>
			</ECState>
			<ECState Name="sState_03" x="2400" y="2400">
				<ECAction Output="timeOut.STOP"/>
				<ECAction Algorithm="State_02_X" Output="DO_S2.E1"/>
				<ECAction Algorithm="State_03_C" Output="STATE_NR.E1"/>
				<ECAction Algorithm="State_03_E" Output="DO_S3.E1"/>
				<ECAction Output="timeOut.START"/>
			</ECState>
			<ECState Name="sState_04" x="2400" y="3200">
				<ECAction Output="timeOut.STOP"/>
				<ECAction Algorithm="State_03_X" Output="DO_S3.E1"/>
				<ECAction Algorithm="State_04_C" Output="STATE_NR.E1"/>
				<ECAction Algorithm="State_04_E" Output="DO_S4.E1"/>
				<ECAction Output="timeOut.START"/>
			</ECState>
			<ECState Name="sRESET" x="-800" y="3200">
				<ECAction Output="timeOut.STOP"/>
				<ECAction Algorithm="State_01_X" Output="DO_S1.E1"/>
				<ECAction Algorithm="State_02_X" Output="DO_S2.E1"/>
				<ECAction Algorithm="State_03_X" Output="DO_S3.E1"/>
				<ECAction Algorithm="State_04_X" Output="DO_S4.E1"/>
				<ECAction Algorithm="State_00_C" Output="STATE_NR.E1"/>
			</ECState>
			<ECTransition Source="sState_01" Destination="sState_02" Condition="S1_S2" x="2400" y="1373.33"/>
			<ECTransition Source="sState_02" Destination="sState_03" Condition="S2_S3" x="2426.67" y="2173.33"/>
			<ECTransition Source="sState_03" Destination="sState_04" Condition="S3_S4" x="2406.67" y="2746.67"/>
			<ECTransition Source="sState_01" Destination="sState_02" Condition="timeOut.TimeOut" x="2646.67" y="1280"/>
			<ECTransition Source="sState_02" Destination="sState_03" Condition="timeOut.TimeOut" x="2633.33" y="2046.67"/>
			<ECTransition Source="sState_03" Destination="sState_04" Condition="timeOut.TimeOut" x="2626.67" y="2860"/>
			<ECTransition Source="xSTART" Destination="sState_01" Condition="START_S1" x="660" y="666.67"/>
			<ECTransition Source="sState_01" Destination="sRESET" Condition="RESET" x="-173.33" y="1286.67"/>
			<ECTransition Source="sState_04" Destination="sRESET" Condition="RESET" x="206.67" y="3066.67"/>
			<ECTransition Source="sState_02" Destination="sRESET" Condition="RESET" x="-126.67" y="1666.67"/>
			<ECTransition Source="sState_03" Destination="sRESET" Condition="RESET" x="-66.67" y="2420"/>
			<ECTransition Source="sState_04" Destination="sState_01" Condition="S4_S1" x="1613.33" y="1880"/>
			<ECTransition Source="sState_04" Destination="sState_01" Condition="timeOut.TimeOut" x="1766.67" y="2033.33"/>
			<ECTransition Source="sRESET" Destination="xSTART" Condition="1" x="-813.33" y="1560"/>
		</ECC>
		<Algorithm Name="State_00_C">
			<ST><![CDATA[ // State_00 Confirmation Step
STATE_NR.D1 := sequence::State_00;
]]></ST>
		</Algorithm>
		<Algorithm Name="State_01_C">
			<ST><![CDATA[ // State_01 Confirmation Step
STATE_NR.D1 := sequence::State_01;
timeOut.DT := DT_S1_S2;
]]></ST>
		</Algorithm>
		<Algorithm Name="State_02_C">
			<ST><![CDATA[ // State_02 Confirmation Step
STATE_NR.D1 := sequence::State_02;
timeOut.DT := DT_S2_S3;
]]></ST>
		</Algorithm>
		<Algorithm Name="State_03_C">
			<ST><![CDATA[ // State_03 Confirmation Step
STATE_NR.D1 := sequence::State_03;
timeOut.DT := DT_S3_S4;
]]></ST>
		</Algorithm>
		<Algorithm Name="State_04_C">
			<ST><![CDATA[ // State_04 Confirmation Step
STATE_NR.D1 := sequence::State_04;
timeOut.DT := DT_S4_S1;
]]></ST>
		</Algorithm>
		<Algorithm Name="State_01_E">
			<ST><![CDATA[ // State_01 Entry Step
DO_S1.D1 := BOOL#TRUE; // ON
]]></ST>
		</Algorithm>
		<Algorithm Name="State_01_X">
			<ST><![CDATA[ // State_01 Exit Step
DO_S1.D1 := BOOL#FALSE;
]]></ST>
		</Algorithm>
		<Algorithm Name="State_02_E">
			<ST><![CDATA[ // State_02 Entry Step
DO_S2.D1 := BOOL#TRUE; // ON
]]></ST>
		</Algorithm>
		<Algorithm Name="State_02_X">
			<ST><![CDATA[ // State_02 Exit Step
DO_S2.D1 := BOOL#FALSE;
]]></ST>
		</Algorithm>
		<Algorithm Name="State_03_E">
			<ST><![CDATA[ // State_03 Entry Step
DO_S3.D1 := BOOL#TRUE; // ON
]]></ST>
		</Algorithm>
		<Algorithm Name="State_03_X">
			<ST><![CDATA[ // State_03 Exit Step
DO_S3.D1 := BOOL#FALSE;
]]></ST>
		</Algorithm>
		<Algorithm Name="State_04_E">
			<ST><![CDATA[ // State_04 Entry Step
DO_S4.D1 := BOOL#TRUE; // ON
]]></ST>
		</Algorithm>
		<Algorithm Name="State_04_X">
			<ST><![CDATA[ // State_04 Exit Step
DO_S4.D1 := BOOL#FALSE;
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
