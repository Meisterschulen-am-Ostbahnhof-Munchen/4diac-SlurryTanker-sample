<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="PositionMarkerFSA" Comment="AR adapter wrapper around PositionMarkerFS — accepts the Sollwert REAL value via&#10;AR adapter socket instead of a plain REQ/rValue pair">
	<Identification Standard="ISO 11783-6" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;Same wrapper shape as Q_NumericValue_PHYSA around Q_NumericValue_PHYS: the AR adapter socket&apos;s rPhys value drives the internally-owned PositionMarkerFS instance&apos;s REQ/rValue directly. xOver/xUnder are re-exposed as AX adapter plugs, exactly like Q_NumericValue_PHYSA does.">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-05" Remarks="Add xScale flag, passed through to the internal PositionMarkerFS">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-05" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="isobus::UT::Q">
		<Import declaration="isobus::utils::childposition::PositionMarker_S"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="stObj"/>
				<With Var="xScale"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
			<Event Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
				<With Var="STATUS"/>
				<With Var="s16result"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="stObj" Type="isobus::utils::childposition::PositionMarker_S" Comment="Marker object pool properties (child/parent IDs, travel bounds, center offset), snapshotted at INIT"/>
			<VarDeclaration Name="xScale" Type="BOOL" Comment="FALSE (default) = bypass. TRUE = scale by the DM/SKM factor. Passed straight through to the internal PositionMarkerFS instance." InitialValue="FALSE"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING" Comment="Service Status - passthrough from the internal PositionMarkerFS"/>
			<VarDeclaration Name="s16result" Type="INT" Comment="retval - passthrough from the internal PositionMarkerFS"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="xOver" Type="adapter::types::unidirectional::AX" Comment="rValue (after adding stObj.r32Center) exceeded stObj.r32MaxPos and was clamped" x="4000" y="1300"/>
			<AdapterDeclaration Name="xUnder" Type="adapter::types::unidirectional::AX" Comment="rValue (after adding stObj.r32Center) fell below stObj.r32MinPos and was clamped" x="4000" y="1800"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="rPhys" Type="adapter::types::unidirectional::AR" Comment="Physical REAL value input" x="-1400" y="1000"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="Inner" Type="isobus::UT::Q::PositionMarkerFS" x="533.33" y="420">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="Inner.INIT" dx1="1306.67"/>
			<Connection Source="rPhys.E1" Destination="Inner.REQ" dx1="320"/>
			<Connection Source="Inner.INITO" Destination="INITO" dx1="1506.67"/>
			<Connection Source="Inner.CNF" Destination="CNF" dx1="1760"/>
			<Connection Source="Inner.CNF" Destination="xOver.E1" dx1="1146.67"/>
			<Connection Source="Inner.CNF" Destination="xUnder.E1" dx1="1146.67"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="stObj" Destination="Inner.stObj" dx1="973.33"/>
			<Connection Source="xScale" Destination="Inner.xScale" dx1="973.33"/>
			<Connection Source="rPhys.D1" Destination="Inner.rValue" dx1="1120"/>
			<Connection Source="Inner.STATUS" Destination="STATUS" dx1="2000"/>
			<Connection Source="Inner.s16result" Destination="s16result" dx1="2573.33"/>
			<Connection Source="Inner.xOver" Destination="xOver.D1" dx1="2000"/>
			<Connection Source="Inner.xUnder" Destination="xUnder.D1" dx1="913.33"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
