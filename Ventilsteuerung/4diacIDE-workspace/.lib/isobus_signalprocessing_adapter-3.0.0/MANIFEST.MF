    <Required SymbolicName="isobus_signalprocessing" Version="3.0.0"/>
    <Required SymbolicName="isobus_UT" Version="3.1.1"/>
    <Required SymbolicName="logiBUS_signalprocessing" Version="3.0.0"/>
