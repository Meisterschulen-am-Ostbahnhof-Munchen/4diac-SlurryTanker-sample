<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="DiagSetDTC" Comment="Activate or deactivate a diagnostic trouble code (DTC) in the DM1 message">
	<Identification Standard="61499-2" Description="Calls iso_BaseDiagSetDM1DTC() of the CCI ISOBUS driver (ISO 11783-12). \n&#10;The driver sends DM1 once per second while a DTC is active, keeps the occurrence count \n&#10;and handles DM2 (previously active DTCs) and DM3 (clear) by itself. \n&#10;Every activation of an inactive DTC increases the occurrence count. \n&#10;s16CfHandle is the handle of an own (internal) CF, e.g. sNetEv.s16Handle of NmGetCfInfo with member thisMember. \n&#10;Requires ISO_DIAG_ENABLE_DM1 in the firmware, otherwise s16Status is E_CONFIG.">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-11-17" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="isobus::pgn::diag">
		<Import declaration="isobus::pgn::HANDLE::UNVALID"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
			</Event>
			<Event Name="REQ" Type="Event" Comment="Set the DTC (activate or deactivate)">
				<With Var="s16CfHandle"/>
				<With Var="u32SPN"/>
				<With Var="u8FMI"/>
				<With Var="bActive"/>
				<With Var="u8NumberOfDM1Messages"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
			<Event Name="CNF" Type="Event" Comment="Confirmation">
				<With Var="s16Status"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="s16CfHandle" Type="INT" Comment="Handle of the own (internal) CF" InitialValue="UNVALID"/>
			<VarDeclaration Name="u32SPN" Type="UDINT" Comment="Suspect Parameter Number of the trouble code (19 bit)"/>
			<VarDeclaration Name="u8FMI" Type="USINT" Comment="Failure Mode Identifier, see isobus::pgn::diag::FMI"/>
			<VarDeclaration Name="bActive" Type="BOOL" Comment="TRUE = activate, FALSE = deactivate the DTC"/>
			<VarDeclaration Name="u8NumberOfDM1Messages" Type="USINT" Comment="0 or 255: active until deactivated; 1..254: deactivate automatically after this number of DM1 messages (seconds)"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="s16Status" Type="INT" Comment="Return value of iso_BaseDiagSetDM1DTC(): 0 = OK, &lt; 0 = error"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
