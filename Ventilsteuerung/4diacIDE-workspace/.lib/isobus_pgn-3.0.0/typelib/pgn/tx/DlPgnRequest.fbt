<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="DlPgnRequest" Comment="Send a request (PGN 59904) for a PGN">
	<Identification Standard="61499-2" Description="Calls iso_DlPgnRequest() of the CCI ISOBUS driver (data link layer, ISO 11783-3). \n&#10;No Rx PGN needs to be installed. The answer is received by an installed Rx PGN, if any. \n&#10;Sender is NmDestin.s16OwnCfHnd, receiver is NmDestin.s16Handle (HANDLE::GLOBAL for a global request). \n&#10;For PDU1 PGNs the lower byte of u32Pgn must be zero.">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-11-17" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="isobus::pgn::tx">
		<Import declaration="isobus::pgn::ISONETEVENT_T"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
			</Event>
			<Event Name="REQ" Type="Event" Comment="Send the request">
				<With Var="u32Pgn"/>
				<With Var="NmDestin"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
			<Event Name="CNF" Type="Event" Comment="Request sent (see s16Status)">
				<With Var="s16Status"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="u32Pgn" Type="UDINT" Comment="Requested PGN - Range: 0 - 0x3FFFF"/>
			<VarDeclaration Name="NmDestin" Type="isobus::pgn::ISONETEVENT_T" Comment="Sender (s16OwnCfHnd) and receiver (s16Handle)"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="s16Status" Type="INT" Comment="Return value of iso_DlPgnRequest(): 0 = OK"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
