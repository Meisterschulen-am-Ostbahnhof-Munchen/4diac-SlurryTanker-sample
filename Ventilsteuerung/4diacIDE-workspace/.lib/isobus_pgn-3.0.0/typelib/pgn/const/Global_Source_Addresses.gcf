	<OriginalSource><![CDATA[PACKAGE isobus::pgn::const;

// Global source addresses (all industry groups)
GLOBALCONSTANTS Global_Source_Addresses
	VAR_GLOBAL CONSTANT
		SA_ENGINE_1 : BYTE := 0; // Source Address: Engine #1 - The #1 on the Engine CA is to identify that this is the first PA
		SA_ENGINE_2 : BYTE := 1; // Source Address: Engine #2 - The #2 on the Engine CA is to identify that this is the second PA
		SA_TURBOCHARGER : BYTE := 2; // Source Address: Turbocharger - Turbocharger used on the engine. May only be used for the NAME
