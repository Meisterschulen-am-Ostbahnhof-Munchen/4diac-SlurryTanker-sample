		SA_CLUTCH_CONVERTER_UNIT : BYTE := 67; // Source Address: Clutch/Converter Unit - Control of either the clutch and/or converter
		SA_AUXILIARY_HEATER_1 : BYTE := 68; // Source Address: Auxiliary Heater #1 - The first Auxiliary Heater - may only be used for the
