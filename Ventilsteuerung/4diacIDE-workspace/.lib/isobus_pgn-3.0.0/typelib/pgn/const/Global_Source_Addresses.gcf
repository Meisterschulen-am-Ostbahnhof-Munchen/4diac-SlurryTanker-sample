		SA_BRAKES_DRIVE_AXLE_2 : BYTE := 14; // Source Address: Brakes - Drive Axle #2 - The second PA available for use for the function
		SA_RETARDER_ENGINE : BYTE := 15; // Source Address: Retarder - Engine - Engine Compression Braking
		SA_RETARDER_DRIVELINE : BYTE := 16; // Source Address: Retarder - Driveline
		SA_CRUISE_CONTROL : BYTE := 17; // Source Address: Cruise Control - Speed-based control
		SA_FUEL_SYSTEM : BYTE := 18; // Source Address: Fuel System
