		SA_EXHAUST_EMISSION_CONTROLLER : BYTE := 61; // Source Address: Exhaust Emission Controller
		SA_VEHICLE_DYNAMIC_STABILITY_CONTROLLER : BYTE := 62; // Source Address: Vehicle Dynamic Stability Controller
		SA_OIL_SENSOR : BYTE := 63; // Source Address: Oil Sensor
