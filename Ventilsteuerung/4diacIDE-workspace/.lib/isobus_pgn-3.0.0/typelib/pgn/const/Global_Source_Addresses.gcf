		SA_ALTERNATOR_ELECTRICAL_CHARGING_SYSTEM : BYTE := 26; // Source Address: Alternator/Electrical Charging System - Vehicle's primary charging controller
		SA_AERODYNAMIC_CONTROL : BYTE := 27; // Source Address: Aerodynamic Control
		SA_VEHICLE_NAVIGATION : BYTE := 28; // Source Address: Vehicle Navigation
		SA_VEHICLE_SECURITY : BYTE := 29; // Source Address: Vehicle Security
		SA_ELECTRICAL_SYSTEM : BYTE := 30; // Source Address: Electrical System - This may include Load Centers, Fuseboxes, & Power
		SA_STARTER_SYSTEM : BYTE := 31; // Source Address: Starter System
		SA_TRACTOR_TRAILER_BRIDGE_1 : BYTE := 32; // Source Address: Tractor-Trailer Bridge #1 - The first Tractor mounted bridge leading to
		SA_BODY_CONTROLLER : BYTE := 33; // Source Address: Body Controller
		SA_AUXILIARY_VALVE_CONTROL_OR_ENGINE_AIR_SYSTEM_VALVE_CONTROL : BYTE := 34; // Source Address: Auxiliary Valve Control or Engine Air System Valve Control - This should be
		SA_HITCH_CONTROL : BYTE := 35; // Source Address: Hitch Control - Straight truck hitch (NOT Ag hitch – it is in IG 2)
		SA_POWER_TAKEOFF_FRONT_OR_SECONDARY : BYTE := 36; // Source Address: Power TakeOff (Front or Secondary)
		SA_OFF_VEHICLE_GATEWAY : BYTE := 37; // Source Address: Off Vehicle Gateway - General gateway controller (off board to on board) that
		SA_VIRTUAL_TERMINAL_IN_CAB : BYTE := 38; // Source Address: Virtual Terminal (in cab)
		SA_MANAGEMENT_COMPUTER_1 : BYTE := 39; // Source Address: Management Computer #1 - The first Management Computer - may only be used for
		SA_CAB_DISPLAY_1 : BYTE := 40; // Source Address: Cab Display #1 - The first Cab Display - may only be used for the NAME
