		SA_SUSPENSION_DRIVE_AXLE_2 : BYTE := 22; // Source Address: Suspension - Drive Axle #2 - The second PA available for use for the function
		SA_INSTRUMENT_CLUSTER_1 : BYTE := 23; // Source Address: Instrument Cluster #1 - The first instrument cluster - may only be used for
