		SA_POWER_TAKEOFF_MAIN_OR_REAR : BYTE := 7; // Source Address: Power TakeOff - (Main or Rear)
		SA_AXLE_STEERING : BYTE := 8; // Source Address: Axle - Steering
		SA_AXLE_DRIVE_1 : BYTE := 9; // Source Address: Axle - Drive #1 - The first drive axle - may only be used for the NAME
		SA_AXLE_DRIVE_2 : BYTE := 10; // Source Address: Axle - Drive #2 - The second PA available for use for the function, Axle
