		SA_SUSPENSION_SYSTEM_CONTROLLER_1 : BYTE := 47; // Source Address: Suspension - System Controller #1 - The first Suspension - System Controller
		SA_PNEUMATIC_SYSTEM_CONTROLLER : BYTE := 48; // Source Address: Pneumatic - System Controller
