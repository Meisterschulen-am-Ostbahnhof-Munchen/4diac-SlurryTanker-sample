<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ATM_CLIENT_1_0" Comment="Send a TIME from an ATM adapter as a remote OPC-UA CALL_METHOD argument via&#10;CLIENT_1_0, buffered with a D_FF">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-23" Remarks="initial implementation - analog zu AR_CLIENT_1_0/AX_CLIENT_1_0, TIME statt REAL/BOOL (fehlender Client-FB fuer Remote-CALL_METHOD eines TIME-Wertes). Vorsorglich angelegt (Franz: 'die bauen wir jetzt, ich habe keinen Bock dauernd neue Runtimes zu machen'), noch kein aktueller Aufrufer.">
	</VersionInfo>
	<CompilerInfo packageName="adapter::net">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Initialization">
				<With Var="QI"/>
				<With Var="ID"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="CNF" Type="Event" Comment="Data was sent">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="ID" Type="WSTRING"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL"/>
			<VarDeclaration Name="STATUS" Type="WSTRING"/>
		</OutputVars>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::ATM" Comment="TIME to send" x="-3800" y="900"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="E_D_FF_ANY" Type="iec61499::events::E_D_FF_ANY" x="-2700" y="900">
		</FB>
		<FB Name="F_MOVE" Type="iec61131::selection::F_MOVE" x="-1600" y="900">
			<Attribute Name="DataType" Value="TIME"/>
		</FB>
		<FB Name="CLIENT_1_0" Type="iec61499::net::CLIENT_1_0" x="-300" y="0">
		</FB>
		<EventConnections>
			<Connection Source="CLIENT_1_0.INITO" Destination="INITO" dx1="873.33"/>
			<Connection Source="CLIENT_1_0.CNF" Destination="CNF" dx1="1280"/>
			<Connection Source="IN.E1" Destination="E_D_FF_ANY.CLK"/>
			<Connection Source="E_D_FF_ANY.EO" Destination="F_MOVE.REQ"/>
			<Connection Source="F_MOVE.CNF" Destination="CLIENT_1_0.REQ" dx1="353.33"/>
			<Connection Source="INIT" Destination="CLIENT_1_0.INIT" dx1="4520"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="CLIENT_1_0.QO" Destination="QO" dx1="1540"/>
			<Connection Source="CLIENT_1_0.STATUS" Destination="STATUS" dx1="1713.33"/>
			<Connection Source="IN.D1" Destination="E_D_FF_ANY.D"/>
			<Connection Source="E_D_FF_ANY.Q" Destination="F_MOVE.IN"/>
			<Connection Source="F_MOVE.OUT" Destination="CLIENT_1_0.SD_1" dx1="540"/>
			<Connection Source="QI" Destination="CLIENT_1_0.QI" dx1="4160"/>
			<Connection Source="ID" Destination="CLIENT_1_0.ID" dx1="3846.67"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
