<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AR_SERVER_0_1" Comment="Receive a REAL as a remote OPC-UA CALL_METHOD argument via SERVER_0_1 (pairs&#10;with CLIENT_1_0/AR_CLIENT_1_0), exposed as an AR adapter">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-23" Remarks="initial implementation - Empfangs-Gegenstueck zu AR_CLIENT_1_0. Verifiziert gegen die echte 4diac-IDE-Typelib (net-3.0.0): CLIENT_1_0 ('Connect to a SERVER_0_1 Block') pairt mit SERVER_0_1, NICHT SERVER_1_0 (das waere umgekehrt: Server sendet 1 Wert in der Antwort, empfaengt 0 im Request). SERVER_0_1.IND liefert RD_1 (ANY) - RSP wird sofort auf IND zurueckverdrahtet (SERVER_0_RSP_LATENZ-Bug, siehe Ventilsteuerung/OPC_UA_VERNETZUNG.md Punkt 12, 4s Server-Lock sonst).">
	</VersionInfo>
	<CompilerInfo packageName="adapter::net">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Initialization">
				<With Var="QI"/>
				<With Var="ID"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="ID" Type="WSTRING"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL"/>
			<VarDeclaration Name="STATUS" Type="WSTRING"/>
		</OutputVars>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::AR" Comment="Empfangener REAL-Wert bei jedem Methodenaufruf" x="2500" y="500"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<FB Name="SERVER_0_1" Type="iec61499::net::SERVER_0_1" x="-300" y="0">
		</FB>
		<FB Name="F_MOVE" Type="iec61131::selection::F_MOVE" x="1400" y="500">
			<Attribute Name="DataType" Value="REAL"/>
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="SERVER_0_1.INIT" dx1="80"/>
			<Connection Source="SERVER_0_1.INITO" Destination="INITO" dx1="873.33"/>
			<Connection Source="SERVER_0_1.IND" Destination="SERVER_0_1.RSP" dx1="80" dx2="80" dy="160"/>
			<Connection Source="SERVER_0_1.IND" Destination="F_MOVE.REQ" dx1="633.33"/>
			<Connection Source="F_MOVE.CNF" Destination="OUT.E1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="SERVER_0_1.QI" dx1="4160"/>
			<Connection Source="ID" Destination="SERVER_0_1.ID" dx1="3846.67"/>
			<Connection Source="SERVER_0_1.QO" Destination="QO" dx1="1540"/>
			<Connection Source="SERVER_0_1.STATUS" Destination="STATUS" dx1="1713.33"/>
			<Connection Source="SERVER_0_1.RD_1" Destination="F_MOVE.IN" dx1="373.33"/>
			<Connection Source="F_MOVE.OUT" Destination="OUT.D1"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
