<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AR_CLIENT_1_0_UNGATED" Comment="Send a REAL from an AR adapter as a remote OPC-UA write via CLIENT_1_0 on EVERY&#10;IN.E1 trigger, unconditionally (no E_D_FF_ANY change-filter, unlike&#10;AR_CLIENT_1_0)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH&#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-25" Remarks="initial implementation - AR_CLIENT_1_0-Variante OHNE E_D_FF_ANY-Value-Filter, fuer CALL_METHOD-Aufrufer, die JEDES echte Trigger-Event senden muessen, unabhaengig davon ob sich der Wert seit dem letzten Senden geaendert hat (bestaetigter Review-Fund auf PR #267: NumericValue_TO_CLIENT_1_0_OPC.SUB nutzte bisher AR_CLIENT_1_0, dessen interner E_D_FF_ANY einen erneuten VT/Web-Commit desselben Werts stillschweigend verschluckt - der eingegebene Wert war schon der zuletzt gesendete, die CALL_METHOD blieb aus. Hier entfaellt der Filter: IN.E1 loest F_MOVE/CLIENT_1_0.REQ direkt und immer aus. Bewusst als eigener Typ (nicht AR_CLIENT_1_0 selbst geaendert), weil AR_CLIENT_1_0's Change-Filter fuer andere, kuenftige Send-on-Change-Aufrufer weiterhin richtig/gewuenscht ist.">
	</VersionInfo>
	<CompilerInfo packageName="adapter::net">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Initialization">
				<With Var="QI"/>
				<With Var="ID"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
			<Event Name="CNF" Type="Event" Comment="Data was sent">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="ID" Type="WSTRING"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL"/>
			<VarDeclaration Name="STATUS" Type="WSTRING"/>
		</OutputVars>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::AR" Comment="REAL to send, on every IN.E1 event" x="-3800" y="900"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="F_MOVE" Type="iec61131::selection::F_MOVE" x="-1600" y="900">
			<Attribute Name="DataType" Value="REAL"/>
		</FB>
		<FB Name="CLIENT_1_0" Type="iec61499::net::CLIENT_1_0" x="-300" y="0">
		</FB>
		<EventConnections>
			<Connection Source="CLIENT_1_0.INITO" Destination="INITO" dx1="873.33"/>
			<Connection Source="CLIENT_1_0.CNF" Destination="CNF" dx1="1280"/>
			<Connection Source="IN.E1" Destination="F_MOVE.REQ"/>
			<Connection Source="F_MOVE.CNF" Destination="CLIENT_1_0.REQ" dx1="353.33"/>
			<Connection Source="INIT" Destination="CLIENT_1_0.INIT" dx1="4520"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="CLIENT_1_0.QO" Destination="QO" dx1="1540"/>
			<Connection Source="CLIENT_1_0.STATUS" Destination="STATUS" dx1="1713.33"/>
			<Connection Source="IN.D1" Destination="F_MOVE.IN"/>
			<Connection Source="F_MOVE.OUT" Destination="CLIENT_1_0.SD_1" dx1="540"/>
			<Connection Source="QI" Destination="CLIENT_1_0.QI" dx1="4160"/>
			<Connection Source="ID" Destination="CLIENT_1_0.ID" dx1="3846.67"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
