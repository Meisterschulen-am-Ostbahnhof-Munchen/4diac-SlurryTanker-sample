<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AE_CLIENT_0" Comment="Trigger a remote OPC-UA method call via CLIENT_0, driven by an AE adapter Socket&#10;(1 Event)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-03" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="adapter::net">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Initialization">
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
			<Event Name="CNF" Type="Event" Comment="QO/STATUS updated">
				<With Var="QO"/>
				<With Var="STATUS"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="ID" Type="WSTRING"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="QO von CLIENT_0_1"/>
			<VarDeclaration Name="STATUS" Type="WSTRING" Comment="STATUS von CLIENT_0_1"/>
		</OutputVars>
		<Sockets>
			<AdapterDeclaration Name="TRIGGER" Type="adapter::types::unidirectional::AE" Comment="Trigger" x="-1100" y="-200"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="CLIENT_0_1" Type="iec61499::net::CLIENT_0" x="-100" y="-200">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="CLIENT_0_1.INIT"/>
			<Connection Source="CLIENT_0_1.INITO" Destination="INITO"/>
			<Connection Source="TRIGGER.E1" Destination="CLIENT_0_1.REQ" dx1="340"/>
			<Connection Source="CLIENT_0_1.CNF" Destination="CNF"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="CLIENT_0_1.QI" dx1="1000"/>
			<Connection Source="ID" Destination="CLIENT_0_1.ID" dx1="846.67"/>
			<Connection Source="CLIENT_0_1.QO" Destination="QO"/>
			<Connection Source="CLIENT_0_1.STATUS" Destination="STATUS"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
