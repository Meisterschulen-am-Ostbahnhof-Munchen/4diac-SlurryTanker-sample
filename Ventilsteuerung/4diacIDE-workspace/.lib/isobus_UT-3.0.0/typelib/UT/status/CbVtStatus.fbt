<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="CbVtStatus" Comment="This function is called in case of every page change - you can do e. g.&#10;initialisations ...">
	<Identification Standard="ISO 11783-6" Description="Copyright (c) 2022 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0  &#10;   &#10;   &#10;&lt;p&gt;This function is called in case of every page change - you can do e. g. initialisations ...&lt;/p&gt; &#10; &#10;">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.2" Author="Franz Höpfinger" Date="2026-09-05" Remarks="Populate SCALING-TEST status outputs">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.1" Author="Franz Höpfinger" Date="2026-09-05" Remarks="Added SCALING-TEST status outputs (wSKM_Scal, w_DMScal, u8SKM_Number, qScalingTestEnabled)">
	</VersionInfo>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2022-07-20">
	</VersionInfo>
	<CompilerInfo packageName="isobus::UT::status">
		<Import declaration="isobus::UT::Q::const::IDs::ID_NULL"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="STATUS"/>
			</Event>
			<Event Name="IND" Type="Event" Comment="Indication from Resource">
				<With Var="STATUS"/>
				<With Var="wPage"/>
				<With Var="qWsActive"/>
				<With Var="u8Instance"/>
				<With Var="wSKM_Scal"/>
				<With Var="w_DMScal"/>
				<With Var="u8SKM_Number"/>
				<With Var="qScalingTestEnabled"/>
			</Event>
		</EventOutputs>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING" Comment="Service Status"/>
			<VarDeclaration Name="u8Instance" Type="USINT" Comment="Identifier of the client instance"/>
			<VarDeclaration Name="qWsActive" Type="BOOL" Comment="true, if the working set is active (displayed on screen) "/>
			<VarDeclaration Name="wPage" Type="UINT" Comment="Contains the object ID of the open/last mask, or NULL object ID if unknown (ID_NULL = 0xFFFF)" InitialValue="ID_NULL"/>
			<VarDeclaration Name="wSKM_Scal" Type="UINT" Comment="Softkey Mask scaling factor (PoolSoftKeyMaskScalFaktor), unit 1/10000 (10000 = 100%) - possibly overridden by SCALING-TEST"/>
			<VarDeclaration Name="w_DMScal" Type="UINT" Comment="Data Mask scaling factor (PoolDataMaskScalFaktor), unit 1/10000 (10000 = 100%) - possibly overridden by SCALING-TEST"/>
			<VarDeclaration Name="u8SKM_Number" Type="USINT" Comment="Number of physical softkeys (VT_PHYSICALSOFTKEYS/sknu), valid range 6..11 - possibly overridden by SCALING-TEST"/>
			<VarDeclaration Name="qScalingTestEnabled" Type="BOOL" Comment="true if the SCALING-TEST override ([ScalingTest] enable=1 in settings.ini) is active"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
