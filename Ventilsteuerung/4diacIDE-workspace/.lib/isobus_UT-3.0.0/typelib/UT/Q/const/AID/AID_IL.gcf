<?xml version="1.0" encoding="UTF-8"?>
<GlobalConstants Name="AID_IL" Comment="Input list object attribute ids">
	<Identification Standard="61499-1" Description="Copyright (c) 2023 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-06-20">
	</VersionInfo>
	<CompilerInfo packageName="isobus::UT::Q::const::AID">
	</CompilerInfo>
	<GlobalConstants>
		<VarDeclaration Name="WIDTH" Type="USINT" Comment="1: AID_IL_WIDTH - Width in pixels." InitialValue="USINT#1"/>
		<VarDeclaration Name="HEIGHT" Type="USINT" Comment="2: AID_IL_HEIGHT - Height in pixels." InitialValue="USINT#2"/>
		<VarDeclaration Name="VARIABLE_REF" Type="USINT" Comment="3: AID_IL_VARIABLE_REF - Object ID of a Number Variable object." InitialValue="USINT#3"/>
		<VarDeclaration Name="VALUE" Type="USINT" Comment="4: AID_IL_VALUE - [4] Read-only for Change Attribute (ISO 11783-6). Selected list index (0-254, 255=none). Query via Get Attribute Value (F.58); update via Change Numeric Value (F.22)." InitialValue="USINT#4"/>
		<VarDeclaration Name="OPTIONS" Type="USINT" Comment="5: AID_IL_OPTIONS - [5] Read-only for Change Attribute (ISO 11783-6). Bit 0 = Enabled, Bit 1 = Real time editing. Query via Get Attribute Value (F.58); manage via Enable/Disable Object (F.4) or Select Input Object (F.6)." InitialValue="USINT#5"/>
	</GlobalConstants>
	<OriginalSource><![CDATA[PACKAGE isobus::UT::Q::const::AID;

// input list object attribute ids
GLOBALCONSTANTS AID_IL
	VAR_GLOBAL CONSTANT
		WIDTH : USINT := USINT#1; // 1: AID_IL_WIDTH - Width in pixels.
		HEIGHT : USINT := USINT#2; // 2: AID_IL_HEIGHT - Height in pixels.
		VARIABLE_REF : USINT := USINT#3; // 3: AID_IL_VARIABLE_REF - Object ID of a Number Variable object.
		VALUE : USINT := USINT#4; // 4: AID_IL_VALUE - [4] Read-only for Change Attribute (ISO 11783-6). Selected list index (0-254, 255=none). Query via Get Attribute Value (F.58); update via Change Numeric Value (F.22).
		OPTIONS : USINT := USINT#5; // 5: AID_IL_OPTIONS - [5] Read-only for Change Attribute (ISO 11783-6). Bit 0 = Enabled, Bit 1 = Real time editing. Query via Get Attribute Value (F.58); manage via Enable/Disable Object (F.4) or Select Input Object (F.6).
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</GlobalConstants>
