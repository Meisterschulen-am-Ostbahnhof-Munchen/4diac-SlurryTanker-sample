<GlobalConstants Name="AID_WS" Comment="Working set object attribute ids (all read-only)">
	<Identification Standard="61499-1" Description="Copyright (c) 2023 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-06-20">
	</VersionInfo>
	<CompilerInfo packageName="isobus::UT::Q::const::AID">
	</CompilerInfo>
	<GlobalConstants>
		<VarDeclaration Name="BACKGROUND_COLOUR" Type="USINT" Comment="1: AID_WS_BACKGROUND_COLOUR (read-only) - Background colour index." InitialValue="USINT#1"/>
		<VarDeclaration Name="SELECTABLE" Type="USINT" Comment="2: AID_WS_SELECTABLE (read-only) - 0 = FALSE, 1 = TRUE. Indicates whether or not this Working Set can be" InitialValue="USINT#2"/>
		<VarDeclaration Name="ACTIVE_MASK" Type="USINT" Comment="3: AID_WS_ACTIVE_MASK (read-only) - The Object ID of the Data or Alarm Mask to display whenever the Working Set is active. Query via Get Attribute Value (F.58); modify via Change Active Mask (F.34)." InitialValue="USINT#3"/>
	</GlobalConstants>
	<OriginalSource><![CDATA[PACKAGE isobus::UT::Q::const::AID;

// working set object attribute ids
GLOBALCONSTANTS AID_WS
	VAR_GLOBAL CONSTANT
		BACKGROUND_COLOUR : USINT := USINT#1; // 1: AID_WS_BACKGROUND_COLOUR (read-only) - Background colour index.
		SELECTABLE : USINT := USINT#2; // 2: AID_WS_SELECTABLE (read-only) - 0 = FALSE, 1 = TRUE. Indicates whether or not this Working Set can be
		                               // selected by the operator.
		ACTIVE_MASK : USINT := USINT#3; // 3: AID_WS_ACTIVE_MASK (read-only) - The Object ID of the Data or Alarm Mask to display whenever the Working
		                                // Set is active. Query via Get Attribute Value (F.58); modify via Change Active Mask (F.34).
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</GlobalConstants>
