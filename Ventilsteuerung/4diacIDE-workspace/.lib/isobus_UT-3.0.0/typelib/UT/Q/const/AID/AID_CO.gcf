	</VersionInfo>
	<CompilerInfo packageName="isobus::UT::Q::const::AID">
	</CompilerInfo>
	<GlobalConstants>
		<VarDeclaration Name="WIDTH" Type="USINT" Comment="1: AID_CO_WIDTH - [1] Read-only for Change Attribute (ISO 11783-6). Query via Get Attribute Value (F.58). Maximum width of the container&apos;s area in pixels." InitialValue="USINT#1"/>
		<VarDeclaration Name="HEIGHT" Type="USINT" Comment="2: AID_CO_HEIGHT - [2] Read-only for Change Attribute (ISO 11783-6). Query via Get Attribute Value (F.58). Maximum height of the container&apos;s area in pixels." InitialValue="USINT#2"/>
		<VarDeclaration Name="HIDDEN" Type="USINT" Comment="3: AID_CO_HIDDEN - [3] Read-only for Change Attribute (ISO 11783-6). Query via Get Attribute Value (F.58); manage via Hide/Show Object (F.2)." InitialValue="USINT#3"/>
	</GlobalConstants>
	<OriginalSource><![CDATA[PACKAGE isobus::UT::Q::const::AID;

// container object attribute ids
GLOBALCONSTANTS AID_CO
	VAR_GLOBAL CONSTANT
		WIDTH : USINT := USINT#1; // 1: AID_CO_WIDTH - [1] Read-only for Change Attribute (ISO 11783-6). Query via Get Attribute Value (F.58). Maximum width of the container's area in pixels.
		HEIGHT : USINT := USINT#2; // 2: AID_CO_HEIGHT - [2] Read-only for Change Attribute (ISO 11783-6). Query via Get Attribute Value (F.58). Maximum height of the container's area in pixels.
		HIDDEN : USINT := USINT#3; // 3: AID_CO_HIDDEN - [3] Read-only for Change Attribute (ISO 11783-6). Query via Get Attribute Value (F.58); manage via Hide/Show Object (F.2).
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</GlobalConstants>
