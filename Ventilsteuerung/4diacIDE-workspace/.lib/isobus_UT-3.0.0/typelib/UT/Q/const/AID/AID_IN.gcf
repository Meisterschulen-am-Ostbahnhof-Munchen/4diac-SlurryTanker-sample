	<GlobalConstants>
		<VarDeclaration Name="WIDTH" Type="USINT" Comment="1: AID_IN_WIDTH - Width in pixels." InitialValue="USINT#1"/>
		<VarDeclaration Name="HEIGHT" Type="USINT" Comment="2: AID_IN_HEIGHT - Height in pixels." InitialValue="USINT#2"/>
		<VarDeclaration Name="BACKGROUND_COLOUR" Type="USINT" Comment="3: AID_IN_BACKGROUND_COLOUR - Background colour index." InitialValue="USINT#3"/>
		<VarDeclaration Name="FONT_ATT" Type="USINT" Comment="4: AID_IN_FONT_ATT - Object ID of a Font Attributes object." InitialValue="USINT#4"/>
		<VarDeclaration Name="OPTIONS" Type="USINT" Comment="5: AID_IN_OPTIONS - Bitmask: Bit 0=Transparent, Bit 1=Display leading zeros, Bit 2=Display zero as blank, Bit 3=Truncate decimals (0=round)." InitialValue="USINT#5"/>
		<VarDeclaration Name="VARIABLE_REF" Type="USINT" Comment="6: AID_IN_VARIABLE_REF - Object ID of a Number Variable object." InitialValue="USINT#6"/>
		<VarDeclaration Name="MIN_VALUE" Type="USINT" Comment="7: AID_IN_MIN_VALUE - Minimum value." InitialValue="USINT#7"/>
		<VarDeclaration Name="MAX_VALUE" Type="USINT" Comment="8: AID_IN_MAX_VALUE - Maximum value." InitialValue="USINT#8"/>
		<VarDeclaration Name="OFFSET" Type="USINT" Comment="9: AID_IN_OFFSET - Offset." InitialValue="USINT#9"/>
		<VarDeclaration Name="SCALE" Type="USINT" Comment="10: AID_IN_SCALE - Scale." InitialValue="USINT#10"/>
		<VarDeclaration Name="NUMB_DECIMALS" Type="USINT" Comment="11: AID_IN_NUMB_DECIMALS - Number of decimals." InitialValue="USINT#11"/>
		<VarDeclaration Name="FORMAT" Type="USINT" Comment="12: AID_IN_FORMAT - Format." InitialValue="USINT#12"/>
		<VarDeclaration Name="JUSTIFICATION" Type="USINT" Comment="13: AID_IN_JUSTIFICATION - Justification." InitialValue="USINT#13"/>
		<VarDeclaration Name="VALUE" Type="USINT" Comment="14: AID_IN_VALUE - [14] Read-only for Change Attribute (ISO 11783-6). Query via Get Attribute Value (F.58); update via Change Numeric Value (F.22)." InitialValue="USINT#14"/>
		<VarDeclaration Name="OPTIONS_2" Type="USINT" Comment="15: AID_IN_OPTIONS_2 - [15] Read-only for Change Attribute (ISO 11783-6). Bitmask: Bit 0=Enabled, Bit 1=Real time editing. Query via Get Attribute Value (F.58); manage via Enable/Disable Object (F.4) or Select Input Object (F.6)." InitialValue="USINT#15"/>
	</GlobalConstants>
	<OriginalSource><![CDATA[PACKAGE isobus::UT::Q::const::AID;

// input number object attribute ids
GLOBALCONSTANTS AID_IN
	VAR_GLOBAL CONSTANT
		WIDTH : USINT := USINT#1; // 1: AID_IN_WIDTH - Width in pixels.
		HEIGHT : USINT := USINT#2; // 2: AID_IN_HEIGHT - Height in pixels.
		BACKGROUND_COLOUR : USINT := USINT#3; // 3: AID_IN_BACKGROUND_COLOUR - Background colour index.
		FONT_ATT : USINT := USINT#4; // 4: AID_IN_FONT_ATT - Object ID of a Font Attributes object.
		OPTIONS : USINT := USINT#5; // 5: AID_IN_OPTIONS - Bitmask: Bit 0=Transparent, Bit 1=Display leading zeros, Bit 2=Display zero as blank, Bit 3=Truncate decimals (0=round).
		VARIABLE_REF : USINT := USINT#6; // 6: AID_IN_VARIABLE_REF - Object ID of a Number Variable object.
		MIN_VALUE : USINT := USINT#7; // 7: AID_IN_MIN_VALUE - Minimum value.
		MAX_VALUE : USINT := USINT#8; // 8: AID_IN_MAX_VALUE - Maximum value.
		OFFSET : USINT := USINT#9; // 9: AID_IN_OFFSET - Offset.
		SCALE : USINT := USINT#10; // 10: AID_IN_SCALE - Scale.
		NUMB_DECIMALS : USINT := USINT#11; // 11: AID_IN_NUMB_DECIMALS - Number of decimals.
		FORMAT : USINT := USINT#12; // 12: AID_IN_FORMAT - Format.
		JUSTIFICATION : USINT := USINT#13; // 13: AID_IN_JUSTIFICATION - Justification.
		VALUE : USINT := USINT#14; // 14: AID_IN_VALUE - [14] Read-only for Change Attribute (ISO 11783-6). Query via Get Attribute Value (F.58); update via Change Numeric Value (F.22).
		OPTIONS_2 : USINT := USINT#15; // 15: AID_IN_OPTIONS_2 - [15] Read-only for Change Attribute (ISO 11783-6). Bitmask: Bit 0=Enabled, Bit 1=Real time editing. Query via Get Attribute Value (F.58); manage via Enable/Disable Object (F.4) or Select Input Object (F.6).
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</GlobalConstants>
