	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-11" Remarks="Kopiert von F_RAW_TO_PHYS, Eingang auf DWORD umgestellt (direkte Verarbeitung ohne vorgelagerten Cast).">
	</VersionInfo>
	<CompilerInfo packageName="logiBUS::utils::conversion::phys">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="dwRaw"/>
				<With Var="stObj"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var=""/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="dwRaw" Type="DWORD"/>
			<VarDeclaration Name="stObj" Type="logiBUS::utils::conversion::phys::NumericObjectPool_S"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="" Type="REAL"/>
		</OutputVars>
	</InterfaceList>
	<FunctionBody>
		<ST><![CDATA[PACKAGE logiBUS::utils::conversion::phys;

(* Convert ISOBUS raw DWORD to physical REAL value.
 * ISOBUS formula: display = (raw + offset) * scale
 * *
 * Example: raw=50000, scale=0.01, offset=-100000 DINT(50000) + (-100000) = -50000 REAL(-50000) *
 * 0.01     = -500.0 *)
FUNCTION F_RAW_DWORD_TO_PHYS : REAL

VAR_INPUT
	dwRaw : DWORD;
	stObj : NumericObjectPool_S;
END_VAR

VAR_TEMP
	i64Raw : LINT; // to avoid overflow
	i64Offset : LINT; // to avoid overflow
END_VAR

i64Raw := DWORD_TO_UDINT(dwRaw); // bit pattern reinterpreted as unsigned, then widened
i64Offset := stObj.i32Offset; // no conversion needed

F_RAW_DWORD_TO_PHYS := LINT_TO_REAL(i64Raw + i64Offset) * stObj.r32Scale;

END_FUNCTION
]]></ST>
	</FunctionBody>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</Function>
