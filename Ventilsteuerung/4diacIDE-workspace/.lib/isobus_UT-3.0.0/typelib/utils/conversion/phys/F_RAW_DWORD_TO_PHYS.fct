<Function Name="F_RAW_DWORD_TO_PHYS" Comment="Convert ISOBUS raw DWORD to physical REAL value.&#10;ISOBUS formula: display = (raw + offset) * scale&#10;&#10;Example: raw=50000, scale=0.01, offset=-100000 DINT(50000) + (-100000) = -50000 REAL(-50000)&#10;0.01     = -500.0">
