<FBType Name="logiBUS_AI_IDA" Comment="Composite FB for analog double word input data">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;AnalogInput_hysteresis = 0 switches the change trigger off (use 1 to see every change). TimeDelta = 0 or 16#FFFFFFFF switches the cyclic IND off. With both off the block sends no IND (value only via REQ).&#10;&#10;IN = 0-4095 (12 bit, fixed full-scale raw value, ESP32-P4 ADC continuous/DMA mode has no other bit width to choose from).">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-02-23">
	</VersionInfo>
	<CompilerInfo packageName="logiBUS::io::AI">
