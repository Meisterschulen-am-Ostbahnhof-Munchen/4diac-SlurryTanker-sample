			<VarDeclaration Name="Input" Type="logiBUS::io::AI::logiBUS_AI_S" Comment="Identify the Input Input_I1..I8" InitialValue="Invalid"/>
			<VarDeclaration Name="AnalogInput_hysteresis" Type="DWORD" Comment="IND when the raw value changes by more than this (0 = off)"/>
			<VarDeclaration Name="TimeDelta" Type="DWORD" Comment="After How many ms an IND (poll interval, 0 or 16#FFFFFFFF = off)" InitialValue="250"/>
			<VarDeclaration Name="TimeRateLimit" Type="DWORD" Comment="Maximum 1 IND in how many ms. (&lt; delta)" InitialValue="100"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="Event Output Qualifier"/>
			<VarDeclaration Name="STATUS" Type="STRING" Comment="Service Status"/>
		</OutputVars>
		<Plugs>
