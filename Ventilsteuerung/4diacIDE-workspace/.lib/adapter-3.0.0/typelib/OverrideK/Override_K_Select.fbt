<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="Override_K_Select" Comment="Aktiv/Wert (AX) zu K (AUI) fuer AX_AUI_MUX_3: 0=Normal, 1=Force FALSE, 2=Force&#10;TRUE">
