	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="DWORD_00" Type="adapter::types::unidirectional::AD" Comment="DWord 0" x="700" y="0"/>
			<AdapterDeclaration Name="DWORD_01" Type="adapter::types::unidirectional::AD" Comment="DWord 1" x="700" y="1000"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::AL" Comment="LWORD Input" x="-4000" y="1700"/>
