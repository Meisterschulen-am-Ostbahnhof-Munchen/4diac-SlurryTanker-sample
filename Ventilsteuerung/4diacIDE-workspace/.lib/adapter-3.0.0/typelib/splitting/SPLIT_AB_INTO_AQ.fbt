<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="SPLIT_AB_INTO_AQ" Comment="this Function splits the 4 AQ (QUARTER) adapters from a AB (BYTE)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-05-16" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="adapter::splitting">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="QUARTER_BYTE_00" Type="adapter::types::unidirectional::AQ" Comment="Quarter 0" x="700" y="0"/>
			<AdapterDeclaration Name="QUARTER_BYTE_01" Type="adapter::types::unidirectional::AQ" Comment="Quarter 1" x="700" y="1000"/>
			<AdapterDeclaration Name="QUARTER_BYTE_02" Type="adapter::types::unidirectional::AQ" Comment="Quarter 2" x="700" y="2000"/>
			<AdapterDeclaration Name="QUARTER_BYTE_03" Type="adapter::types::unidirectional::AQ" Comment="Quarter 3" x="700" y="3000"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::AB" Comment="BYTE Input" x="-4000" y="1700"/>
		</Sockets>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
