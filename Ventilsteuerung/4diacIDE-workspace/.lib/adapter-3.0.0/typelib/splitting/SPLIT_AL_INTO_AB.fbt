			<AdapterDeclaration Name="BYTE_01" Type="adapter::types::unidirectional::AB" Comment="Byte 1" x="700" y="500"/>
			<AdapterDeclaration Name="BYTE_02" Type="adapter::types::unidirectional::AB" Comment="Byte 2" x="700" y="1000"/>
