			<AdapterDeclaration Name="BYTE_05" Type="adapter::types::unidirectional::AB" Comment="Byte 5" x="700" y="2500"/>
			<AdapterDeclaration Name="BYTE_06" Type="adapter::types::unidirectional::AB" Comment="Byte 6" x="700" y="3000"/>
			<AdapterDeclaration Name="BYTE_07" Type="adapter::types::unidirectional::AB" Comment="Byte 7" x="700" y="3500"/>
