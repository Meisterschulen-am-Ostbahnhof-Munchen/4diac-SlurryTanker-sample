<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AD_OR_2_UNGATED" Comment="FB to calculate bitwise OR (generic FB) OHNE Aenderungserkennung - reicht JEDES&#10;neu berechnete Ergebnis bedingungslos weiter (fuer Verbraucher, die eine&#10;periodische Kadenz unabhaengig von Wertaenderung brauchen, z.B.&#10;Ableitungs-/Frequenzberechnungen).">
