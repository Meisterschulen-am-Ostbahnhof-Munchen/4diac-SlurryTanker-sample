<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ASSEMBLE_AW_FROM_AQ" Comment="this Function combines the 8 AQ (QUARTER) adapters to a AW (WORD)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-05-16" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="adapter::assembling">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::AW" Comment="WORD Output" x="3100" y="100"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="QUARTER_BYTE_00" Type="adapter::types::unidirectional::AQ" Comment="Quarter 0" x="-1200" y="0"/>
			<AdapterDeclaration Name="QUARTER_BYTE_01" Type="adapter::types::unidirectional::AQ" Comment="Quarter 1" x="-1200" y="500"/>
			<AdapterDeclaration Name="QUARTER_BYTE_02" Type="adapter::types::unidirectional::AQ" Comment="Quarter 2" x="-1200" y="1000"/>
			<AdapterDeclaration Name="QUARTER_BYTE_03" Type="adapter::types::unidirectional::AQ" Comment="Quarter 3" x="-1200" y="1500"/>
			<AdapterDeclaration Name="QUARTER_BYTE_04" Type="adapter::types::unidirectional::AQ" Comment="Quarter 4" x="-1200" y="2000"/>
			<AdapterDeclaration Name="QUARTER_BYTE_05" Type="adapter::types::unidirectional::AQ" Comment="Quarter 5" x="-1200" y="2500"/>
			<AdapterDeclaration Name="QUARTER_BYTE_06" Type="adapter::types::unidirectional::AQ" Comment="Quarter 6" x="-1200" y="3000"/>
			<AdapterDeclaration Name="QUARTER_BYTE_07" Type="adapter::types::unidirectional::AQ" Comment="Quarter 7" x="-1200" y="3500"/>
		</Sockets>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
