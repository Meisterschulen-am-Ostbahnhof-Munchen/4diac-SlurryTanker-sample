	</VersionInfo>
	<CompilerInfo packageName="adapter::assembling">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::AL" Comment="LWORD Output" x="3100" y="100"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="BYTE_00" Type="adapter::types::unidirectional::AB" Comment="Byte 0" x="-1200" y="0"/>
			<AdapterDeclaration Name="BYTE_01" Type="adapter::types::unidirectional::AB" Comment="Byte 1" x="-1200" y="500"/>
			<AdapterDeclaration Name="BYTE_02" Type="adapter::types::unidirectional::AB" Comment="Byte 2" x="-1200" y="1000"/>
			<AdapterDeclaration Name="BYTE_03" Type="adapter::types::unidirectional::AB" Comment="Byte 3" x="-1200" y="1500"/>
			<AdapterDeclaration Name="BYTE_04" Type="adapter::types::unidirectional::AB" Comment="Byte 4" x="-1200" y="2000"/>
			<AdapterDeclaration Name="BYTE_05" Type="adapter::types::unidirectional::AB" Comment="Byte 5" x="-1200" y="2500"/>
			<AdapterDeclaration Name="BYTE_06" Type="adapter::types::unidirectional::AB" Comment="Byte 6" x="-1200" y="3000"/>
			<AdapterDeclaration Name="BYTE_07" Type="adapter::types::unidirectional::AB" Comment="Byte 7" x="-1200" y="3500"/>
		</Sockets>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
