<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="A2X_OR_2" Comment="Composite FB to calculate boolean OR between 2 A2X adapters (UP and DOWN&#10;independently)">
	<Identification Standard="61499-2" Function="OUT.UP = IN1.UP OR IN2.UP, OUT.DOWN = IN1.DOWN OR IN2.DOWN" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="Initial Version">
	</VersionInfo>
	<CompilerInfo packageName="adapter::booleanOperators">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::A2X" Comment="OR result" x="2900" y="700"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN1" Type="adapter::types::unidirectional::A2X" Comment="OR input 1" x="200" y="0"/>
			<AdapterDeclaration Name="IN2" Type="adapter::types::unidirectional::A2X" Comment="OR input 2" x="200" y="1400"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="OR_UP" Type="iec61131::booleanOperators::OR_BOOL_2" Comment="ORs the UP channel" x="1400" y="0">
		</FB>
		<FB Name="OR_DOWN" Type="iec61131::booleanOperators::OR_BOOL_2" Comment="ORs the DOWN channel" x="1400" y="1400">
		</FB>
		<EventConnections>
			<Connection Source="IN1.E_UP" Destination="OR_UP.REQ"/>
			<Connection Source="IN2.E_UP" Destination="OR_UP.REQ" dx1="326.67"/>
			<Connection Source="OR_UP.CNF" Destination="OUT.E_UP" dx1="380"/>
			<Connection Source="IN1.E_DOWN" Destination="OR_DOWN.REQ" dx1="360"/>
			<Connection Source="IN2.E_DOWN" Destination="OR_DOWN.REQ" dx1="426.67"/>
			<Connection Source="OR_DOWN.CNF" Destination="OUT.E_DOWN" dx1="380"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="IN1.UP" Destination="OR_UP.IN1" dx1="393.33"/>
			<Connection Source="IN2.UP" Destination="OR_UP.IN2" dx1="393.33"/>
			<Connection Source="OR_UP.OUT" Destination="OUT.UP" dx1="346.67"/>
			<Connection Source="IN1.DOWN" Destination="OR_DOWN.IN1" dx1="293.33"/>
			<Connection Source="IN2.DOWN" Destination="OR_DOWN.IN2" dx1="366.67"/>
			<Connection Source="OR_DOWN.OUT" Destination="OUT.DOWN" dx1="413.33"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
