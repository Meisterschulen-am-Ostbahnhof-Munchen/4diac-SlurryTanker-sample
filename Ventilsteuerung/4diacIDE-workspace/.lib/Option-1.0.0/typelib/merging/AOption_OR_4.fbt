		<DataConnections>
			<Connection Source="IN1.QI_OUT" Destination="OR_QI.IN1" dx1="606.67"/>
			<Connection Source="IN2.QI_OUT" Destination="OR_QI.IN2" dx1="606.67"/>
			<Connection Source="IN3.QI_OUT" Destination="OR_QI.IN3" dx1="700"/>
			<Connection Source="IN4.QI_OUT" Destination="OR_QI.IN4" dx1="820"/>
