<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AOption_OR_4" Comment="Options-Fan-In: 4 AOption-Sockets IN1/IN2/IN3/IN4 auf 1 Plug OUT, QI_OUT = IN1 ODER IN2 ODER IN3 ODER IN4. OUT.INIT_CNF geht per E_MUX_4/E_DEMUX_4 an den anfragenden Socket zurueck.">
	<Identification Standard="61499-1" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-17" Remarks="Wie AOption_OR_2 mit 4 Eingaengen. E_MUX_4.K merkt den anfragenden Socket, E_DEMUX_4 leitet OUT.INIT_CNF dorthin. Max. 1 offene Anfrage.">
	</VersionInfo>
	<CompilerInfo packageName="Option::merging">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="Option::AOption" Comment="Gemeinsamer Ausgang - aktiv, solange IN1 ODER IN2 ODER IN3 ODER IN4 aktiv ist" x="4000" y="0"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IN1" Type="Option::AOption" Comment="Erster AOption-Eingang" x="300" y="-400"/>
			<AdapterDeclaration Name="IN2" Type="Option::AOption" Comment="Zweiter AOption-Eingang" x="300" y="600"/>
			<AdapterDeclaration Name="IN3" Type="Option::AOption" Comment="Dritter AOption-Eingang" x="300" y="1600"/>
			<AdapterDeclaration Name="IN4" Type="Option::AOption" Comment="Vierter AOption-Eingang" x="300" y="2300"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="OR_QI" Type="iec61131::booleanOperators::OR_BOOL_4" x="2400" y="0">
		</FB>
		<FB Name="E_MUX_4" Type="iec61499::events::E_MUX_4" x="-2600" y="0">
		</FB>
		<FB Name="E_DEMUX_4" Type="iec61499::events::E_DEMUX_4" x="-1200" y="0">
		</FB>
		<EventConnections>
			<Connection Source="OR_QI.CNF" Destination="OUT.INIT_REQ"/>
			<Connection Source="OUT.INIT_CNF" Destination="E_DEMUX_4.EI" dx1="80" dx2="80" dy="-586.67"/>
			<Connection Source="E_DEMUX_4.EO1" Destination="IN1.INIT_CNF" dx1="393.33"/>
			<Connection Source="E_DEMUX_4.EO2" Destination="IN2.INIT_CNF" dx1="393.33"/>
			<Connection Source="E_DEMUX_4.EO3" Destination="IN3.INIT_CNF" dx1="260"/>
			<Connection Source="E_DEMUX_4.EO4" Destination="IN4.INIT_CNF" dx1="146.67"/>
			<Connection Source="IN1.INIT_REQ" Destination="E_MUX_4.EI1" dx1="80" dx2="553.33" dy="-326.67"/>
			<Connection Source="IN2.INIT_REQ" Destination="E_MUX_4.EI2" dx1="80" dx2="560" dy="460"/>
			<Connection Source="IN3.INIT_REQ" Destination="E_MUX_4.EI3" dx1="80" dx2="420" dy="420"/>
			<Connection Source="IN4.INIT_REQ" Destination="E_MUX_4.EI4" dx1="80" dx2="280" dy="420"/>
			<Connection Source="E_MUX_4.EO" Destination="OR_QI.REQ">
