<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="PositionMarkerFS" Comment="Moves a VT marker object to reflect an incoming REAL value — accepts&#10;PositionMarker_S struct, clamps to the marker&apos;s travel range, drives&#10;Q_ChildPosition">
	<Identification Standard="ISO 11783-6" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0&#10;&#10;Wraps a single Q_ChildPosition instance (ISO 11783-6 F.16) that moves a marker object (e.g. a triangle) within its container, given an arbitrary REAL value (from any source - a VT InputNumber via NumericValue_PHYS, a sensor, or anything else). stObj is snapshotted once at INIT via F_MOVE, matching the ScrollFS/Q_NumericValue_PHYS pattern. The incoming value is offset by stObj.r32Center, clamped to stObj.r32MinPos..r32MaxPos (reporting xOver/xUnder), then integerized once for Q_ChildPosition.s16Xposition. s16Yposition is a fixed passthrough of stObj.s16YPosition.">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-05" Remarks="Add xScale flag, passed through to the internal MoveMarker (Q_ChildPosition)">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-05" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="isobus::UT::Q">
		<Import declaration="isobus::utils::childposition::PositionMarker_S"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="stObj"/>
				<With Var="xScale"/>
			</Event>
			<Event Name="REQ" Type="Event" Comment="Move the marker to reflect a new value">
				<With Var="rValue"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
			<Event Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
				<With Var="STATUS"/>
				<With Var="s16result"/>
				<With Var="xOver"/>
				<With Var="xUnder"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="stObj" Type="isobus::utils::childposition::PositionMarker_S" Comment="Marker object pool properties (child/parent IDs, travel bounds, center offset), snapshotted at INIT"/>
			<VarDeclaration Name="xScale" Type="BOOL" Comment="FALSE (default) = bypass, send s16Xposition/s16Yposition through unchanged. TRUE = scale them by the DM/SKM factor for stObj.u16ParentId. Passed straight through to the internal MoveMarker (Q_ChildPosition)." InitialValue="FALSE"/>
			<VarDeclaration Name="rValue" Type="REAL" Comment="Physical value to display - from any source, not limited to NumericValue_PHYS"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="STATUS" Type="STRING" Comment="Service Status - passthrough from the internal Q_ChildPosition"/>
			<VarDeclaration Name="s16result" Type="INT" Comment="retval - passthrough from the internal Q_ChildPosition, see Q_ChildPosition"/>
			<VarDeclaration Name="xOver" Type="BOOL" Comment="rValue (after adding stObj.r32Center) exceeded stObj.r32MaxPos and was clamped"/>
			<VarDeclaration Name="xUnder" Type="BOOL" Comment="rValue (after adding stObj.r32Center) fell below stObj.r32MinPos and was clamped"/>
		</OutputVars>
	</InterfaceList>
	<FBNetwork>
		<FB Name="Snap" Type="iec61131::selection::F_MOVE" x="-5600" y="1600">
			<Attribute Name="DataType" Value="isobus::utils::childposition::PositionMarker_S"/>
			<Parameter Name="OUT.u16ChildId" Value="">
				<Attribute Name="Visible" Value="true"/>
			</Parameter>
			<Parameter Name="OUT.u16ParentId" Value="">
				<Attribute Name="Visible" Value="true"/>
			</Parameter>
			<Parameter Name="OUT.r32MinPos" Value="">
				<Attribute Name="Visible" Value="true"/>
			</Parameter>
			<Parameter Name="OUT.r32MaxPos" Value="">
				<Attribute Name="Visible" Value="true"/>
			</Parameter>
			<Parameter Name="OUT.r32Center" Value="">
				<Attribute Name="Visible" Value="true"/>
			</Parameter>
			<Parameter Name="OUT.s16YPosition" Value="">
				<Attribute Name="Visible" Value="true"/>
			</Parameter>
		</FB>
		<FB Name="AddCenter" Type="iec61131::arithmetic::F_ADD" x="-3800" y="400">
		</FB>
		<FB Name="Clamp" Type="logiBUS::signalprocessing::clamp::F_ClampReal" x="-2000" y="400">
		</FB>
		<FB Name="ToInt" Type="iec61131::conversion::F_REAL_TO_INT" x="-200" y="400">
		</FB>
		<FB Name="MoveMarker" Type="isobus::UT::Q::Q_ChildPosition" x="1700" y="1200">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="Snap.REQ" dx1="420"/>
			<Connection Source="Snap.CNF" Destination="MoveMarker.INIT" dx1="2333.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="REQ" Destination="AddCenter.REQ" dx1="633.33"/>
			<Connection Source="AddCenter.CNF" Destination="Clamp.REQ" dx1="526.67"/>
			<Connection Source="Clamp.CNF" Destination="ToInt.REQ" dx1="526.67"/>
			<Connection Source="ToInt.CNF" Destination="MoveMarker.REQ" dx1="526.67"/>
			<Connection Source="MoveMarker.INITO" Destination="INITO" dx1="1546.67">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="MoveMarker.CNF" Destination="CNF" dx1="1060"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="stObj" Destination="Snap.IN" dx1="386.67"/>
			<Connection Source="Snap.OUT.u16ChildId" Destination="MoveMarker.u16ObjId" dx1="2000">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Snap.OUT.u16ParentId" Destination="MoveMarker.u16ObjIdParent" dx1="2033.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="xScale" Destination="MoveMarker.xScale" dx1="2033.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="rValue" Destination="AddCenter.IN1" dx1="1000"/>
			<Connection Source="Snap.OUT.r32Center" Destination="AddCenter.IN2" dx1="1333.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="AddCenter.OUT" Destination="Clamp.rIn" dx1="526.67"/>
			<Connection Source="Snap.OUT.r32MinPos" Destination="Clamp.rMin" dx1="1466.67">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Snap.OUT.r32MaxPos" Destination="Clamp.rMax" dx1="1533.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Clamp." Destination="ToInt.IN" dx1="526.67"/>
			<Connection Source="ToInt.OUT" Destination="MoveMarker.s16Xposition" dx1="153.33"/>
			<Connection Source="Snap.OUT.s16YPosition" Destination="MoveMarker.s16Yposition" dx1="1933.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="MoveMarker.STATUS" Destination="STATUS" dx1="1266.67"/>
			<Connection Source="MoveMarker.s16result" Destination="s16result" dx1="1366.67"/>
			<Connection Source="Clamp.xOver" Destination="xOver" dx1="4553.33"/>
			<Connection Source="Clamp.xUnder" Destination="xUnder" dx1="4620"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
