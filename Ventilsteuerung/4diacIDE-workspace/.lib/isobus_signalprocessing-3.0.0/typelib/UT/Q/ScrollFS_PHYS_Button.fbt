			<Connection Source="PageDownSel.OUT" Destination="PtrPageDown.u32NewValue" dx1="200"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
