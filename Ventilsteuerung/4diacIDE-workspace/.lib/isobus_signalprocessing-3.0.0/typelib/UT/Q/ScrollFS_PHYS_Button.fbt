			</Connection>
			<Connection Source="Inner.qAtFirst" Destination="PageUpSel.G" dx1="80" dx2="80" dy="3020">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="PageUpSel.OUT" Destination="PtrPageUp.u32NewValue" dx1="200"/>
			<Connection Source="Snap.OUT.stControls.u16BtnUpPtrId" Destination="PtrUp.u16ObjId" dx1="893.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Snap.OUT.stControls.u16BtnUpId" Destination="UpSel.IN0" dx1="893.33">
				<Attribute Name="Visible" Value="false"/>
			</Connection>
			<Connection Source="Inner.qAtFirst" Destination="UpSel.G" dx1="80" dx2="80" dy="3420">
				<Attribute Name="Visible" Value="false"/>
