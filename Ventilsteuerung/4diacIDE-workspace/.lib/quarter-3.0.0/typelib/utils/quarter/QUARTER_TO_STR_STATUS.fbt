<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="QUARTER_TO_STR_STATUS" Comment="quad-state to String">
	<Identification Standard="61499-2" Description="Copyright (c) 2024 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2024-02-23">
	</VersionInfo>
	<CompilerInfo packageName="logiBUS::utils::quarter">
		<Import declaration="logiBUS::utils::quarter::const::quarter"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Normal Execution Request">
				<With Var="IB"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Execution Confirmation">
				<With Var="STR"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IB" Type="BYTE" Comment="2bit (quarter Byte) Output with 4 States" InitialValue="quarter::COMMAND_DISABLE"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="STR" Type="STRING" Comment="STRING Output" InitialValue="quarter::COMMAND_DISABLE_msg"/>
		</OutputVars>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="666.67" y="1600">
			</ECState>
			<ECState Name="SET" x="4000" y="533.33">
				<ECAction Algorithm="SET"/>
			</ECState>
			<ECState Name="RESET" x="4000" y="1200">
				<ECAction Algorithm="RESET"/>
			</ECState>
			<ECState Name="Error" x="4000" y="1866.67">
				<ECAction Algorithm="ERROR"/>
			</ECState>
			<ECState Name="none" x="4000" y="2533.33">
				<ECAction Algorithm="NONE"/>
			</ECState>
			<ECState Name="ok" x="6746.67" y="1353.33">
				<ECAction Output="CNF"/>
			</ECState>
			<ECTransition Source="START" Destination="SET" Condition="REQ[IB = quarter::STATUS_ENABLED]" x="2640" y="1080"/>
			<ECTransition Source="START" Destination="RESET" Condition="REQ[IB = quarter::STATUS_DISABLED]" x="2673.33" y="1446.67"/>
			<ECTransition Source="START" Destination="Error" Condition="REQ[IB = quarter::STATUS_ERROR]" x="2700" y="1840"/>
			<ECTransition Source="START" Destination="none" Condition="REQ[IB = quarter::STATUS_NOT_AVAILABLE]" x="2653.33" y="2200"/>
			<ECTransition Source="SET" Destination="ok" Condition="1" x="4700" y="393.33"/>
			<ECTransition Source="RESET" Destination="ok" Condition="1" x="4546.67" y="1040"/>
			<ECTransition Source="Error" Destination="ok" Condition="1" x="4593.33" y="1753.33"/>
			<ECTransition Source="none" Destination="ok" Condition="1" x="4713.33" y="2380"/>
			<ECTransition Source="ok" Destination="START" Condition="1" x="4426.67" y="3606.67"/>
		</ECC>
		<Algorithm Name="SET">
			<ST><![CDATA[
STR := quarter::COMMAND_ENABLE_msg;
]]></ST>
		</Algorithm>
		<Algorithm Name="RESET">
			<ST><![CDATA[
STR := quarter::COMMAND_DISABLE_msg;
]]></ST>
		</Algorithm>
		<Algorithm Name="ERROR">
			<ST><![CDATA[
STR := quarter::COMMAND_RESERVED_msg;
]]></ST>
		</Algorithm>
		<Algorithm Name="NONE">
			<ST><![CDATA[
STR := quarter::COMMAND_NO_ACTION_msg;
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
