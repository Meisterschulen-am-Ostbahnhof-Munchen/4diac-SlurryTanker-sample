	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2024-02-29">
	</VersionInfo>
	<CompilerInfo packageName="logiBUS::utils::quarter">
		<Import declaration="logiBUS::utils::quarter::const::quarter"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="I"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var=""/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="I" Type="BOOL" Comment="BOOL Input" InitialValue="BOOL#FALSE"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="" Type="BYTE"/>
		</OutputVars>
	</InterfaceList>
	<FunctionBody>
		<ST><![CDATA[PACKAGE logiBUS::utils::quarter;

IMPORT logiBUS::utils::quarter::const::quarter;

FUNCTION BOOL_TO_QUARTER : BYTE // 2bit (quarter Byte) Output with 4 States (only 2 used)

VAR_INPUT
	I : BOOL := BOOL#FALSE; // BOOL Input
END_VAR

CASE I OF
	BOOL#TRUE :
		BOOL_TO_QUARTER := quarter::COMMAND_ENABLE;
	ELSE
		BOOL_TO_QUARTER := quarter::COMMAND_DISABLE;
END_CASE;

END_FUNCTION
]]></ST>
	</FunctionBody>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</Function>
