<?xml version="1.0" encoding="UTF-8" ?>

<FBType Comment="Subtracts two number values, clamping on underflow/overflow" Name="SAFE_SUB">
  <Identification Description="Copyright (c) 2026 HR Agrartechnik GmbH&#13;&#10; &#13;&#10;This program and the accompanying materials are made&#13;&#10;available under the terms of the Eclipse Public License 2.0&#13;&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#13;&#10;&#13;&#10;SPDX-License-Identifier: EPL-2.0" Standard="61131-3" Classification="saturating arithmetic function"/>
  <VersionInfo Author="Franz Höpfinger" Date="2026-08-27" Organization="HR Agrartechnik GmbH" Version="1.0" Remarks="initial API and implementation and/or initial documentation; addresses the silent UDINT wraparound seen in Uebung_011b3 (1 - 12)"/>
  <CompilerInfo packageName="SafeArithmetic::arithmetic">
  </CompilerInfo>
  <InterfaceList>
    <EventInputs>
      <Event Comment="Normal Execution Request" Name="REQ" Type="Event">
        <With Var="IN1"/>
        <With Var="IN2"/>
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Comment="Execution Confirmation" Name="CNF" Type="Event">
        <With Var="OUT"/>
        <With Var="LIMIT_HIT"/>
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Comment="minuend" Name="IN1" Type="ANY_MAGNITUDE"/>
      <VarDeclaration Comment="subtrahend" Name="IN2" Type="ANY_MAGNITUDE"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration Comment="IN2 subtracted from IN1, clamped to the valid range of the result type" Name="OUT" Type="ANY_MAGNITUDE"/>
      <VarDeclaration Comment="TRUE if the result was clamped due to underflow/overflow" Name="LIMIT_HIT" Type="BOOL"/>
    </OutputVars>
  </InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
