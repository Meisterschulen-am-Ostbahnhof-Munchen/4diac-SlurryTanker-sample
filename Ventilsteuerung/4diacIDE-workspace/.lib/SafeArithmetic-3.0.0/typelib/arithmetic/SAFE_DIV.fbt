<?xml version="1.0" encoding="UTF-8" ?>

<FBType Comment="Divides two values, clamping on overflow and division-by-zero" Name="SAFE_DIV">
  <Identification Description="Copyright (c) 2026 HR Agrartechnik GmbH&#13;&#10; &#13;&#10;This program and the accompanying materials are made&#13;&#10;available under the terms of the Eclipse Public License 2.0&#13;&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#13;&#10;&#13;&#10;SPDX-License-Identifier: EPL-2.0" Standard="61131-3" Classification="saturating arithmetic function"/>
  <VersionInfo Author="Franz Höpfinger" Date="2026-08-27" Organization="HR Agrartechnik GmbH" Version="1.0" Remarks="initial API and implementation and/or initial documentation; division by zero clamps OUT to 0 instead of trapping/producing INF/NaN"/>
  <CompilerInfo packageName="SafeArithmetic::arithmetic">
  </CompilerInfo>
  <InterfaceList>
    <EventInputs>
      <Event Comment="Normal Execution Request" Name="REQ" Type="Event">
        <With Var="IN1"/>
        <With Var="IN2"/>
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Comment="Execution Confirmation" Name="CNF" Type="Event">
        <With Var="OUT"/>
        <With Var="LIMIT_HIT"/>
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Comment="dividend" Name="IN1" Type="ANY_NUM"/>
      <VarDeclaration Comment="divisor" Name="IN2" Type="ANY_NUM"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration Comment="IN1 divided by IN2; 0 if IN2 is 0" Name="OUT" Type="ANY_NUM"/>
      <VarDeclaration Comment="TRUE if the result was clamped due to overflow or division by zero" Name="LIMIT_HIT" Type="BOOL"/>
    </OutputVars>
  </InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
