  <Product Comment="Optionsmanagement-Bausteine fuer MyLib_AX (analog zu MyLib_AX_CAN2 aus MyLib_AX herausgeloest, damit optionale Programmteile nicht in MyLib_AX selbst liegen): SubApps, die den AOption-Adapter aus der Option-Library nutzen, um I/O-Gruppen freizuschalten." Name="MyLib_AX_Option" SymbolicName="MyLib_AX_Option">
    <VersionInfo Author="Franz Höpfinger" Date="2026-10-13" Version="1.0.0"/>
  </Product>
