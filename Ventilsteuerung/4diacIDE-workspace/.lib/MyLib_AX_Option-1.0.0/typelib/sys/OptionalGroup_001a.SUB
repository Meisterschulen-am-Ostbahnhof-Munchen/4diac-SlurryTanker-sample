<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="OptionalGroup_001a" Comment="Optionsgruppe 1a: wie OptionalGroup_001b (Eingang/Ausgang per QI freigeschaltet), reicht die Aktivierung zusaetzlich ueber den Plug PLUG1 an eine nachgeschaltete Gruppe weiter - fuer sequenzielle Aktivierung mehrerer Gruppen (erst 1a, dann 1b).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Daisy-Chain-Glied fuer sequenzielle Options-Aktivierung: PLUG1 (Option::AOption) wird erst ausgeloest, wenn DigitalOutput_Q1 selbst initialisiert ist, und dessen INIT_CNF wird an den eigenen Socket OPTION zurueckgemeldet - der aufrufende DEMUX sieht die Gruppe also erst als fertig, wenn die GESAMTE Kette (inkl. nachgeschalteter Gruppen an PLUG1) bestaetigt hat.">
	</VersionInfo>
