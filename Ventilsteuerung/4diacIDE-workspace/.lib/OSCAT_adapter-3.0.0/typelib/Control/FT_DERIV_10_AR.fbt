<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="FT_DERIV_10_AR" Comment="AR-Adapter-Wrapper um OSCAT FT_DERIV_10 - bruckt zwischen adapter und OSCAT,&#10;ohne dass eine der beiden Basisbibliotheken von der anderen abhaengt. K als&#10;AUI-Adapter-Socket (dynamisch), Faktor/run als Klartext-InputVars durchgereicht&#10;(Default Faktor=1.0, run=TRUE)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-10-03" Remarks="Franz: 'K auch auf Adapter umstellen' - K von InputVar (UINT, With-gebunden an REQ) auf AUI-Adapter-Socket umgestellt (gleiches Muster wie AR_IN: K.E1 loest FT_DERIV_10.REQ zusaetzlich aus, K.D1 liefert den Wert). With-Bindung von K am expliziten REQ-Event entfernt (K triggert jetzt selbst), Faktor/run bleiben unveraendert als Klartext-InputVars mit With-Bindung an REQ.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-20" Remarks="Bugfix: K/Faktor/run wurden nur per plain DataConnection an FT_DERIV_10 durchgereicht, ausgeloest einzig ueber AR_IN.E1 - kein Event auf diesem Wrapper hatte je eine With-Verknuepfung fuer diese Vars (IEC 61499 - ungebundene Vars werden nicht zuverlaessig gelesen). Neues explizites REQ-EventInput ergaenzt (parallel zu AR_IN.E1, beide -&gt; FT_DERIV_10.REQ) mit With K/Faktor/run, gespiegelt vom inneren FT_DERIV_10.REQ.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-12" Remarks="Initial implementation of FT_DERIV_10_AR wrapper FB">
	</VersionInfo>
	<CompilerInfo packageName="OSCAT_adapter::Control">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization (durchgereicht an FT_DERIV_10.EINIT)">
			</Event>
			<Event Name="REQ" Type="Event" Comment="Explizite Ausfuehrungsanforderung (durchgereicht an FT_DERIV_10.REQ, zusaetzlich zu AR_IN.E1/K.E1)">
				<With Var="Faktor"/>
				<With Var="run"/>
			</Event>
			<Event Name="RST" Type="Event" Comment="Reset der Ableitungshistorie (durchgereicht an FT_DERIV_10.RST)">
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="Faktor" Type="REAL" Comment="Multiplikationsfaktor (durchgereicht an FT_DERIV_10.Faktor)" InitialValue="1.0"/>
			<VarDeclaration Name="run" Type="BOOL" Comment="Berechnung aktiv (durchgereicht an FT_DERIV_10.run)" InitialValue="TRUE"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="AR_OUT" Type="adapter::types::unidirectional::AR" Comment="Berechnete Ableitung (REAL, basierend auf K)" x="5300" y="200"/>
			<AdapterDeclaration Name="AR_DELTA_IN" Type="adapter::types::unidirectional::AR" Comment="Differenz des Eingangssignals ueber 1 Periode (REAL, DI_0)" x="5100" y="1200"/>
			<AdapterDeclaration Name="AUDI_DELTA_T" Type="adapter::types::unidirectional::AUDI" Comment="Zeitdifferenz in Mikrosekunden ueber 1 Periode (UDINT, DT_0)" x="5100" y="700"/>
			<AdapterDeclaration Name="AB_VALID" Type="adapter::types::unidirectional::AB" Comment="Gueltigkeit der Messung (BOOL, durchgereicht von FT_DERIV_10.valid)" x="5100" y="1700"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="AR_IN" Type="adapter::types::unidirectional::AR" Comment="Eingangssignal (REAL)" x="-1500" y="1500"/>
			<AdapterDeclaration Name="K" Type="adapter::types::unidirectional::AUI" Comment="Window Select (UINT, dynamisch): 0=1 Period, 9=10 Periods" x="-1500" y="2000"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="FT_DERIV_10" Type="OSCAT::Basic::POUs::Engineering::Control::FT_DERIV_10" x="800" y="0">
		</FB>
		<FB Name="E_D_FF_ANY" Type="iec61499::events::E_D_FF_ANY_4" x="2400" y="200">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="FT_DERIV_10.EINIT" dx1="2800"/>
			<Connection Source="FT_DERIV_10.INITO" Destination="INITO" dx1="453.33"/>
			<Connection Source="RST" Destination="FT_DERIV_10.RST" dx1="2473.33"/>
			<Connection Source="AR_IN.E1" Destination="FT_DERIV_10.REQ" dx1="626.67"/>
			<Connection Source="K.E1" Destination="FT_DERIV_10.REQ" dx1="626.67"/>
			<Connection Source="REQ" Destination="FT_DERIV_10.REQ" dx1="626.67"/>
			<Connection Source="FT_DERIV_10.CNF" Destination="E_D_FF_ANY.CLK" dx1="453.33"/>
			<Connection Source="E_D_FF_ANY.EO" Destination="AR_OUT.E1"/>
			<Connection Source="E_D_FF_ANY.EO" Destination="AUDI_DELTA_T.E1" dx1="906.67"/>
