<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="CTRL_PID_AR" Comment="AR-Adapter-Wrapper um OSCAT CTRL_PID - bruckt zwischen adapter und OSCAT&#10;PID-Regler. Istwert, Sollwert, Hand-Umschaltung, Handwert, Reglerparameter&#10;UND Rauschunterdrueckung/Offset/Grenzwerte vollstaendig als Adapter-Sockets -&#10;kein explizites REQ mehr noetig.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.4" Author="Franz Höpfinger" Date="2026-10-03" Remarks="Franz: 'die Eingaenge sollen identisch sortiert sein wie bei dem enthaltenen FB' - Sockets (inkl. EventConnections/DataConnections/Dokumentation) auf die Reihenfolge von CTRL_PID.InputVars umsortiert: AR_ACT, SET, SUP, OFS, M_I, AX_MAN, KP, TN, TV, LL, LH (vorher: AR_ACT, SET, AX_MAN, M_I, KP, TN, TV, SUP, OFS, LL, LH - SUP/OFS/LL/LH waren beim v1.3-Umbau einfach hinten angehaengt worden). Rein kosmetisch/strukturell, keine funktionale Aenderung.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.3" Author="Franz Höpfinger" Date="2026-10-03" Remarks="Franz: 'SUP, OFS, LL, LH muessen auch AR Adapter werden, wie KP und TN. REQ faellt dann weg, RST bleibt. CNF entfaellt auch.' - SUP/OFS/LL/LH von InputVars (REAL, With-gebunden an REQ) auf AR-Adapter-Sockets umgestellt (gleiches Muster wie KP/TN/TV/M_I: *.E1 loest CTRL_PID.REQ aus, *.D1 liefert den Wert). Explizites REQ-EventInput (inkl. With-Bindungen) und CNF-EventOutput komplett entfernt - CTRL_PID.CNF->E_D_FF_ANY.CLK bleibt intern bestehen (fuer das Latch von Y/DIFF/LIM), nur der externe CNF-Durchgriff entfaellt. RST unveraendert.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-09-19" Remarks="Bugfix: REQ hatte keine With-Verknuepfung zu SUP/OFS/LL/LH (IEC 61499 - ungebundene Vars werden nicht zuverlaessig gelesen), jetzt ergaenzt, gespiegelt vom inneren CTRL_PID. M_I/KP/TN/TV von InputVars auf AR-Adapter-Sockets umgestellt (Konsistenz mit AR_ACT/SET).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-12" Remarks="INIT/INITO entfernt (CTRL_PID kennt kein INIT, nur REQ/RST) - stattdessen echtes REQ-EventInput/CNF-EventOutput ergaenzt, direkt auf CTRL_PID.REQ/CNF gemappt. SET von InputVar auf AR-Socket umgestellt (dynamisch berechneter Sollwert, wie AR_ACT) - SET.E1 triggert CTRL_PID.REQ zusaetzlich zu AR_ACT.E1/AX_MAN.E1.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-12" Remarks="Initial implementation of CTRL_PID_AR wrapper FB">
	</VersionInfo>
