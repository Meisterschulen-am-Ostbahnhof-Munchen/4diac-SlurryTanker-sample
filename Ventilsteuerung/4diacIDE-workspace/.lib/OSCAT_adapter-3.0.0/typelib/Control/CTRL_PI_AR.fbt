<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="CTRL_PI_AR" Comment="AR-Adapter-Wrapper um OSCAT CTRL_PI - bruckt zwischen adapter und OSCAT&#10;PI-Regler. Istwert, Sollwert, Hand-Umschaltung, Handwert, Reglerparameter&#10;UND Rauschunterdrueckung/Offset/Grenzwerte vollstaendig als Adapter-Sockets -&#10;kein explizites REQ mehr noetig.">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.3" Author="Franz Höpfinger" Date="2026-10-03" Remarks="Franz: 'auch umstellen auf Adapter Only' (analog CTRL_PID_AR v1.3/1.4) - SUP/OFS/LL/LH von InputVars (REAL, With-gebunden an REQ) auf AR-Adapter-Sockets umgestellt (gleiches Muster wie KP/KI/M_I: *.E1 loest CTRL_PI.REQ aus, *.D1 liefert den Wert). Explizites REQ-EventInput (inkl. With-Bindungen) und CNF-EventOutput komplett entfernt - CTRL_PI.CNF->E_D_FF_ANY.CLK bleibt intern bestehen (fuer das Latch von Y/DIFF/LIM), nur der externe CNF-Durchgriff entfaellt. RST unveraendert. Sockets/Connections/Dokumentation zugleich auf die Reihenfolge der CTRL_PI-InputVars sortiert: AR_ACT, SET, SUP, OFS, M_I, AX_MAN, KP, KI, LL, LH.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.2" Author="Franz Höpfinger" Date="2026-09-19" Remarks="Bugfix: REQ hatte keine With-Verknuepfung zu SUP/OFS/LL/LH (IEC 61499 - ungebundene Vars werden nicht zuverlaessig gelesen), jetzt ergaenzt, gespiegelt vom inneren CTRL_PI. M_I/KP/KI von InputVars auf AR-Adapter-Sockets umgestellt (Konsistenz mit AR_ACT/SET).">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-09-15" Remarks="INIT/INITO entfernt (CTRL_PI kennt kein INIT, nur REQ/RST) - stattdessen echtes REQ-EventInput/CNF-EventOutput ergaenzt, direkt auf CTRL_PI.REQ/CNF gemappt. SET von InputVar auf AR-Socket umgestellt (dynamisch berechneter Sollwert, wie AR_ACT) - SET.E1 triggert CTRL_PI.REQ zusaetzlich zu AR_ACT.E1/AX_MAN.E1.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-12" Remarks="Initial implementation of CTRL_PI_AR wrapper FB">
	</VersionInfo>
