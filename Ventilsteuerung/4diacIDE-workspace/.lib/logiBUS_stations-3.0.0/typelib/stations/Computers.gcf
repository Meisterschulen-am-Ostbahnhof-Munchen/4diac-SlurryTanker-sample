	<OriginalSource><![CDATA[PACKAGE logiBUS::stations;

(*
 * Feste Verbindungsstrings bekannter Stationen/Rechner im logiBUS-Netzwerk,
 * damit Projekte nicht mit literalen IP-Adressen arbeiten muessen. Zwei Protokoll-Formen kommen
 * vor:
 *   - 61499  ("IP:61499", z.B. als MGR_ID fuer ein FORTE_PC-Device)
 *   - OPC-UA ("opc.tcp://IP:4840")
 * *
 *)
GLOBALCONSTANTS Computers
	VAR_GLOBAL CONSTANT
		C_LO : WSTRING := "localhost:61499";
		C_ET : WSTRING := "192.168.5.1:61499";
		C_ST : WSTRING := "192.168.4.1:61499";
		C_01 : WSTRING := "192.168.4.1:61499"; (* Station 01 (61499/MGR_ID) *)
		C_02 : WSTRING := "192.168.4.2:61499"; (* Station 02 (61499/MGR_ID) *)
		C_03 : WSTRING := "192.168.4.3:61499"; (* Station 03 (61499/MGR_ID) *)
		C_04 : WSTRING := "192.168.4.4:61499"; (* Station 04 (61499/MGR_ID) *)
		C_TR : WSTRING := "192.168.6.1:61499"; (* Trainings-PC (61499/MGR_ID) *)
		C_SI : WSTRING := "192.168.6.2:61499"; (* Simulator-PC (61499/MGR_ID) *)
		C_11 : WSTRING := "192.168.1.11:61499"; (* Station 11 (61499/MGR_ID) *)
		C_12 : WSTRING := "192.168.1.12:61499"; (* Station 12 (61499/MGR_ID) *)
		C_13 : WSTRING := "192.168.1.13:61499"; (* Station 13 (61499/MGR_ID) *)
		C_14 : WSTRING := "192.168.1.14:61499"; (* Station 14 (61499/MGR_ID) *)
		C_15 : WSTRING := "192.168.1.15:61499"; (* Station 15 (61499/MGR_ID) *)
		C_55 : WSTRING := "192.168.178.55:61499"; (* Station 55 (61499/MGR_ID) *)
		C_11_OPC : WSTRING := "opc.tcp://192.168.1.11:4840"; (* Station 11 (OPC-UA-Endpunkt) *)
		C_12_OPC : WSTRING := "opc.tcp://192.168.1.12:4840"; (* Station 12 (OPC-UA-Endpunkt) *)
		C_13_OPC : WSTRING := "opc.tcp://192.168.1.13:4840"; (* Station 13 (OPC-UA-Endpunkt) *)
		C_14_OPC : WSTRING := "opc.tcp://192.168.1.14:4840"; (* Station 14 (OPC-UA-Endpunkt) *)
		C_15_OPC : WSTRING := "opc.tcp://192.168.1.15:4840"; (* Station 15 (OPC-UA-Endpunkt) *)
	END_VAR
END_GLOBALCONSTANTS
]]></OriginalSource>
