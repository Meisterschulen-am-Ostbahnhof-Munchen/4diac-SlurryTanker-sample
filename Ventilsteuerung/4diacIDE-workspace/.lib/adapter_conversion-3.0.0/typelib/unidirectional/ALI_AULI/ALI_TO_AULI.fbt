<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ALI_TO_AULI" Comment="Composite FB for converting ALI (LINT) adapter to AULI (ULINT) adapter — numeric&#10;conversion (value-preserving cast; narrowing may truncate,&#10;widening/sign-extension is safe).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-02-17">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="AULI_OUT" Type="adapter::types::unidirectional::AULI" Comment="ULINT Adapter Output" x="2300" y="0"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="ALI_IN" Type="adapter::types::unidirectional::ALI" Comment="LINT Adapter Input" x="0" y="0"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="Convert" Type="iec61131::conversion::F_LINT_TO_ULINT" x="1000" y="0">
		</FB>
		<EventConnections>
			<Connection Source="ALI_IN.E1" Destination="Convert.REQ" dx1="100"/>
			<Connection Source="Convert.CNF" Destination="AULI_OUT.E1" dx1="100"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="ALI_IN.D1" Destination="Convert.IN" dx1="100"/>
			<Connection Source="Convert.OUT" Destination="AULI_OUT.D1" dx1="100"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
