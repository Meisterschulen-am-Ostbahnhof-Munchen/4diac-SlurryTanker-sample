	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="SET_OUT" Type="adapter::types::unidirectional::AE" Comment="Set / Switch on" x="0" y="-900"/>
			<AdapterDeclaration Name="RESET_OUT" Type="adapter::types::unidirectional::AE" Comment="Reset / Switch off" x="0" y="-100"/>
			<AdapterDeclaration Name="TOGGLE_OUT" Type="adapter::types::unidirectional::AE" Comment="Toggle / Switch output" x="0" y="700"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="ASRT_IN" Type="adapter::types::unidirectional::ASRT" Comment="Adapter Input" x="-3900" y="-700"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="ASRT_IN.SET" Destination="SET_OUT.E1" dx1="1473.33"/>
			<Connection Source="ASRT_IN.RESET" Destination="RESET_OUT.E1" dx1="1473.33"/>
			<Connection Source="ASRT_IN.TOGGLE" Destination="TOGGLE_OUT.E1" dx1="1473.33"/>
		</EventConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
