<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ASRT_SRT_TO_3EVENTS" Comment="Composite FB for convert ASRT to 3 EVENTS">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH &#10; &#10;This program and the accompanying materials are made &#10;available under the terms of the Eclipse Public License 2.0 &#10;which is available at https://www.eclipse.org/legal/epl-2.0/ &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-03">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<EventOutputs>
			<Event Name="SET" Type="Event" Comment="Set / Switch on">
			</Event>
			<Event Name="RESET" Type="Event" Comment="Reset / Switch off">
			</Event>
			<Event Name="TOGGLE" Type="Event" Comment="Toggle / Switch output">
			</Event>
		</EventOutputs>
		<Sockets>
			<AdapterDeclaration Name="ASRT_IN" Type="adapter::types::unidirectional::ASRT" Comment="Adapter Input" x="0" y="-700"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="ASRT_IN.SET" Destination="SET" dx1="1473.33"/>
			<Connection Source="ASRT_IN.RESET" Destination="RESET" dx1="1473.33"/>
			<Connection Source="ASRT_IN.TOGGLE" Destination="TOGGLE" dx1="1473.33"/>
		</EventConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
