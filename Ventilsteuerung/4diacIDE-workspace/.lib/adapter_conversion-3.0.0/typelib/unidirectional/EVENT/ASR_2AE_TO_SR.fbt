	<CompilerInfo packageName="adapter::conversion::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="ASR_OUT" Type="adapter::types::unidirectional::ASR" Comment="Adapter Output" x="-3900" y="-500"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="SET_IN" Type="adapter::types::unidirectional::AE" Comment="Set / Switch on" x="0" y="-900"/>
			<AdapterDeclaration Name="RESET_IN" Type="adapter::types::unidirectional::AE" Comment="Reset / Switch off" x="0" y="-100"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="SET_IN.E1" Destination="ASR_OUT.SET" dx1="2813.33"/>
			<Connection Source="RESET_IN.E1" Destination="ASR_OUT.RESET" dx1="2413.33"/>
		</EventConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
