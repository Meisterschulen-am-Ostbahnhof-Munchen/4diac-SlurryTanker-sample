<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ASRT_3AE_TO_SRT" Comment="Composite FB for convert 3 AE to ASRT">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH &#10; &#10;This program and the accompanying materials are made &#10;available under the terms of the Eclipse Public License 2.0 &#10;which is available at https://www.eclipse.org/legal/epl-2.0/ &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-06">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="ASRT_OUT" Type="adapter::types::unidirectional::ASRT" Comment="Adapter Output" x="-2100" y="-400"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="SET_IN" Type="adapter::types::unidirectional::AE" Comment="Set / Switch on" x="-3700" y="-700"/>
			<AdapterDeclaration Name="RESET_IN" Type="adapter::types::unidirectional::AE" Comment="Reset / Switch off" x="-3700" y="-300"/>
			<AdapterDeclaration Name="TOGGLE_IN" Type="adapter::types::unidirectional::AE" Comment="Toggle / Switch output" x="-3700" y="100"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="SET_IN.E1" Destination="ASRT_OUT.SET" dx1="606.67"/>
			<Connection Source="RESET_IN.E1" Destination="ASRT_OUT.RESET" dx1="606.67"/>
			<Connection Source="TOGGLE_IN.E1" Destination="ASRT_OUT.TOGGLE" dx1="600"/>
		</EventConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
