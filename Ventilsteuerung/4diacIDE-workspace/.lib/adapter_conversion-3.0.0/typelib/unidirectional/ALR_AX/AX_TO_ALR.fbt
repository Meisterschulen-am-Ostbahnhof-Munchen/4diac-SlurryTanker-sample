<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AX_TO_ALR" Comment="Composite FB for converting AX (BOOL) adapter to ALR (LREAL) adapter using F_SEL&#10;— numeric conversion (value-preserving cast; narrowing may truncate,&#10;widening/sign-extension is safe).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-02-17">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="ALR_OUT" Type="adapter::types::unidirectional::ALR" Comment="LREAL Adapter Output" x="2300" y="0"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="AX_IN" Type="adapter::types::unidirectional::AX" Comment="BOOL Adapter Input" x="0" y="0"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<FB Name="Selection" Type="iec61131::selection::F_SEL" x="1000" y="0">
			<Parameter Name="IN0" Value="LREAL#0.0"/>
			<Parameter Name="IN1" Value="LREAL#1.0"/>
		</FB>
		<EventConnections>
			<Connection Source="AX_IN.E1" Destination="Selection.REQ" dx1="100"/>
			<Connection Source="Selection.CNF" Destination="ALR_OUT.E1" dx1="100"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="AX_IN.D1" Destination="Selection.G" dx1="100"/>
			<Connection Source="Selection.OUT" Destination="ALR_OUT.D1" dx1="100"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
