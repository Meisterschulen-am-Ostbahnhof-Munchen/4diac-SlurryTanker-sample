<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AUS_TO_AUDI" Comment="Composite FB for converting AUS (USINT) adapter to AUDI (UDINT) adapter —&#10;numeric conversion (value-preserving cast; narrowing may truncate,&#10;widening/sign-extension is safe).">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-02-17">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="AUDI_OUT" Type="adapter::types::unidirectional::AUDI" Comment="UDINT Adapter Output" x="2300" y="0"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="AUS_IN" Type="adapter::types::unidirectional::AUS" Comment="USINT Adapter Input" x="0" y="0"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="AUS_IN.E1" Destination="AUDI_OUT.E1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="AUS_IN.D1" Destination="AUDI_OUT.D1"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
