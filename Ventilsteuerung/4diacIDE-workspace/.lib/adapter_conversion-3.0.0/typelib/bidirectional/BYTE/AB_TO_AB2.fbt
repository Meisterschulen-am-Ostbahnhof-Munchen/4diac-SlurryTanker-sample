<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AB_TO_AB2" Comment="Composite FB for convert unidirectional AB to bidirectional AB2">
	<Identification Standard="61499-2" Function="AB_IN publishes its value onto the outgoing (EO1) side of AB2_BIDIR. Whatever AB2_BIDIR receives on its incoming (EI1) side is forwarded out again as a plain unidirectional signal via AB_OUT." Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="Initial Version">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="AB_IN" Type="adapter::types::unidirectional::AB" Comment="Adapter Input: unidirectional source" x="-1200" y="900"/>
		</Sockets>
		<Plugs>
			<AdapterDeclaration Name="AB2_BIDIR" Type="adapter::types::bidirectional::AB2" Comment="Adapter Output: bidirectional tap, outgoing side driven by AB_IN, incoming side forwarded to AB_OUT" x="200" y="900"/>
			<AdapterDeclaration Name="AB_OUT" Type="adapter::types::unidirectional::AB" Comment="Adapter Output: mirrors AB2_BIDIR's incoming (request) side" x="1600" y="900"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="AB_IN.E1" Destination="AB2_BIDIR.EO1"/>
			<Connection Source="AB2_BIDIR.EI1" Destination="AB_OUT.E1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="AB_IN.D1" Destination="AB2_BIDIR.DO1"/>
			<Connection Source="AB2_BIDIR.DI1" Destination="AB_OUT.D1"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
