<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AD_TO_AD2" Comment="Composite FB for convert unidirectional AD to bidirectional AD2">
	<Identification Standard="61499-2" Function="AD_IN publishes its value onto the outgoing (EO1) side of AD2_BIDIR. Whatever AD2_BIDIR receives on its incoming (EI1) side is forwarded out again as a plain unidirectional signal via AD_OUT." Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-10-13" Remarks="Initial Version - Konvertierungsfamilie vervollstaendigt (analog zu AUI_TO_AUI2/AR_TO_AR2/AB_TO_AB2).">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="AD_IN" Type="adapter::types::unidirectional::AD" Comment="Adapter Input: unidirectional source" x="-1200" y="900"/>
		</Sockets>
		<Plugs>
			<AdapterDeclaration Name="AD2_BIDIR" Type="adapter::types::bidirectional::AD2" Comment="Adapter Output: bidirectional tap, outgoing side driven by AD_IN, incoming side forwarded to AD_OUT" x="200" y="900"/>
			<AdapterDeclaration Name="AD_OUT" Type="adapter::types::unidirectional::AD" Comment="Adapter Output: mirrors AD2_BIDIR's incoming (request) side" x="1600" y="900"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="AD_IN.E1" Destination="AD2_BIDIR.EO1"/>
			<Connection Source="AD2_BIDIR.EI1" Destination="AD_OUT.E1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="AD_IN.D1" Destination="AD2_BIDIR.DO1"/>
			<Connection Source="AD2_BIDIR.DI1" Destination="AD_OUT.D1"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
