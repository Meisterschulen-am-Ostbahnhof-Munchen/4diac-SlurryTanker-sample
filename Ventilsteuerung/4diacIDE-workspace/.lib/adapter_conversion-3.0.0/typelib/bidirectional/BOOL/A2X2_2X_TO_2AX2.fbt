	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="UP" Type="adapter::types::bidirectional::AX2" Comment="TRUE = forward, up, right, clockwise" x="-300" y="600"/>
			<AdapterDeclaration Name="DOWN" Type="adapter::types::bidirectional::AX2" Comment="TRUE = backward, down, left, counter-clockwise" x="-300" y="1900"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="A2X2_IN" Type="adapter::types::bidirectional::A2X2" Comment="Adapter Input" x="-513.33" y="1186.67"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="A2X2_IN.EO_UP" Destination="UP.EO1" dx1="80" dx2="80" dy="-293.33"/>
			<Connection Source="UP.EI1" Destination="A2X2_IN.EI_UP" dx1="80" dx2="80" dy="293.33"/>
			<Connection Source="A2X2_IN.EO_DOWN" Destination="DOWN.EO1" dx1="80" dx2="80" dy="300"/>
			<Connection Source="DOWN.EI1" Destination="A2X2_IN.EI_DOWN" dx1="80" dx2="80" dy="-300"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="A2X2_IN.DO_UP" Destination="UP.DO1" dx1="80" dx2="80" dy="-346.67"/>
			<Connection Source="UP.DI1" Destination="A2X2_IN.DI_UP" dx1="80" dx2="80" dy="346.67"/>
			<Connection Source="A2X2_IN.DO_DOWN" Destination="DOWN.DO1" dx1="80" dx2="80" dy="246.67"/>
			<Connection Source="DOWN.DI1" Destination="A2X2_IN.DI_DOWN" dx1="80" dx2="80" dy="-246.67"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
