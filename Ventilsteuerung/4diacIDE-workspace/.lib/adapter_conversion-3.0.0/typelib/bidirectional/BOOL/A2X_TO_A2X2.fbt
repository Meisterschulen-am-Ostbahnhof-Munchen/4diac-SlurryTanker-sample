<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="A2X_TO_A2X2" Comment="Composite FB for convert unidirectional A2X to bidirectional A2X2">
	<Identification Standard="61499-2" Function="A2X_IN publishes UP/DOWN onto the outgoing (EO_UP/EO_DOWN) side of A2X2_BIDIR. Whatever A2X2_BIDIR receives on its incoming (EI_UP/EI_DOWN) side is forwarded out again as a plain unidirectional signal via A2X_OUT." Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="Initial Version">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="A2X_IN" Type="adapter::types::unidirectional::A2X" Comment="Adapter Input: unidirectional UP/DOWN source" x="-1200" y="900"/>
		</Sockets>
		<Plugs>
			<AdapterDeclaration Name="A2X2_BIDIR" Type="adapter::types::bidirectional::A2X2" Comment="Adapter Output: bidirectional tap, outgoing side driven by A2X_IN, incoming side forwarded to A2X_OUT" x="200" y="900"/>
			<AdapterDeclaration Name="A2X_OUT" Type="adapter::types::unidirectional::A2X" Comment="Adapter Output: mirrors A2X2_BIDIR's incoming (request) side" x="1600" y="900"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="A2X_IN.E_UP" Destination="A2X2_BIDIR.EO_UP"/>
			<Connection Source="A2X_IN.E_DOWN" Destination="A2X2_BIDIR.EO_DOWN"/>
			<Connection Source="A2X2_BIDIR.EI_UP" Destination="A2X_OUT.E_UP"/>
			<Connection Source="A2X2_BIDIR.EI_DOWN" Destination="A2X_OUT.E_DOWN"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="A2X_IN.UP" Destination="A2X2_BIDIR.DO_UP"/>
			<Connection Source="A2X_IN.DOWN" Destination="A2X2_BIDIR.DO_DOWN"/>
			<Connection Source="A2X2_BIDIR.DI_UP" Destination="A2X_OUT.UP"/>
			<Connection Source="A2X2_BIDIR.DI_DOWN" Destination="A2X_OUT.DOWN"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
