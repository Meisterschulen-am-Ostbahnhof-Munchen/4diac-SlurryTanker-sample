<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="A2X2_2X_TO_4AX" Comment="Composite FB for convert A2X2 to 4 AX">
	<Identification Standard="61499-2" Function="A2X2 has 2 channels (UP/DOWN), each bidirectional, so it takes 4 unidirectional AX to represent it: IND_UP/IND_DOWN carry what A2X2 receives (its EO_UP/EO_DOWN indication side), REQ_UP/REQ_DOWN carry what gets sent out through A2X2 (its EI_UP/EI_DOWN request side)." Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="Initial Version">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="IND_UP" Type="adapter::types::unidirectional::AX" Comment="Indication UP, published outward from A2X2_IN.EO_UP" x="1000" y="900"/>
			<AdapterDeclaration Name="IND_DOWN" Type="adapter::types::unidirectional::AX" Comment="Indication DOWN, published outward from A2X2_IN.EO_DOWN" x="1000" y="1400"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="A2X2_IN" Type="adapter::types::bidirectional::A2X2" Comment="Adapter Input" x="-1200" y="900"/>
			<AdapterDeclaration Name="REQ_UP" Type="adapter::types::unidirectional::AX" Comment="Request UP, received from outside, forwarded into A2X2_IN.EI_UP" x="-2100" y="800"/>
			<AdapterDeclaration Name="REQ_DOWN" Type="adapter::types::unidirectional::AX" Comment="Request DOWN, received from outside, forwarded into A2X2_IN.EI_DOWN" x="-2100" y="1300"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="A2X2_IN.EO_UP" Destination="IND_UP.E1"/>
			<Connection Source="A2X2_IN.EO_DOWN" Destination="IND_DOWN.E1" dx1="133.33"/>
			<Connection Source="REQ_UP.E1" Destination="A2X2_IN.EI_UP" dx1="133.33"/>
			<Connection Source="REQ_DOWN.E1" Destination="A2X2_IN.EI_DOWN" dx1="133.33"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="A2X2_IN.DO_UP" Destination="IND_UP.D1" dx1="66.67"/>
			<Connection Source="A2X2_IN.DO_DOWN" Destination="IND_DOWN.D1" dx1="66.67"/>
			<Connection Source="REQ_UP.D1" Destination="A2X2_IN.DI_UP" dx1="66.67"/>
			<Connection Source="REQ_DOWN.D1" Destination="A2X2_IN.DI_DOWN" dx1="66.67"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
