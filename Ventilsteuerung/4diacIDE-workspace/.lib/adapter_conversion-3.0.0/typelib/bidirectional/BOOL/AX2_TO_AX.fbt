<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AX2_TO_AX" Comment="Composite FB for convert bidirectional AX2 to unidirectional AX">
	<Identification Standard="61499-2" Function="AX2_BIDIR forwards its incoming (EO1) side out as a plain unidirectional signal via AX_OUT. AX_IN publishes its value onto the outgoing (EI1) side of AX2_BIDIR." Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="Initial Version">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="AX2_BIDIR" Type="adapter::types::bidirectional::AX2" Comment="Adapter Input: bidirectional tap, incoming side forwarded to AX_OUT, outgoing side driven by AX_IN" x="-1200" y="900"/>
			<AdapterDeclaration Name="AX_IN" Type="adapter::types::unidirectional::AX" Comment="Adapter Input: unidirectional source" x="-2200" y="900"/>
		</Sockets>
		<Plugs>
			<AdapterDeclaration Name="AX_OUT" Type="adapter::types::unidirectional::AX" Comment="Adapter Output: mirrors AX2_BIDIR's incoming (indication) side" x="100" y="900"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="AX2_BIDIR.EO1" Destination="AX_OUT.E1"/>
			<Connection Source="AX_IN.E1" Destination="AX2_BIDIR.EI1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="AX2_BIDIR.DO1" Destination="AX_OUT.D1"/>
			<Connection Source="AX_IN.D1" Destination="AX2_BIDIR.DI1"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
