<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="A2X2_4AX_TO_2X" Comment="Composite FB for convert 4 AX to A2X2">
	<Identification Standard="61499-2" Function="A2X2 has 2 channels (UP/DOWN), each bidirectional, so it takes 4 unidirectional AX to represent it: IND_UP/IND_DOWN carry what gets published by A2X2_OUT (its EO_UP/EO_DOWN indication side), REQ_UP/REQ_DOWN carry what A2X2_OUT receives back (its EI_UP/EI_DOWN request side)." Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="Initial Version">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="A2X2_OUT" Type="adapter::types::bidirectional::A2X2" Comment="Adapter Output" x="700" y="1300"/>
			<AdapterDeclaration Name="REQ_UP" Type="adapter::types::unidirectional::AX" Comment="Request UP, published outward from A2X2_OUT.EI_UP" x="2500" y="1300"/>
			<AdapterDeclaration Name="REQ_DOWN" Type="adapter::types::unidirectional::AX" Comment="Request DOWN, published outward from A2X2_OUT.EI_DOWN" x="2500" y="1800"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="IND_UP" Type="adapter::types::unidirectional::AX" Comment="Indication UP, received from outside, forwarded into A2X2_OUT.EO_UP" x="-1200" y="1200"/>
			<AdapterDeclaration Name="IND_DOWN" Type="adapter::types::unidirectional::AX" Comment="Indication DOWN, received from outside, forwarded into A2X2_OUT.EO_DOWN" x="-1200" y="1700"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="IND_UP.E1" Destination="A2X2_OUT.EO_UP" dx1="133.33"/>
			<Connection Source="IND_DOWN.E1" Destination="A2X2_OUT.EO_DOWN" dx1="133.33"/>
			<Connection Source="A2X2_OUT.EI_UP" Destination="REQ_UP.E1"/>
			<Connection Source="A2X2_OUT.EI_DOWN" Destination="REQ_DOWN.E1" dx1="133.33"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="IND_UP.D1" Destination="A2X2_OUT.DO_UP" dx1="66.67"/>
			<Connection Source="IND_DOWN.D1" Destination="A2X2_OUT.DO_DOWN" dx1="66.67"/>
			<Connection Source="A2X2_OUT.DI_UP" Destination="REQ_UP.D1" dx1="66.67"/>
			<Connection Source="A2X2_OUT.DI_DOWN" Destination="REQ_DOWN.D1" dx1="66.67"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
