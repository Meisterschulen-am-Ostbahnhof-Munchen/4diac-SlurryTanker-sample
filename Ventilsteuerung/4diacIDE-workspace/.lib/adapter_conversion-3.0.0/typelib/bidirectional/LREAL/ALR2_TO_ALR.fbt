<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="ALR2_TO_ALR" Comment="Composite FB for convert bidirectional ALR2 to unidirectional ALR">
	<Identification Standard="61499-2" Function="ALR2_BIDIR forwards its incoming (EO1) side out as a plain unidirectional signal via ALR_OUT. ALR_IN publishes its value onto the outgoing (EI1) side of ALR2_BIDIR." Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-12" Remarks="Initial Version - Konvertierungsfamilie vervollstaendigt (analog zu AR2/AB2/AE2).">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="ALR2_BIDIR" Type="adapter::types::bidirectional::ALR2" Comment="Adapter Input: bidirectional tap, incoming side forwarded to ALR_OUT, outgoing side driven by ALR_IN" x="-1200" y="900"/>
			<AdapterDeclaration Name="ALR_IN" Type="adapter::types::unidirectional::ALR" Comment="Adapter Input: unidirectional source" x="-2200" y="900"/>
		</Sockets>
		<Plugs>
			<AdapterDeclaration Name="ALR_OUT" Type="adapter::types::unidirectional::ALR" Comment="Adapter Output: mirrors ALR2_BIDIR's incoming (indication) side" x="100" y="900"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="ALR2_BIDIR.EO1" Destination="ALR_OUT.E1"/>
			<Connection Source="ALR_IN.E1" Destination="ALR2_BIDIR.EI1"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="ALR2_BIDIR.DO1" Destination="ALR_OUT.D1"/>
			<Connection Source="ALR_IN.D1" Destination="ALR2_BIDIR.DI1"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
