<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AE2_TO_AE" Comment="Composite FB for convert bidirectional AE2 to unidirectional AE">
	<Identification Standard="61499-2" Function="AE2_BIDIR forwards its incoming (EO1) side out as a plain unidirectional event via AE_OUT. AE_IN publishes its event onto the outgoing (EI1) side of AE2_BIDIR." Description="Copyright (c) 2026 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-08-31" Remarks="Initial Version">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Sockets>
			<AdapterDeclaration Name="AE2_BIDIR" Type="adapter::types::bidirectional::AE2" Comment="Adapter Input: bidirectional tap, incoming side forwarded to AE_OUT, outgoing side driven by AE_IN" x="-1200" y="900"/>
			<AdapterDeclaration Name="AE_IN" Type="adapter::types::unidirectional::AE" Comment="Adapter Input: unidirectional source" x="-2200" y="900"/>
		</Sockets>
		<Plugs>
			<AdapterDeclaration Name="AE_OUT" Type="adapter::types::unidirectional::AE" Comment="Adapter Output: mirrors AE2_BIDIR's incoming (indication) side" x="100" y="900"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="AE2_BIDIR.EO1" Destination="AE_OUT.E1"/>
			<Connection Source="AE_IN.E1" Destination="AE2_BIDIR.EI1"/>
		</EventConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
