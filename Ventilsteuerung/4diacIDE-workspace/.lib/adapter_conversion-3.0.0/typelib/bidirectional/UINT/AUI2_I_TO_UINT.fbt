<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="AUI2_I_TO_UINT" Comment="Composite FB for convert AUI2 to UINT">
	<Identification Standard="61499-2" Description="Copyright (c) 2024 HR Agrartechnik GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-12" Remarks="Initial Version - Konvertierungsfamilie vervollstaendigt (analog zu AR2/AB2/AE2).">
	</VersionInfo>
	<CompilerInfo packageName="adapter::conversion::bidirectional">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Request to Adapter">
				<With Var="OUT"/>
				<Attribute Name="YPOSITION" Type="DINT" Value="46"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Confirmation from Adapter">
				<With Var="IN"/>
				<Attribute Name="YPOSITION" Type="DINT" Value="46"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="OUT" Type="UINT">
				<Attribute Name="YPOSITION" Type="DINT" Value="31"/>
			</VarDeclaration>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="IN" Type="UINT" Comment="Input data from Adapter">
				<Attribute Name="YPOSITION" Type="DINT" Value="47"/>
			</VarDeclaration>
		</OutputVars>
		<Sockets>
			<AdapterDeclaration Name="AUI2_IN" Type="adapter::types::bidirectional::AUI2" Comment="Adapter Input" x="700" y="-700"/>
		</Sockets>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="AUI2_IN.EO1" Destination="CNF" dx1="2293.33"/>
			<Connection Source="REQ" Destination="AUI2_IN.EI1" dx1="2788.24"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="AUI2_IN.DO1" Destination="IN" dx1="2293.33"/>
			<Connection Source="OUT" Destination="AUI2_IN.DI1" dx1="2070.59"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
