<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="FsMkDir" Comment="Create a directory on the file server">
	<Identification Standard="61499-2" Description="Uses iso_FscOpenFile() with the flags directory and create, then iso_FscCloseFile() (ISO 11783-13 has no own command). \n&#10;Missing parent directories are created too. \n&#10;Client is NmDestin.s16OwnCfHnd, file server is NmDestin.s16Handle (e.g. found with NmGetCfInfo, NAME function 61). \n&#10;The FB opens its own io channel to the server and closes it at the end. One job at a time: REQ during a job gives ERR with s16Status E_BUSY. \n&#10;Every REQ ends with exactly one CNF or ERR.">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-11-26" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="isobus::fs">
		<Import declaration="isobus::pgn::ISONETEVENT_T"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
			</Event>
			<Event Name="REQ" Type="Event" Comment="Create the directory">
				<With Var="NmDestin"/>
				<With Var="sRemotePath"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
			<Event Name="CNF" Type="Event" Comment="Directory created">
			</Event>
			<Event Name="ERR" Type="Event" Comment="Job failed">
				<With Var="s16Status"/>
				<With Var="u16FsError"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="NmDestin" Type="isobus::pgn::ISONETEVENT_T" Comment="Client (s16OwnCfHnd) and file server (s16Handle)"/>
			<VarDeclaration Name="sRemotePath" Type="STRING" Comment="Directory on the file server"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="s16Status" Type="INT" Comment="With ERR: driver return value or own error (E_BUSY, E_RANGE, E_CONFIG)"/>
			<VarDeclaration Name="u16FsError" Type="UINT" Comment="With ERR: file server or client error (ISO 11783-13 B.9, 6400 ff. client)"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
