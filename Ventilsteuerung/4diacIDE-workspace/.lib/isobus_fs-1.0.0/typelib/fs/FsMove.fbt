<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="FsMove" Comment="Rename, move or copy a file or directory on the file server">
	<Identification Standard="61499-2" Description="Uses iso_FscMoveFile() of the CCI ISOBUS driver (ISO 11783-13). The server copies or moves itself, no data goes over the bus. \n&#10;Client is NmDestin.s16OwnCfHnd, file server is NmDestin.s16Handle (e.g. found with NmGetCfInfo, NAME function 61). \n&#10;The FB opens its own io channel to the server and closes it at the end. One job at a time: REQ during a job gives ERR with s16Status E_BUSY. \n&#10;Every REQ ends with exactly one CNF or ERR.">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-11-26" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="isobus::fs">
		<Import declaration="isobus::pgn::ISONETEVENT_T"/>
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
			</Event>
			<Event Name="REQ" Type="Event" Comment="Move or copy">
				<With Var="NmDestin"/>
				<With Var="sSourcePath"/>
				<With Var="sDestPath"/>
				<With Var="bCopy"/>
				<With Var="bForce"/>
				<With Var="bRecursive"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
			<Event Name="CNF" Type="Event" Comment="Moved or copied">
			</Event>
			<Event Name="ERR" Type="Event" Comment="Job failed">
				<With Var="s16Status"/>
				<With Var="u16FsError"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="NmDestin" Type="isobus::pgn::ISONETEVENT_T" Comment="Client (s16OwnCfHnd) and file server (s16Handle)"/>
			<VarDeclaration Name="sSourcePath" Type="STRING" Comment="Source on the file server"/>
			<VarDeclaration Name="sDestPath" Type="STRING" Comment="Destination on the file server"/>
			<VarDeclaration Name="bCopy" Type="BOOL" Comment="TRUE: copy instead of move"/>
			<VarDeclaration Name="bForce" Type="BOOL" Comment="TRUE: overwrite an existing destination"/>
			<VarDeclaration Name="bRecursive" Type="BOOL" Comment="TRUE: directory with its content"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="s16Status" Type="INT" Comment="With ERR: driver return value or own error (E_BUSY, E_RANGE, E_CONFIG)"/>
			<VarDeclaration Name="u16FsError" Type="UINT" Comment="With ERR: file server or client error (ISO 11783-13 B.9, 6400 ff. client)"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
