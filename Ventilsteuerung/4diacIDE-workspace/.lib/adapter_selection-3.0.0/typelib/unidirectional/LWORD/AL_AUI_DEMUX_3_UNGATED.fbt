			<AdapterDeclaration Name="OUT1" Type="adapter::types::unidirectional::AL" Comment="Output value 1 (selected when K = 0)"/>
			<AdapterDeclaration Name="OUT2" Type="adapter::types::unidirectional::AL" Comment="Output value 2 (selected when K = 1)"/>
			<AdapterDeclaration Name="OUT3" Type="adapter::types::unidirectional::AL" Comment="Output value 3 (selected when K = 2)"/>
