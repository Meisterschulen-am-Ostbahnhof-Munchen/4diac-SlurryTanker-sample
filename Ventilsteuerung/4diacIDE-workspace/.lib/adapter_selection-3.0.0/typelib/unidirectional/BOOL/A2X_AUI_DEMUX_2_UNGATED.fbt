	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-09-11" Remarks="A2X-Variante von AX_AUI_DEMUX_2_UNGATED - Adapter-Backend GEN_A2X_AUI_DEMUX noch zu implementieren.">
	</VersionInfo>
	<CompilerInfo packageName="adapter::selection::unidirectional">
	</CompilerInfo>
	<InterfaceList>
		<Plugs>
			<AdapterDeclaration Name="OUT1" Type="adapter::types::unidirectional::A2X" Comment="Output value 1 (selected when K = 0)"/>
			<AdapterDeclaration Name="OUT2" Type="adapter::types::unidirectional::A2X" Comment="Output value 2 (selected when K = 1)"/>
		</Plugs>
		<Sockets>
			<AdapterDeclaration Name="K" Type="adapter::types::unidirectional::AUI" Comment="index"/>
			<AdapterDeclaration Name="IN" Type="adapter::types::unidirectional::A2X" Comment="Input Value to demultiplex"/>
		</Sockets>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::GenericClassName" Value="'GEN_A2X_AUI_DEMUX'"/>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
