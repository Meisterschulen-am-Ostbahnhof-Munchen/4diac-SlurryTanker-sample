<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="A2X_AUI_DEMUX_2_UNGATED" Comment="Wie A2X_AUI_DEMUX_2, aber OHNE Aenderungserkennung - reicht JEDES neu berechnete&#10;Ergebnis bedingungslos weiter (fuer Verbraucher, die eine periodische Kadenz&#10;unabhaengig von Wertaenderung brauchen, z.B. Ableitungs-/Frequenzberechnungen).&#10;(A2X demultiplexor (generic FB))">
