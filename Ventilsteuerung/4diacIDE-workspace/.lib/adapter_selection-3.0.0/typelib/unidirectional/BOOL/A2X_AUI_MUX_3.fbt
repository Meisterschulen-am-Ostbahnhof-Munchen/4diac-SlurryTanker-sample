<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="A2X_AUI_MUX_3" Comment="A2X multiplexor (generic FB) Adapter-Ausgang wird nur bei Wertänderung&#10;aktualisiert (Event nur bei tatsächlicher Änderung).">
