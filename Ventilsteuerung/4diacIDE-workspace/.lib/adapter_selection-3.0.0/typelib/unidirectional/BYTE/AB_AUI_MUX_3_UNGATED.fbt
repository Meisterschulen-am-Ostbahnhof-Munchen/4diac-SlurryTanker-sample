			<AdapterDeclaration Name="K" Type="adapter::types::unidirectional::AUI" Comment="index"/>
			<AdapterDeclaration Name="IN1" Type="adapter::types::unidirectional::AB" Comment="Input value 1 (selected when K = 0)"/>
			<AdapterDeclaration Name="IN2" Type="adapter::types::unidirectional::AB" Comment="Input value 2 (selected when K = 1)"/>
			<AdapterDeclaration Name="IN3" Type="adapter::types::unidirectional::AB" Comment="Input value 3 (selected when K = 2)"/>
		</Sockets>
