<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="FB_AR_RANDOM" Comment="Wrapper around FB_RANDOM with AR adapter output plug">
	<Identification Standard="61499-1" Description="Copyright (c) 2026 HR Agrartechnik GmbH&#10;&#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="HR Agrartechnik GmbH" Version="1.0" Author="Franz Höpfinger" Date="2026-09-10" Remarks="Initial Version">
	</VersionInfo>
	<CompilerInfo packageName="adapter::utils">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Initialization Request">
				<With Var="SEED"/>
			</Event>
			<Event Name="REQ" Type="Event" Comment="Normal Execution Request">
				<With Var="SEED"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="SEED" Type="UINT" InitialValue="0" Comment="Seed Value"/>
		</InputVars>
		<Plugs>
			<AdapterDeclaration Name="OUT" Type="adapter::types::unidirectional::AR" Comment="AR adapter output plug" x="2200" y="0"/>
		</Plugs>
	</InterfaceList>
	<FBNetwork>
		<FB Name="FB_RANDOM" Type="eclipse4diac::utils::FB_RANDOM" x="400" y="0">
		</FB>
		<EventConnections>
			<Connection Source="INIT" Destination="INITO" dx1="200"/>
			<Connection Source="REQ" Destination="FB_RANDOM.REQ" dx1="200"/>
			<Connection Source="FB_RANDOM.CNF" Destination="OUT.E1" dx1="300"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="SEED" Destination="FB_RANDOM.SEED" dx1="200"/>
			<Connection Source="FB_RANDOM.VAL" Destination="OUT.D1" dx1="300"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
