	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.1" Author="Franz Höpfinger" Date="2026-10-11" Remarks="Copyright-Header, Classification und Remarks nachgezogen; Doku ergaenzt. Interne Umsetzung wrapt jetzt NOOP statt iec61131::selection::F_MOVE - damit entfaellt dieser iec61131-3-Abhaengigkeitspfad.">
	</VersionInfo>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="franz" Date="2026-05-05" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="iec61131::booleanOperators">
	</CompilerInfo>
