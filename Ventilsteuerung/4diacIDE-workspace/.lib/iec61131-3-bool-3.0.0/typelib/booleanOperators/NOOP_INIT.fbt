<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="NOOP_INIT" Comment="No-Op, auch bekannt als &quot;No Operation&quot; mit INIT - wrapt NOOP, reicht INIT direkt auf INITO durch">
