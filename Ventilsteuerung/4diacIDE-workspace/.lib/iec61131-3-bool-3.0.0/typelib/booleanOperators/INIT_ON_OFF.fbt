<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="INIT_ON_OFF" Comment="E_TRIG Counterpart, erweitert um zwei eigenstaendige Pass-Throughs INIT_ON/INITO_ON (EInitOn) und INIT_OFF/INITO_OFF (EInitOff)">
	<Identification Standard="61131-3" Classification="standard boolean function" Description="Copyright (c) 2026 Meisterschulen am Ostbahnhof&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Organization="Meisterschulen am Ostbahnhof" Version="1.0" Author="Franz Höpfinger" Date="2026-10-11" Remarks="initial API and implementation and/or initial documentation. Basiert auf dem INIT.fbt Pass-Through-Muster, vereint die beiden Zusatzkanaele aus INIT_ON.fbt und INIT_OFF.fbt in einem FB.">
	</VersionInfo>
	<CompilerInfo packageName="iec61131::booleanOperators">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Initialization Request">
			</Event>
			<Event Name="INIT_ON" Type="EInitOn" Comment="Initialization Request, eigener Kanal unabhaengig von INIT">
			</Event>
			<Event Name="INIT_OFF" Type="EInitOff" Comment="Initialization Request, eigener Kanal unabhaengig von INIT">
			</Event>
			<Event Name="REQ" Type="Event" Comment="Service Request">
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
			</Event>
			<Event Name="INITO_ON" Type="EInitOn" Comment="Initialization Confirm, eigener Kanal unabhaengig von INITO">
			</Event>
			<Event Name="INITO_OFF" Type="EInitOff" Comment="Initialization Confirm, eigener Kanal unabhaengig von INITO">
			</Event>
			<Event Name="CNF" Type="Event" Comment="Confirmation of Requested Service">
			</Event>
		</EventOutputs>
	</InterfaceList>
	<FBNetwork>
		<EventConnections>
			<Connection Source="INIT" Destination="INITO"/>
			<Connection Source="REQ" Destination="CNF" dx1="3566.67"/>
			<Connection Source="INIT_ON" Destination="INITO_ON"/>
			<Connection Source="INIT_OFF" Destination="INITO_OFF"/>
		</EventConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
