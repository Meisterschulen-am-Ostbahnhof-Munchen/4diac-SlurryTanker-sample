<?xml version="1.0" encoding="UTF-8"?>
<Function Name="CEIL2" Comment="This is a rounding function which returns the smallest possible integer which is greater or equal&#10;to X.">
	<Identification Standard="61499-1">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Portiert aus OSCAT_basic CEIL2.TcPOU - Bereichspruefung (X &gt;= 2147483647.0 / X &lt;= -2147483648.0) schuetzt vor DINT-Ueberlauf.">
	</VersionInfo>
	<CompilerInfo packageName="OSCAT::Basic::POUs::Mathematical">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="X"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var=""/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="X" Type="REAL"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="" Type="DINT"/>
		</OutputVars>
	</InterfaceList>
	<FunctionBody>
		<ST><![CDATA[PACKAGE OSCAT::Basic::POUs::Mathematical;

(* This is a rounding function which returns the smallest possible integer which is greater or equal to X (clamped to DINT range -2147483648..2147483647). *)
FUNCTION CEIL2 : DINT
VAR_INPUT
	X : REAL;
END_VAR

(*
 * version 1.3	10. mar. 2009 programmer 	hugo tested by		tobias
 * *
 * This is a rounding function which returns the smallest possible integer which is greater or equal to X.
 * ceil2(3.14) = 4 ceil2(-3.14) = -3
 * Portiert 2026-09-17: Bereichspruefung schuetzt vor DINT-Ueberlauf.
 *)
IF X >= 2147483647.0 THEN
	CEIL2 := 2147483647;
ELSIF X <= -2147483648.0 THEN
	CEIL2 := -2147483648;
ELSE
	CEIL2 := REAL_TO_DINT(X);
	IF DINT_TO_REAL(CEIL2) < X THEN
		CEIL2 := CEIL2 + 1;
	END_IF;
END_IF;

END_FUNCTION

(* revision history hm	21. mar. 2008	rev 1.0 original version
 * *
 * hm	4. apr. 2008	rev 1.1 added type conversion to avoid warnings under codesys 3.0
 * *
 * hm	30. jun. 2008	rev 1.2 added type conversion to avoid warnings under codesys 3.0
 * *
 * hm	10. mar. 2009	rev 1.3 use correct statement real_to_DINT *) ]]></ST>
	</FunctionBody>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</Function>
