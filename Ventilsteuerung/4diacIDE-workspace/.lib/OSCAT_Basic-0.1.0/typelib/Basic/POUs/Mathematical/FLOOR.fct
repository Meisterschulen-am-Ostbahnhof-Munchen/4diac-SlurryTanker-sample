<?xml version="1.0" encoding="UTF-8"?>
<Function Name="FLOOR" Comment="This is a rounding function which returns the biggest possible integer which is less or equal&#10;to X.">
	<Identification Standard="61499-1">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Portiert aus OSCAT_basic FLOOR.TcPOU - Bereichspruefung (X &gt;= 32767.0 / X &lt;= -32768.0) schuetzt vor INT-Ueberlauf.">
	</VersionInfo>
	<CompilerInfo packageName="OSCAT::Basic::POUs::Mathematical">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="X"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var=""/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="X" Type="REAL"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="" Type="INT"/>
		</OutputVars>
	</InterfaceList>
	<FunctionBody>
		<ST><![CDATA[PACKAGE OSCAT::Basic::POUs::Mathematical;

(* This is a rounding function which returns the biggest possible integer which is less or equal to X (clamped to INT range -32768..32767). *)
FUNCTION FLOOR : INT
VAR_INPUT
	X : REAL;
END_VAR

(*
 * version 1.1	21. mar. 2008 programmer 	hugo tested by		tobias
 * *
 * This is a rounding function which returns the biggest possible integer which is less or equal to X.
 * floor(3.14) = 3 floor(-3.14) = -4
 * Portiert 2026-09-17: Bereichspruefung schuetzt vor INT-Ueberlauf.
 *)
IF X >= 32767.0 THEN
	FLOOR := 32767;
ELSIF X <= -32768.0 THEN
	FLOOR := -32768;
ELSE
	FLOOR := REAL_TO_INT(X);
	IF FLOOR > X THEN
		FLOOR := FLOOR - 1;
	END_IF;
END_IF;

END_FUNCTION

(*
 * version 1.1	21. mar. 2008 programmer 	hugo tested by		tobias
 * *
 * This is a rounding function which returns the biggest possible integer which is less or equal to
 * X.
 * floor(3.14) = 3 floor(-3.14) = -4
 *)
]]></ST>
	</FunctionBody>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</Function>
