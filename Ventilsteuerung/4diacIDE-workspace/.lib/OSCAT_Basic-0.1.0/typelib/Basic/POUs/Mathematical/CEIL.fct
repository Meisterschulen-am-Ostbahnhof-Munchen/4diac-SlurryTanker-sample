<?xml version="1.0" encoding="UTF-8"?>
<Function Name="CEIL" Comment="This is a rounding function which returns the smallest possible integer which is greater or equal&#10;to X.">
	<Identification Standard="61499-1">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz Höpfinger" Date="2026-09-17" Remarks="Portiert aus OSCAT_basic CEIL.TcPOU - Bereichspruefung (X &gt;= 32767.0 / X &lt;= -32768.0) schuetzt vor INT-Ueberlauf.">
	</VersionInfo>
	<CompilerInfo packageName="OSCAT::Basic::POUs::Mathematical">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="X"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var=""/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="X" Type="REAL"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="" Type="INT"/>
		</OutputVars>
	</InterfaceList>
	<FunctionBody>
		<ST><![CDATA[PACKAGE OSCAT::Basic::POUs::Mathematical;

(* This is a rounding function which returns the smallest possible integer which is greater or equal to X (clamped to INT range -32768..32767). *)
FUNCTION CEIL : INT
VAR_INPUT
	X : REAL;
END_VAR

(*
 * version 1.1	21. mar. 2008 programmer 	hugo tested by		tobias
 * *
 * This is a rounding function which returns the smallest possible integer which is greater or equal to X.
 * ceil(3.14) = 4 ceil(-3.14) = -3
 * Portiert 2026-09-17: Bereichspruefung schuetzt vor INT-Ueberlauf.
 *)
IF X >= 32767.0 THEN
	CEIL := 32767;
ELSIF X <= -32768.0 THEN
	CEIL := -32768;
ELSE
	CEIL := REAL_TO_INT(X);
	IF CEIL < X THEN
		CEIL := CEIL + 1;
	END_IF;
END_IF;

END_FUNCTION

(* revision history hm	7. feb. 2007	rev 1.0 original version
 * *
 * hm	21. mar. 2008	rev 1.1 use REAL_TO_INT instead of trunc for compatibility reasons *) ]]></ST>
	</FunctionBody>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</Function>
